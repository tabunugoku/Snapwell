<Window
    x:Class="Snapwell.Settings.Setup.SetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Snapwell.Settings.Localization">
    <Grid x:Name="Root" Background="{ThemeResource SnapwellBackgroundBrush}" Loaded="Root_Loaded">
        <Grid.Resources>
            <Style x:Key="SetupHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource SnapwellPageTitleStyle}">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="LineHeight" Value="32.2" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>
            <Style x:Key="SetupLeadStyle" TargetType="TextBlock" BasedOn="{StaticResource SnapwellLeadTextStyle}">
                <Setter Property="Margin" Value="0,0,0,18" />
            </Style>
            <Style x:Key="SetupConsentTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SnapwellHintTextStyle}">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{ThemeResource SnapwellTextBrush}" />
            </Style>
            <Style x:Key="SetupStepStyle" TargetType="Border">
                <Setter Property="BorderThickness" Value="0,2,0,0" />
                <Setter Property="BorderBrush" Value="{ThemeResource SnapwellBorderBrush}" />
                <Setter Property="Padding" Value="0,8,0,0" />
            </Style>
            <Style x:Key="SetupDoneStepStyle" TargetType="Border" BasedOn="{StaticResource SetupStepStyle}">
                <Setter Property="BorderBrush" Value="{ThemeResource SnapwellMutedBrush}" />
            </Style>
            <Style x:Key="SetupCurrentStepStyle" TargetType="Border" BasedOn="{StaticResource SetupStepStyle}">
                <Setter Property="BorderBrush" Value="{ThemeResource SnapwellInkBrush}" />
            </Style>
            <Style x:Key="SetupStepTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SnapwellHintTextStyle}">
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="SetupCurrentStepTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SetupStepTextStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SnapwellInkBrush}" />
            </Style>
            <Style x:Key="SetupPlanStyle" TargetType="Button" BasedOn="{StaticResource SnapwellButtonStyle}">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
            </Style>
            <Style x:Key="SetupSelectedPlanStyle" TargetType="Button" BasedOn="{StaticResource SetupPlanStyle}">
                <Setter Property="BorderBrush" Value="{ThemeResource SnapwellInkBrush}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Padding" Value="11" />
            </Style>
            <Style x:Key="SetupMiniStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Background" Value="{ThemeResource SnapwellWallBrush}" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
            <Style x:Key="SetupCellStyle" TargetType="Border">
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{ThemeResource SnapwellCellBorderBrush}" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBar">
            <TextBlock Text="Snapwell" Margin="16,0" VerticalAlignment="Center"
                       Style="{StaticResource SnapwellHintTextStyle}" />
        </Grid>
        <Grid Grid.Row="1" MaxWidth="760" Margin="24,20,24,24" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid x:Name="Steps" ColumnSpacing="8" Margin="0,0,0,16" />
            <Border Grid.Row="1" Background="{ThemeResource SnapwellSurfaceBrush}"
                    BorderBrush="{ThemeResource SnapwellBorderBrush}" BorderThickness="1" CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer x:Name="BodyScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="32,28">
                            <TextBlock x:Name="Heading" Style="{StaticResource SetupHeadingStyle}" />
                            <TextBlock x:Name="Lead" Style="{StaticResource SetupLeadStyle}" />
                            <StackPanel x:Name="PageHost" />
                        </StackPanel>
                    </ScrollViewer>
                    <InfoBar x:Name="ErrorNotice" Grid.Row="1" Severity="Error" IsOpen="False" Margin="20,0,20,14" />
                    <Border Grid.Row="2" BorderBrush="{ThemeResource SnapwellBorderBrush}"
                            BorderThickness="0,1,0,0" Background="{ThemeResource SnapwellSurface2Brush}"
                            CornerRadius="0,0,12,12" Padding="20,14">
                        <Grid>
                            <Button x:Name="BackButton" l:Loc.Uid="Setup_Back" Click="Back_Click"
                                    HorizontalAlignment="Left" Style="{StaticResource SnapwellActionButtonStyle}" />
                            <TextBlock x:Name="Count" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Style="{StaticResource SnapwellHintTextStyle}" />
                            <Button x:Name="NextButton" Click="Next_Click"
                                    HorizontalAlignment="Right" Style="{StaticResource SnapwellPrimaryButtonStyle}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
