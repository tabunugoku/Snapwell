<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Snapwell.Settings.Pages.FeelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <Style x:Key="DemoSwitchStyle" TargetType="ToggleSwitch">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleSwitch">
                        <Grid x:Name="SwitchVisualRoot" Width="40" Height="20" Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver" />
                                    <VisualState x:Name="Pressed" />
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="SwitchVisualRoot.Opacity" Value="0.55" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="ToggleStates">
                                    <VisualState x:Name="Off" />
                                    <VisualState x:Name="On">
                                        <VisualState.Setters>
                                            <Setter
                                                Target="SwitchTrack.Background"
                                                Value="{ThemeResource SnapwellInkBrush}" />
                                            <Setter
                                                Target="SwitchTrack.BorderBrush"
                                                Value="{ThemeResource SnapwellInkBrush}" />
                                            <Setter Target="SwitchTrack.BorderThickness" Value="0" />
                                            <Setter
                                                Target="SwitchKnob.Fill"
                                                Value="{ThemeResource SnapwellInkTextBrush}" />
                                            <Setter Target="SwitchKnob.Margin" Value="23,0,0,0" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border
                                x:Name="SwitchTrack"
                                CornerRadius="9999"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource SnapwellMutedBrush}" />
                            <Ellipse
                                x:Name="SwitchKnob"
                                Width="12"
                                Height="12"
                                Margin="3,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource SnapwellMutedBrush}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FeelCardButtonStyle" TargetType="Button" BasedOn="{StaticResource SnapwellButtonStyle}">
            <Setter Property="Padding" Value="12" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="SelectedFeelCardButtonStyle" TargetType="Button" BasedOn="{StaticResource FeelCardButtonStyle}">
            <Setter Property="Padding" Value="11" />
            <Setter Property="BorderBrush" Value="{ThemeResource SnapwellInkBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
    </Page.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Editor" Padding="32,28,32,40" HorizontalAlignment="Stretch">
            <TextBlock Text="操作感" Style="{StaticResource SnapwellPageTitleStyle}" />
            <TextBlock Text="投げたときの動き方です。言葉で選ぶと、質量・振動数・減衰比が決まります。曲線は手を離してから止まるまでの位置です。"
                       Style="{StaticResource SnapwellLeadTextStyle}" />

            <ComboBox x:Name="FeelBox" Header="物理モデルのプリセット" HorizontalAlignment="Stretch"
                      Visibility="Collapsed" SelectionChanged="Feel_SelectionChanged">
                <ComboBoxItem Content="Airy — 軽やかに、少し引き寄せる" Tag="Airy" />
                <ComboBoxItem Content="Snappy — きびきび、正確に" Tag="Snappy" />
                <ComboBoxItem Content="Heavy — 重く、落ち着いて" Tag="Heavy" />
                <ComboBoxItem Content="Bouncy — 軽く、弾むように" Tag="Bouncy" />
            </ComboBox>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="CardAiry" Tag="Airy" Click="FeelCard_Click"
                        Style="{StaticResource FeelCardButtonStyle}"
                        AutomationProperties.Name="airy — airy, slightly magnetic">
                    <StackPanel>
                        <TextBlock Text="airy" FontWeight="SemiBold" FontSize="13" LineHeight="20.8"
                                   Foreground="{ThemeResource SnapwellInkBrush}" />
                        <TextBlock Text="airy, slightly magnetic"
                                   FontFamily="{StaticResource SnapwellMonoFontFamily}" FontSize="11" LineHeight="17.6"
                                   Foreground="{ThemeResource SnapwellMutedBrush}" TextWrapping="Wrap" />
                        <Viewbox Height="54" Stretch="Fill" Margin="0,8,0,0">
                            <Canvas Width="160" Height="54">
                                <Line X1="0" Y1="12" X2="160" Y2="12"
                                      Stroke="{ThemeResource SnapwellBorderStrongBrush}"
                                      StrokeThickness="1" StrokeDashArray="3,3" />
                                <Polyline x:Name="AiryCurve" Stroke="{ThemeResource SnapwellInkBrush}"
                                          StrokeThickness="1.5" />
                            </Canvas>
                        </Viewbox>
                    </StackPanel>
                </Button>
                <Button x:Name="CardSnappy" Grid.Column="1" Tag="Snappy" Click="FeelCard_Click"
                        Style="{StaticResource FeelCardButtonStyle}"
                        AutomationProperties.Name="snappy — snappy, precise">
                    <StackPanel>
                        <TextBlock Text="snappy" FontWeight="SemiBold" FontSize="13" LineHeight="20.8"
                                   Foreground="{ThemeResource SnapwellInkBrush}" />
                        <TextBlock Text="snappy, precise"
                                   FontFamily="{StaticResource SnapwellMonoFontFamily}" FontSize="11" LineHeight="17.6"
                                   Foreground="{ThemeResource SnapwellMutedBrush}" TextWrapping="Wrap" />
                        <Viewbox Height="54" Stretch="Fill" Margin="0,8,0,0">
                            <Canvas Width="160" Height="54">
                                <Line X1="0" Y1="12" X2="160" Y2="12"
                                      Stroke="{ThemeResource SnapwellBorderStrongBrush}"
                                      StrokeThickness="1" StrokeDashArray="3,3" />
                                <Polyline x:Name="SnappyCurve" Stroke="{ThemeResource SnapwellInkBrush}"
                                          StrokeThickness="1.5" />
                            </Canvas>
                        </Viewbox>
                    </StackPanel>
                </Button>
                <Button x:Name="CardHeavy" Grid.Column="2" Tag="Heavy" Click="FeelCard_Click"
                        Style="{StaticResource FeelCardButtonStyle}"
                        AutomationProperties.Name="heavy — heavy, settled">
                    <StackPanel>
                        <TextBlock Text="heavy" FontWeight="SemiBold" FontSize="13" LineHeight="20.8"
                                   Foreground="{ThemeResource SnapwellInkBrush}" />
                        <TextBlock Text="heavy, settled"
                                   FontFamily="{StaticResource SnapwellMonoFontFamily}" FontSize="11" LineHeight="17.6"
                                   Foreground="{ThemeResource SnapwellMutedBrush}" TextWrapping="Wrap" />
                        <Viewbox Height="54" Stretch="Fill" Margin="0,8,0,0">
                            <Canvas Width="160" Height="54">
                                <Line X1="0" Y1="12" X2="160" Y2="12"
                                      Stroke="{ThemeResource SnapwellBorderStrongBrush}"
                                      StrokeThickness="1" StrokeDashArray="3,3" />
                                <Polyline x:Name="HeavyCurve" Stroke="{ThemeResource SnapwellInkBrush}"
                                          StrokeThickness="1.5" />
                            </Canvas>
                        </Viewbox>
                    </StackPanel>
                </Button>
                <Button x:Name="CardBouncy" Grid.Column="3" Tag="Bouncy" Click="FeelCard_Click"
                        Style="{StaticResource FeelCardButtonStyle}"
                        AutomationProperties.Name="bouncy — light, playful">
                    <StackPanel>
                        <TextBlock Text="bouncy" FontWeight="SemiBold" FontSize="13" LineHeight="20.8"
                                   Foreground="{ThemeResource SnapwellInkBrush}" />
                        <TextBlock Text="light, playful"
                                   FontFamily="{StaticResource SnapwellMonoFontFamily}" FontSize="11" LineHeight="17.6"
                                   Foreground="{ThemeResource SnapwellMutedBrush}" TextWrapping="Wrap" />
                        <Viewbox Height="54" Stretch="Fill" Margin="0,8,0,0">
                            <Canvas Width="160" Height="54">
                                <Line X1="0" Y1="12" X2="160" Y2="12"
                                      Stroke="{ThemeResource SnapwellBorderStrongBrush}"
                                      StrokeThickness="1" StrokeDashArray="3,3" />
                                <Polyline x:Name="BouncyCurve" Stroke="{ThemeResource SnapwellInkBrush}"
                                          StrokeThickness="1.5" />
                            </Canvas>
                        </Viewbox>
                    </StackPanel>
                </Button>
            </Grid>

            <TextBlock Text="詳細" Style="{StaticResource SnapwellGroupTitleStyle}" />
            <Border Style="{StaticResource SnapwellRowsBorderStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="吸着の方式" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock Text="投げたウィンドウを吸い寄せる対象"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <ComboBox x:Name="ModeBox" Grid.Column="1" Width="240" VerticalAlignment="Center"
                                  AutomationProperties.Name="吸着の方式" SelectionChanged="Mode_SelectionChanged">
                            <ComboBoxItem Content="区画 — 半分・四分割・最大化" />
                            <ComboBoxItem Content="四隅 — サイズを変えずに移動" />
                        </ComboBox>
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="質量 m" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock Text="重いほど手から遅れ、遠くまで滑ります"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <TextBlock x:Name="MassValueText" Grid.Column="1" VerticalAlignment="Center"
                                   Style="{StaticResource SnapwellMonoTextStyle}" />
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="固有振動数 f" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock Text="大きいほど素早く吸着します"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <TextBlock x:Name="FrequencyValueText" Grid.Column="1" VerticalAlignment="Center"
                                   Style="{StaticResource SnapwellMonoTextStyle}" />
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="減衰比 ζ" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock Text="1 に近いほど行き過ぎません"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <TextBlock x:Name="DampingRatioValueText" Grid.Column="1" VerticalAlignment="Center"
                                   Style="{StaticResource SnapwellMonoTextStyle}" />
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />

                    <!-- デモ状態 (未実装) -->
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <Grid ColumnSpacing="6" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="磁石の強さ" Style="{StaticResource SnapwellRowTitleStyle}" />
                                <Border Grid.Column="1" Style="{StaticResource SnapwellPendingTagStyle}">
                                    <TextBlock Text="準備中" Style="{StaticResource SnapwellPendingTagTextStyle}" />
                                </Border>
                            </Grid>
                            <TextBlock Text="区画の近くで吸い寄せる力" Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <TextBlock
                            Text="0.6"
                            Style="{StaticResource SnapwellMonoTextStyle}"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="14" />
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <Grid ColumnSpacing="6" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="吸着半径" Style="{StaticResource SnapwellRowTitleStyle}" />
                                <Border Grid.Column="1" Style="{StaticResource SnapwellPendingTagStyle}">
                                    <TextBlock Text="準備中" Style="{StaticResource SnapwellPendingTagTextStyle}" />
                                </Border>
                            </Grid>
                            <TextBlock Text="この距離に入ると吸着します" Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <TextBlock
                            Text="28 px"
                            Style="{StaticResource SnapwellMonoTextStyle}"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="14" />
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <!-- デモ状態 (未実装) ここまで -->
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="導かれる値" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock Text="k = m(2πf)², c = 2ζ√(km)"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <TextBlock x:Name="DerivedValueText" Grid.Column="1" VerticalAlignment="Center"
                                   Style="{StaticResource SnapwellMonoTextStyle}" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="アクセシビリティ" Style="{StaticResource SnapwellGroupTitleStyle}" />
            <Border Style="{StaticResource SnapwellRowsBorderStyle}">
                <Grid Style="{StaticResource SnapwellRowGridStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="動きを減らす" Style="{StaticResource SnapwellRowTitleStyle}" />
                        <TextBlock Text="オンにすると、アニメーションせずに吸着先へすぐ移動します。Windows の「アニメーション効果」がオフのときも同じです"
                                   Style="{StaticResource SnapwellRowDescriptionStyle}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="MotionSwitch" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"
                                  VerticalAlignment="Center" AutomationProperties.Name="動きを減らす"
                                  Toggled="Motion_Toggled" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
