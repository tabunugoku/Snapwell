<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Snapwell.Settings.Pages.FeelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Editor" Padding="28,16,28,32" Spacing="24" MaxWidth="820">
            <TextBlock Text="操作感" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="投げたときの動き方です。言葉で選ぶと、質量・振動数・減衰比が決まります。"
                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ComboBox x:Name="FeelBox" Header="物理モデルのプリセット" HorizontalAlignment="Stretch"
                      SelectionChanged="Feel_SelectionChanged">
                <ComboBoxItem Content="Airy — 軽やかに、少し引き寄せる" Tag="Airy" />
                <ComboBoxItem Content="Snappy — きびきび、正確に" Tag="Snappy" />
                <ComboBoxItem Content="Heavy — 重く、落ち着いて" Tag="Heavy" />
                <ComboBoxItem Content="Bouncy — 軽く、弾むように" Tag="Bouncy" />
            </ComboBox>
            <ComboBox x:Name="ModeBox" Header="吸着の方式" HorizontalAlignment="Stretch"
                      SelectionChanged="Mode_SelectionChanged">
                <ComboBoxItem Content="区画 — 半分・四分割・最大化" />
                <ComboBoxItem Content="四隅 — サイズを変えずに移動" />
            </ComboBox>
            <StackPanel Spacing="8">
                <ToggleSwitch x:Name="MotionSwitch" Header="動きを減らす" OnContent="オン" OffContent="オフ"
                              Toggled="Motion_Toggled" />
                <TextBlock Text="オンにすると、アニメーションせずに吸着先へすぐ移動します。Windows の「アニメーション効果」がオフのときも同じです。"
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
