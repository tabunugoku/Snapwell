<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Snapwell.Settings.Pages.FeelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Snapwell.Settings.Controls">
    <Page.Resources>
        <Style x:Key="DemoSwitchStyle" TargetType="ToggleSwitch"
               BasedOn="{StaticResource SnapwellDemoSwitchStyle}" />
        <Style x:Key="FeelCardButtonStyle" TargetType="Button" BasedOn="{StaticResource SnapwellButtonStyle}">
            <Setter Property="Padding" Value="12" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="ChipButtonStyle" TargetType="Button" BasedOn="{StaticResource SnapwellButtonStyle}">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="SelectedChipButtonStyle" TargetType="Button" BasedOn="{StaticResource SnapwellButtonStyle}">
            <Setter Property="Padding" Value="11,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource SnapwellInkBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SnapwellInkBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style x:Key="SelectedFeelCardButtonStyle" TargetType="Button" BasedOn="{StaticResource FeelCardButtonStyle}">
            <Setter Property="Padding" Value="11" />
            <Setter Property="BorderBrush" Value="{ThemeResource SnapwellInkBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
    </Page.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Editor" Padding="32,28,32,40" HorizontalAlignment="Stretch">
            <TextBlock Text="操作感" Style="{StaticResource SnapwellPageTitleStyle}" />
            <TextBlock Text="投げたときの動き方です。4 つのプリセットのどれかを選ぶと、5 つの値がそのプリセットの値になります。値を変えると「カスタム」になります。曲線は、手を離してから止まるまでの位置の変化です。"
                       Style="{StaticResource SnapwellLeadTextStyle}" />

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="CardAiry" Tag="Airy" Click="FeelCard_Click"
                        Style="{StaticResource FeelCardButtonStyle}"
                        AutomationProperties.Name="airy — airy, slightly magnetic">
                    <StackPanel>
                        <TextBlock Text="airy" FontWeight="SemiBold" FontSize="13" LineHeight="20.8"
                                   Foreground="{ThemeResource SnapwellInkBrush}" />
                        <TextBlock Text="airy, slightly magnetic"
                                   FontFamily="{StaticResource SnapwellMonoFontFamily}" FontSize="11" LineHeight="17.6"
                                   Foreground="{ThemeResource SnapwellMutedBrush}" TextWrapping="Wrap" />
                        <Viewbox Height="54" Stretch="Fill" Margin="0,8,0,0">
                            <Canvas Width="160" Height="54">
                                <Line X1="0" Y1="12" X2="160" Y2="12"
                                      Stroke="{ThemeResource SnapwellBorderStrongBrush}"
                                      StrokeThickness="1" StrokeDashArray="3,3" />
                                <Polyline x:Name="AiryCurve" Stroke="{ThemeResource SnapwellInkBrush}"
                                          StrokeThickness="1.5" />
                            </Canvas>
                        </Viewbox>
                    </StackPanel>
                </Button>
                <Button x:Name="CardSnappy" Grid.Column="1" Tag="Snappy" Click="FeelCard_Click"
                        Style="{StaticResource FeelCardButtonStyle}"
                        AutomationProperties.Name="snappy — snappy, precise">
                    <StackPanel>
                        <TextBlock Text="snappy" FontWeight="SemiBold" FontSize="13" LineHeight="20.8"
                                   Foreground="{ThemeResource SnapwellInkBrush}" />
                        <TextBlock Text="snappy, precise"
                                   FontFamily="{StaticResource SnapwellMonoFontFamily}" FontSize="11" LineHeight="17.6"
                                   Foreground="{ThemeResource SnapwellMutedBrush}" TextWrapping="Wrap" />
                        <Viewbox Height="54" Stretch="Fill" Margin="0,8,0,0">
                            <Canvas Width="160" Height="54">
                                <Line X1="0" Y1="12" X2="160" Y2="12"
                                      Stroke="{ThemeResource SnapwellBorderStrongBrush}"
                                      StrokeThickness="1" StrokeDashArray="3,3" />
                                <Polyline x:Name="SnappyCurve" Stroke="{ThemeResource SnapwellInkBrush}"
                                          StrokeThickness="1.5" />
                            </Canvas>
                        </Viewbox>
                    </StackPanel>
                </Button>
                <Button x:Name="CardHeavy" Grid.Column="2" Tag="Heavy" Click="FeelCard_Click"
                        Style="{StaticResource FeelCardButtonStyle}"
                        AutomationProperties.Name="heavy — heavy, settled">
                    <StackPanel>
                        <TextBlock Text="heavy" FontWeight="SemiBold" FontSize="13" LineHeight="20.8"
                                   Foreground="{ThemeResource SnapwellInkBrush}" />
                        <TextBlock Text="heavy, settled"
                                   FontFamily="{StaticResource SnapwellMonoFontFamily}" FontSize="11" LineHeight="17.6"
                                   Foreground="{ThemeResource SnapwellMutedBrush}" TextWrapping="Wrap" />
                        <Viewbox Height="54" Stretch="Fill" Margin="0,8,0,0">
                            <Canvas Width="160" Height="54">
                                <Line X1="0" Y1="12" X2="160" Y2="12"
                                      Stroke="{ThemeResource SnapwellBorderStrongBrush}"
                                      StrokeThickness="1" StrokeDashArray="3,3" />
                                <Polyline x:Name="HeavyCurve" Stroke="{ThemeResource SnapwellInkBrush}"
                                          StrokeThickness="1.5" />
                            </Canvas>
                        </Viewbox>
                    </StackPanel>
                </Button>
                <Button x:Name="CardBouncy" Grid.Column="3" Tag="Bouncy" Click="FeelCard_Click"
                        Style="{StaticResource FeelCardButtonStyle}"
                        AutomationProperties.Name="bouncy — light, playful">
                    <StackPanel>
                        <TextBlock Text="bouncy" FontWeight="SemiBold" FontSize="13" LineHeight="20.8"
                                   Foreground="{ThemeResource SnapwellInkBrush}" />
                        <TextBlock Text="light, playful"
                                   FontFamily="{StaticResource SnapwellMonoFontFamily}" FontSize="11" LineHeight="17.6"
                                   Foreground="{ThemeResource SnapwellMutedBrush}" TextWrapping="Wrap" />
                        <Viewbox Height="54" Stretch="Fill" Margin="0,8,0,0">
                            <Canvas Width="160" Height="54">
                                <Line X1="0" Y1="12" X2="160" Y2="12"
                                      Stroke="{ThemeResource SnapwellBorderStrongBrush}"
                                      StrokeThickness="1" StrokeDashArray="3,3" />
                                <Polyline x:Name="BouncyCurve" Stroke="{ThemeResource SnapwellInkBrush}"
                                          StrokeThickness="1.5" />
                            </Canvas>
                        </Viewbox>
                    </StackPanel>
                </Button>
            </Grid>

            <TextBlock Text="試す" Style="{StaticResource SnapwellGroupTitleStyle}" />
            <Border Style="{StaticResource SnapwellRowsBorderStyle}" Padding="12">
                <StackPanel Spacing="10">
                    <Canvas x:Name="TrialStage" Height="260" HorizontalAlignment="Stretch"
                            Background="{ThemeResource SnapwellWallBrush}" SizeChanged="TrialStage_SizeChanged"
                            PointerPressed="TrialStage_PointerPressed" PointerMoved="TrialStage_PointerMoved"
                            PointerReleased="TrialStage_PointerReleased"
                            PointerCanceled="TrialStage_PointerCanceled"
                            PointerCaptureLost="TrialStage_PointerCanceled">
                        <Border x:Name="TrialCard" IsTabStop="True" CornerRadius="8"
                                BorderThickness="1" Background="{ThemeResource SnapwellSurfaceBrush}"
                                BorderBrush="{ThemeResource SnapwellBorderStrongBrush}"
                                AutomationProperties.Name="試すウィンドウ。タイトルバーをドラッグして投げる。矢印キーで投げる"
                                RenderTransformOrigin="0.5,0.5" KeyDown="TrialCard_KeyDown">
                            <Border.RenderTransform>
                                <CompositeTransform x:Name="TrialCardTransform" />
                            </Border.RenderTransform>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8" Padding="10,0,0,0"
                                            VerticalAlignment="Center">
                                    <Border Width="12" Height="12" CornerRadius="3"
                                            Background="{ThemeResource SnapwellMutedBrush}" />
                                    <TextBlock Text="Window" FontSize="12"
                                               Foreground="{ThemeResource SnapwellTextBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Spacing="7" Padding="12,10,12,0">
                                    <Border Height="7" CornerRadius="4" HorizontalAlignment="Left" Width="80"
                                            Background="{ThemeResource SnapwellSkeletonBrush}" />
                                    <Border Height="7" CornerRadius="4" HorizontalAlignment="Left" Width="56"
                                            Background="{ThemeResource SnapwellSkeletonBrush}" />
                                    <Border Height="7" CornerRadius="4" HorizontalAlignment="Left" Width="68"
                                            Background="{ThemeResource SnapwellSkeletonBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Canvas>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="TrialZonesButton" Content="区画" Click="TrialMode_Click" Tag="Zones"
                                Style="{StaticResource SelectedChipButtonStyle}" />
                        <Button x:Name="TrialCornersButton" Content="四隅" Click="TrialMode_Click" Tag="Corners"
                                Style="{StaticResource ChipButtonStyle}" />
                        <Button x:Name="TrialThrowButton" Content="ランダムに投げる" Click="TrialThrow_Click"
                                Style="{StaticResource ChipButtonStyle}" />
                    </StackPanel>
                    <TextBlock Text="ウィンドウのタイトルバーをつかんで投げます（ウィンドウの中をつかんでも動きません）。いまの 5 つの値で動き、止まる先は Snapwell 本体と同じ規則で決まります（離した速さが 150 px/s 未満だと吸着しません。区画では、中央から上へ強く投げると最大化になります）"
                               Style="{StaticResource SnapwellRowDescriptionStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="詳細" Style="{StaticResource SnapwellGroupTitleStyle}" VerticalAlignment="Center" />
                <TextBlock x:Name="FeelStateText" Style="{StaticResource SnapwellMonoTextStyle}"
                           VerticalAlignment="Center" />
                <Button x:Name="FeelResetButton" Content="プリセットに戻す" Click="FeelReset_Click"
                        Style="{StaticResource SnapwellActionButtonStyle}" Visibility="Collapsed" />
            </StackPanel>
            <Border Style="{StaticResource SnapwellRowsBorderStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="吸着の方式" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock Text="投げたウィンドウを吸い寄せる対象"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <ComboBox x:Name="ModeBox" Grid.Column="1" Width="240" VerticalAlignment="Center"
                                  AutomationProperties.Name="吸着の方式" SelectionChanged="Mode_SelectionChanged">
                            <ComboBoxItem Content="区画 — 半分・四分割・最大化" />
                            <ComboBoxItem Content="四隅 — サイズを変えずに移動" />
                        </ComboBox>
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="質量 m" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock Text="feel の磁石場では力が質量に比例するため、吸着の動きは変わりません。導かれる値の k と c が変わります"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel x:Name="MassPanel" Grid.Column="1" Orientation="Horizontal" Spacing="12"
                                    VerticalAlignment="Center">
                            <Slider x:Name="MassSlider" Width="200" Minimum="0" Maximum="1000"
                                    AutomationProperties.Name="質量 m（スライダー）" />
                            <NumberBox x:Name="MassBox" Width="130" Minimum="0.15" Maximum="8"
                                       SmallChange="0.05" LargeChange="0.5"
                                       SpinButtonPlacementMode="Compact" AutomationProperties.Name="質量 m"
                                       ValidationMode="InvalidInputOverwritten" />
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="固有振動数 f" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock Text="大きいほど素早く吸着します"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel x:Name="FrequencyPanel" Grid.Column="1" Orientation="Horizontal" Spacing="12"
                                    VerticalAlignment="Center">
                            <Slider x:Name="FrequencySlider" Width="200" Minimum="0" Maximum="1000"
                                    AutomationProperties.Name="固有振動数 f (Hz)（スライダー）" />
                            <NumberBox x:Name="FrequencyBox" Width="130" Minimum="0.4" Maximum="7"
                                       SmallChange="0.05" LargeChange="0.5"
                                       SpinButtonPlacementMode="Compact" AutomationProperties.Name="固有振動数 f (Hz)"
                                       ValidationMode="InvalidInputOverwritten" />
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="減衰比 ζ" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock Text="1 に近いほど行き過ぎません"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel x:Name="DampingRatioPanel" Grid.Column="1" Orientation="Horizontal" Spacing="12"
                                    VerticalAlignment="Center">
                            <Slider x:Name="DampingRatioSlider" Width="200" Minimum="0" Maximum="1000"
                                    AutomationProperties.Name="減衰比 ζ（スライダー）" />
                            <NumberBox x:Name="DampingRatioBox" Width="130" Minimum="0.1" Maximum="1.6"
                                       SmallChange="0.01" LargeChange="0.1"
                                       SpinButtonPlacementMode="Compact" AutomationProperties.Name="減衰比 ζ"
                                       ValidationMode="InvalidInputOverwritten" />
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />

                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="磁石の強さ" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock Text="停止点へ吸い寄せる力。大きいほど強く引きます (0〜2)" Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel x:Name="MagnetStrengthPanel" Grid.Column="1" Orientation="Horizontal" Spacing="12"
                                    VerticalAlignment="Center">
                            <Slider x:Name="MagnetStrengthSlider" Width="200" Minimum="0" Maximum="1000"
                                    AutomationProperties.Name="磁石の強さ（スライダー）" />
                            <NumberBox x:Name="MagnetStrengthBox" Width="130" Minimum="0" Maximum="2"
                                       SmallChange="0.05" LargeChange="0.1"
                                       SpinButtonPlacementMode="Compact" AutomationProperties.Name="磁石の強さ"
                                       ValidationMode="InvalidInputOverwritten" />
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="吸着半径" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock Text="強く吸い込まれる距離 (px)" Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel x:Name="SnapRadiusPanel" Grid.Column="1" Orientation="Horizontal" Spacing="12"
                                    VerticalAlignment="Center">
                            <Slider x:Name="SnapRadiusSlider" Width="200" Minimum="0" Maximum="1000"
                                    AutomationProperties.Name="吸着半径 (px)（スライダー）" />
                            <NumberBox x:Name="SnapRadiusBox" Width="130" Minimum="8" Maximum="96"
                                       SmallChange="1" LargeChange="8"
                                       SpinButtonPlacementMode="Compact" AutomationProperties.Name="吸着半径 (px)"
                                       ValidationMode="InvalidInputOverwritten" />
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="導かれる値" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock Text="k = m(2πf)², c = 2ζ√(km)"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <TextBlock x:Name="DerivedValueText" Grid.Column="1" VerticalAlignment="Center"
                                   Style="{StaticResource SnapwellMonoTextStyle}" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="アクセシビリティ" Style="{StaticResource SnapwellGroupTitleStyle}" />
            <Border Style="{StaticResource SnapwellRowsBorderStyle}">
                <Grid Style="{StaticResource SnapwellRowGridStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="動きを減らす" Style="{StaticResource SnapwellRowTitleStyle}" />
                        <TextBlock Text="オンにすると、アニメーションせずに吸着先へすぐ移動します。Windows の「アニメーション効果」がオフのときも同じです"
                                   Style="{StaticResource SnapwellRowDescriptionStyle}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="MotionSwitch" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"
                                  Style="{StaticResource SnapwellToggleSwitchStyle}"
                                  VerticalAlignment="Center" AutomationProperties.Name="動きを減らす"
                                  Toggled="Motion_Toggled" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
