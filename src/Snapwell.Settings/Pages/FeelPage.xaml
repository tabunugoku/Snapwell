<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Snapwell.Settings.Pages.FeelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:l="using:Snapwell.Settings.Localization"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Snapwell.Settings.Controls">
    <Page.Resources>
        <Style x:Key="DemoSwitchStyle" TargetType="ToggleSwitch"
               BasedOn="{StaticResource SnapwellDemoSwitchStyle}" />
        <Style x:Key="FeelCardButtonStyle" TargetType="Button" BasedOn="{StaticResource SnapwellButtonStyle}">
            <Setter Property="Padding" Value="12" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="ChipButtonStyle" TargetType="Button" BasedOn="{StaticResource SnapwellButtonStyle}">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="SelectedChipButtonStyle" TargetType="Button" BasedOn="{StaticResource SnapwellButtonStyle}">
            <Setter Property="Padding" Value="11,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource SnapwellInkBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SnapwellInkBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style x:Key="SelectedFeelCardButtonStyle" TargetType="Button" BasedOn="{StaticResource FeelCardButtonStyle}">
            <Setter Property="Padding" Value="11" />
            <Setter Property="BorderBrush" Value="{ThemeResource SnapwellInkBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
    </Page.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Editor" Padding="32,28,32,40" HorizontalAlignment="Stretch">
            <TextBlock l:Loc.Uid="Feel_Title" Style="{StaticResource SnapwellPageTitleStyle}" />
            <TextBlock l:Loc.Uid="Feel_Lead"
                       Style="{StaticResource SnapwellLeadTextStyle}" />

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button l:Loc.Uid="Feel_CardAiry" x:Name="CardAiry" Tag="Airy" Click="FeelCard_Click"
                        Style="{StaticResource FeelCardButtonStyle}"
                        >
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="airy" FontWeight="SemiBold" FontSize="13" LineHeight="20.8"
                                   Foreground="{ThemeResource SnapwellInkBrush}" />
                        <TextBlock l:Loc.Uid="Feel_AiryDescription" Grid.Row="1"
                                   FontFamily="{StaticResource SnapwellMonoFontFamily}" FontSize="11" LineHeight="17.6"
                                   Foreground="{ThemeResource SnapwellMutedBrush}" TextWrapping="Wrap" />
                        <Viewbox Grid.Row="2" VerticalAlignment="Bottom" Height="54" Stretch="Fill" Margin="0,8,0,0">
                            <Canvas Width="160" Height="54">
                                <Line X1="0" Y1="12" X2="160" Y2="12"
                                      Stroke="{ThemeResource SnapwellBorderStrongBrush}"
                                      StrokeThickness="1" StrokeDashArray="3,3" />
                                <Polyline x:Name="AiryCurve" Stroke="{ThemeResource SnapwellInkBrush}"
                                          StrokeThickness="1.5" />
                            </Canvas>
                        </Viewbox>
                    </Grid>
                </Button>
                <Button l:Loc.Uid="Feel_CardSnappy" x:Name="CardSnappy" Grid.Column="1" Tag="Snappy" Click="FeelCard_Click"
                        Style="{StaticResource FeelCardButtonStyle}"
                        >
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="snappy" FontWeight="SemiBold" FontSize="13" LineHeight="20.8"
                                   Foreground="{ThemeResource SnapwellInkBrush}" />
                        <TextBlock l:Loc.Uid="Feel_SnappyDescription" Grid.Row="1"
                                   FontFamily="{StaticResource SnapwellMonoFontFamily}" FontSize="11" LineHeight="17.6"
                                   Foreground="{ThemeResource SnapwellMutedBrush}" TextWrapping="Wrap" />
                        <Viewbox Grid.Row="2" VerticalAlignment="Bottom" Height="54" Stretch="Fill" Margin="0,8,0,0">
                            <Canvas Width="160" Height="54">
                                <Line X1="0" Y1="12" X2="160" Y2="12"
                                      Stroke="{ThemeResource SnapwellBorderStrongBrush}"
                                      StrokeThickness="1" StrokeDashArray="3,3" />
                                <Polyline x:Name="SnappyCurve" Stroke="{ThemeResource SnapwellInkBrush}"
                                          StrokeThickness="1.5" />
                            </Canvas>
                        </Viewbox>
                    </Grid>
                </Button>
                <Button l:Loc.Uid="Feel_CardHeavy" x:Name="CardHeavy" Grid.Column="2" Tag="Heavy" Click="FeelCard_Click"
                        Style="{StaticResource FeelCardButtonStyle}"
                        >
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="heavy" FontWeight="SemiBold" FontSize="13" LineHeight="20.8"
                                   Foreground="{ThemeResource SnapwellInkBrush}" />
                        <TextBlock l:Loc.Uid="Feel_HeavyDescription" Grid.Row="1"
                                   FontFamily="{StaticResource SnapwellMonoFontFamily}" FontSize="11" LineHeight="17.6"
                                   Foreground="{ThemeResource SnapwellMutedBrush}" TextWrapping="Wrap" />
                        <Viewbox Grid.Row="2" VerticalAlignment="Bottom" Height="54" Stretch="Fill" Margin="0,8,0,0">
                            <Canvas Width="160" Height="54">
                                <Line X1="0" Y1="12" X2="160" Y2="12"
                                      Stroke="{ThemeResource SnapwellBorderStrongBrush}"
                                      StrokeThickness="1" StrokeDashArray="3,3" />
                                <Polyline x:Name="HeavyCurve" Stroke="{ThemeResource SnapwellInkBrush}"
                                          StrokeThickness="1.5" />
                            </Canvas>
                        </Viewbox>
                    </Grid>
                </Button>
                <Button l:Loc.Uid="Feel_CardBouncy" x:Name="CardBouncy" Grid.Column="3" Tag="Bouncy" Click="FeelCard_Click"
                        Style="{StaticResource FeelCardButtonStyle}"
                        >
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="bouncy" FontWeight="SemiBold" FontSize="13" LineHeight="20.8"
                                   Foreground="{ThemeResource SnapwellInkBrush}" />
                        <TextBlock l:Loc.Uid="Feel_BouncyDescription" Grid.Row="1"
                                   FontFamily="{StaticResource SnapwellMonoFontFamily}" FontSize="11" LineHeight="17.6"
                                   Foreground="{ThemeResource SnapwellMutedBrush}" TextWrapping="Wrap" />
                        <Viewbox Grid.Row="2" VerticalAlignment="Bottom" Height="54" Stretch="Fill" Margin="0,8,0,0">
                            <Canvas Width="160" Height="54">
                                <Line X1="0" Y1="12" X2="160" Y2="12"
                                      Stroke="{ThemeResource SnapwellBorderStrongBrush}"
                                      StrokeThickness="1" StrokeDashArray="3,3" />
                                <Polyline x:Name="BouncyCurve" Stroke="{ThemeResource SnapwellInkBrush}"
                                          StrokeThickness="1.5" />
                            </Canvas>
                        </Viewbox>
                    </Grid>
                </Button>
            </Grid>

            <TextBlock l:Loc.Uid="Feel_TrialTitle" Style="{StaticResource SnapwellGroupTitleStyle}" />
            <Border Style="{StaticResource SnapwellRowsBorderStyle}" Padding="12">
                <StackPanel Spacing="10">
                    <Canvas x:Name="TrialStage" Height="260" HorizontalAlignment="Stretch"
                            Background="{ThemeResource SnapwellWallBrush}" SizeChanged="TrialStage_SizeChanged"
                            PointerPressed="TrialStage_PointerPressed" PointerMoved="TrialStage_PointerMoved"
                            PointerReleased="TrialStage_PointerReleased"
                            PointerCanceled="TrialStage_PointerCanceled"
                            PointerCaptureLost="TrialStage_PointerCanceled">
                        <Border l:Loc.Uid="Feel_TrialCard" x:Name="TrialCard" IsTabStop="True" CornerRadius="8"
                                BorderThickness="1" Background="{ThemeResource SnapwellSurfaceBrush}"
                                BorderBrush="{ThemeResource SnapwellBorderStrongBrush}"
                                RenderTransformOrigin="0.5,0.5" KeyDown="TrialCard_KeyDown">
                            <Border.RenderTransform>
                                <CompositeTransform x:Name="TrialCardTransform" />
                            </Border.RenderTransform>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8" Padding="10,0,0,0"
                                            VerticalAlignment="Center">
                                    <Border Width="12" Height="12" CornerRadius="3"
                                            Background="{ThemeResource SnapwellMutedBrush}" />
                                    <TextBlock l:Loc.Uid="Feel_TrialWindowLabel" FontSize="12"
                                               Foreground="{ThemeResource SnapwellTextBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Spacing="7" Padding="12,10,12,0">
                                    <Border Height="7" CornerRadius="4" HorizontalAlignment="Left" Width="80"
                                            Background="{ThemeResource SnapwellSkeletonBrush}" />
                                    <Border Height="7" CornerRadius="4" HorizontalAlignment="Left" Width="56"
                                            Background="{ThemeResource SnapwellSkeletonBrush}" />
                                    <Border Height="7" CornerRadius="4" HorizontalAlignment="Left" Width="68"
                                            Background="{ThemeResource SnapwellSkeletonBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Canvas>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button l:Loc.Uid="Feel_TrialZonesButton" x:Name="TrialZonesButton" Click="TrialMode_Click" Tag="Zones"
                                Style="{StaticResource SelectedChipButtonStyle}" />
                        <Button l:Loc.Uid="Feel_TrialCornersButton" x:Name="TrialCornersButton" Click="TrialMode_Click" Tag="Corners"
                                Style="{StaticResource ChipButtonStyle}" />
                        <Button l:Loc.Uid="Feel_TrialThrowButton" x:Name="TrialThrowButton" Click="TrialThrow_Click"
                                Style="{StaticResource ChipButtonStyle}" />
                    </StackPanel>
                    <TextBlock l:Loc.Uid="Feel_TrialHint"
                               Style="{StaticResource SnapwellRowDescriptionStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock l:Loc.Uid="Feel_DetailsTitle" Style="{StaticResource SnapwellGroupTitleStyle}" VerticalAlignment="Center" />
                <TextBlock x:Name="FeelStateText" Style="{StaticResource SnapwellMonoTextStyle}"
                           VerticalAlignment="Center" />
                <Button l:Loc.Uid="Feel_FeelResetButton" x:Name="FeelResetButton" Click="FeelReset_Click"
                        Style="{StaticResource SnapwellActionButtonStyle}" Visibility="Collapsed" />
            </StackPanel>
            <Border Style="{StaticResource SnapwellRowsBorderStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock l:Loc.Uid="Feel_ModeTitle" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock l:Loc.Uid="Feel_ModeDescription"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <ComboBox l:Loc.Uid="Feel_ModeBox" x:Name="ModeBox" Grid.Column="1" Width="240" VerticalAlignment="Center"
                                   SelectionChanged="Mode_SelectionChanged">
                            <ComboBoxItem l:Loc.Uid="Feel_ModeZones" />
                            <ComboBoxItem l:Loc.Uid="Feel_ModeCorners" />
                        </ComboBox>
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock l:Loc.Uid="Feel_MassTitle" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock l:Loc.Uid="Feel_MassDescription"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel x:Name="MassPanel" Grid.Column="1" Orientation="Horizontal" Spacing="12"
                                    VerticalAlignment="Center">
                            <Slider l:Loc.Uid="Feel_MassSlider" x:Name="MassSlider" Width="200" Minimum="0" Maximum="1000"
                                     />
                            <NumberBox l:Loc.Uid="Feel_MassBox" x:Name="MassBox" Width="130" Minimum="0.15" Maximum="8"
                                       SmallChange="0.05" LargeChange="0.5"
                                       SpinButtonPlacementMode="Compact"
                                       ValidationMode="InvalidInputOverwritten" />
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock l:Loc.Uid="Feel_FrequencyTitle" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock l:Loc.Uid="Feel_FrequencyDescription"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel x:Name="FrequencyPanel" Grid.Column="1" Orientation="Horizontal" Spacing="12"
                                    VerticalAlignment="Center">
                            <Slider l:Loc.Uid="Feel_FrequencySlider" x:Name="FrequencySlider" Width="200" Minimum="0" Maximum="1000"
                                     />
                            <NumberBox l:Loc.Uid="Feel_FrequencyBox" x:Name="FrequencyBox" Width="130" Minimum="0.4" Maximum="7"
                                       SmallChange="0.05" LargeChange="0.5"
                                       SpinButtonPlacementMode="Compact"
                                       ValidationMode="InvalidInputOverwritten" />
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock l:Loc.Uid="Feel_DampingTitle" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock l:Loc.Uid="Feel_DampingDescription"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel x:Name="DampingRatioPanel" Grid.Column="1" Orientation="Horizontal" Spacing="12"
                                    VerticalAlignment="Center">
                            <Slider l:Loc.Uid="Feel_DampingRatioSlider" x:Name="DampingRatioSlider" Width="200" Minimum="0" Maximum="1000"
                                     />
                            <NumberBox l:Loc.Uid="Feel_DampingRatioBox" x:Name="DampingRatioBox" Width="130" Minimum="0.1" Maximum="1.6"
                                       SmallChange="0.01" LargeChange="0.1"
                                       SpinButtonPlacementMode="Compact"
                                       ValidationMode="InvalidInputOverwritten" />
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />

                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock l:Loc.Uid="Feel_MagnetTitle" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock l:Loc.Uid="Feel_MagnetDescription" Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel x:Name="MagnetStrengthPanel" Grid.Column="1" Orientation="Horizontal" Spacing="12"
                                    VerticalAlignment="Center">
                            <Slider l:Loc.Uid="Feel_MagnetStrengthSlider" x:Name="MagnetStrengthSlider" Width="200" Minimum="0" Maximum="1000"
                                     />
                            <NumberBox l:Loc.Uid="Feel_MagnetStrengthBox" x:Name="MagnetStrengthBox" Width="130" Minimum="0" Maximum="2"
                                       SmallChange="0.05" LargeChange="0.1"
                                       SpinButtonPlacementMode="Compact"
                                       ValidationMode="InvalidInputOverwritten" />
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock l:Loc.Uid="Feel_RadiusTitle" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock l:Loc.Uid="Feel_RadiusDescription" Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel x:Name="SnapRadiusPanel" Grid.Column="1" Orientation="Horizontal" Spacing="12"
                                    VerticalAlignment="Center">
                            <Slider l:Loc.Uid="Feel_SnapRadiusSlider" x:Name="SnapRadiusSlider" Width="200" Minimum="0" Maximum="1000"
                                     />
                            <NumberBox l:Loc.Uid="Feel_SnapRadiusBox" x:Name="SnapRadiusBox" Width="130" Minimum="8" Maximum="96"
                                       SmallChange="1" LargeChange="8"
                                       SpinButtonPlacementMode="Compact"
                                       ValidationMode="InvalidInputOverwritten" />
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock l:Loc.Uid="Feel_DerivedTitle" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock Text="k = m(2πf)², c = 2ζ√(km)"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <TextBlock x:Name="DerivedValueText" Grid.Column="1" VerticalAlignment="Center"
                                   Style="{StaticResource SnapwellMonoTextStyle}" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock l:Loc.Uid="Feel_AccessibilityTitle" Style="{StaticResource SnapwellGroupTitleStyle}" />
            <Border Style="{StaticResource SnapwellRowsBorderStyle}">
                <Grid Style="{StaticResource SnapwellRowGridStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock l:Loc.Uid="Feel_MotionTitle" Style="{StaticResource SnapwellRowTitleStyle}" />
                        <TextBlock l:Loc.Uid="Feel_MotionDescription"
                                   Style="{StaticResource SnapwellRowDescriptionStyle}" />
                    </StackPanel>
                    <ToggleSwitch l:Loc.Uid="Feel_MotionSwitch" x:Name="MotionSwitch" Grid.Column="1"
                                  OnContent="" OffContent="" MinWidth="0"
                                  Style="{StaticResource SnapwellToggleSwitchStyle}"
                                  VerticalAlignment="Center"
                                  Toggled="Motion_Toggled" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
