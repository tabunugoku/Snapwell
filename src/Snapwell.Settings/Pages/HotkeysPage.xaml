<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Snapwell.Settings.Pages.HotkeysPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:l="using:Snapwell.Settings.Localization"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <Style x:Key="HotkeyRowStyle" TargetType="Grid" BasedOn="{StaticResource SnapwellRowGridStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="BorderBrush" Value="{ThemeResource SnapwellBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style x:Key="HotkeyRowHostStyle" TargetType="Grid">
            <Setter Property="Background" Value="{ThemeResource SnapwellSurfaceBrush}" />
        </Style>
        <Style x:Key="HotkeyHeaderStyle" TargetType="Grid" BasedOn="{StaticResource HotkeyRowStyle}">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="{ThemeResource SnapwellSurface2Brush}" />
        </Style>
        <Style x:Key="HotkeyButtonStyle" TargetType="Button" BasedOn="{StaticResource SnapwellButtonStyle}">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style x:Key="HotkeyCaptureStyle" TargetType="Button" BasedOn="{StaticResource HotkeyButtonStyle}">
            <Setter Property="BorderBrush" Value="{ThemeResource SnapwellBlueTextBrush}" />
            <Setter Property="Background" Value="{ThemeResource SnapwellBlueBackgroundBrush}" />
        </Style>
        <Style x:Key="HotkeyErrorStyle" TargetType="Button" BasedOn="{StaticResource HotkeyCaptureStyle}">
            <Setter Property="BorderBrush" Value="{ThemeResource SnapwellRedTextBrush}" />
            <Setter Property="Background" Value="{ThemeResource SnapwellRedBackgroundBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource SnapwellRedTextBrush}" />
        </Style>
        <Style x:Key="HotkeyPulseStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{ThemeResource SnapwellBlueBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="3" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Margin" Value="-3" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        </Style>
        <Style x:Key="HotkeyFlashStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SnapwellBlueBackgroundBrush}" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style x:Key="HotkeyMessageStyle" TargetType="StackPanel">
            <Setter Property="Padding" Value="24,8,12,10" />
            <Setter Property="Spacing" Value="8" />
            <Setter Property="Background" Value="{ThemeResource SnapwellSurface2Brush}" />
        </Style>
    </Page.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32,28,32,40" HorizontalAlignment="Stretch">
            <TextBlock l:Loc.Uid="Hotkeys_Title" Style="{StaticResource SnapwellPageTitleStyle}" />
            <TextBlock l:Loc.Uid="Hotkeys_Lead" Style="{StaticResource SnapwellLeadTextStyle}" />
            <Grid ColumnSpacing="12" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox l:Loc.Uid="Hotkeys_FilterBox" x:Name="FilterBox" TextChanged="Filter_Changed" />
                <Button l:Loc.Uid="Hotkeys_ResetButton" x:Name="ResetButton" Grid.Column="1"
                        Style="{StaticResource SnapwellActionButtonStyle}" Click="Reset_Click" />
            </Grid>
            <StackPanel x:Name="Summary" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8"
                        AutomationProperties.LiveSetting="Polite" />
            <Border Style="{StaticResource SnapwellRowsBorderStyle}">
                <StackPanel>
                    <Grid Padding="12,8" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="4*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>
                        <TextBlock l:Loc.Uid="Hotkeys_ActionColumn" Style="{StaticResource SnapwellHintTextStyle}" />
                        <TextBlock l:Loc.Uid="Hotkeys_KeyColumn" Grid.Column="1"
                                   Style="{StaticResource SnapwellHintTextStyle}" />
                        <TextBlock l:Loc.Uid="Hotkeys_StatusColumn" Grid.Column="2"
                                   Style="{StaticResource SnapwellHintTextStyle}" />
                    </Grid>
                    <StackPanel x:Name="HotkeyRows" />
                </StackPanel>
            </Border>
            <TextBlock l:Loc.Uid="Hotkeys_CaptureHint" Margin="0,10,0,0"
                       Style="{StaticResource SnapwellHintTextStyle}" />
            <TextBlock l:Loc.Uid="Hotkeys_ConflictHint" Margin="0,8,0,0"
                       Style="{StaticResource SnapwellHintTextStyle}" />
            <Grid x:Name="WinNotice" ColumnSpacing="6" Margin="0,8,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource SnapwellTagYellowStyle}">
                    <TextBlock l:Loc.Uid="Hotkeys_Note" Style="{StaticResource SnapwellTagYellowTextStyle}" />
                </Border>
                <TextBlock l:Loc.Uid="Hotkeys_WinHint" Grid.Column="1" Style="{StaticResource SnapwellHintTextStyle}" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
