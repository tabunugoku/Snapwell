                    <Border
                        Grid.Row="8"
                        Grid.Column="2"
                        Padding="12,10"
                        BorderThickness="0,0,0,0"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <TextBlock
                            Text=""
                            Style="{StaticResource SnapwellRowTitleStyle}"
                            FontSize="13"
                            LineHeight="20.8"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource SnapwellTextBrush}" />
                    </Border>
                </Grid>
            </Border>
            <Grid ColumnSpacing="6" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Background="{ThemeResource SnapwellRedBackgroundBrush}"
                    CornerRadius="9999"
                    Padding="8,1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
                    <TextBlock
                        Text="重複"
                        FontSize="10.5"
                        FontWeight="SemiBold"
                        CharacterSpacing="50"
                        LineHeight="16.8"
