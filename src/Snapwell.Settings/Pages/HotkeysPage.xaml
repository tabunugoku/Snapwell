<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Snapwell.Settings.Pages.HotkeysPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Snapwell.Settings.Pages">
    <Page.Resources>
        <Style x:Key="DemoSwitchStyle" TargetType="ToggleSwitch"
               BasedOn="{StaticResource SnapwellDemoSwitchStyle}" />
        <Style x:Key="DemoKeyBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SnapwellSurface2Brush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SnapwellBorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="MinWidth" Value="22" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DemoKeyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SnapwellMonoTextStyle}">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="KbdBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SnapwellSurface2Brush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SnapwellBorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="MinWidth" Value="22" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="KbdTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource SnapwellMonoFontFamily}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="Foreground" Value="{ThemeResource SnapwellTextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32,28,32,40" HorizontalAlignment="Stretch">
            <TextBlock Text="ホットキー" Style="{StaticResource SnapwellPageTitleStyle}" />
            <TextBlock Text="割り当ての一覧です。同じキーを複数の操作に割り当てている行には「重複」と表示します。"
                       Style="{StaticResource SnapwellLeadTextStyle}" />
            <InfoBar x:Name="ConflictNotice" Severity="Warning" IsClosable="False"
                     Message="キーが重複しています。「既定に戻す」か、重複しない設定ファイルを取り込んでください。" />

            <Border Style="{StaticResource SnapwellRowsBorderStyle}">
                <StackPanel>
                    <Grid Padding="12,8" ColumnSpacing="16"
                          BorderBrush="{ThemeResource SnapwellBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="64" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="操作" FontSize="12" FontWeight="Medium"
                                   Foreground="{ThemeResource SnapwellMutedBrush}" />
                        <TextBlock Grid.Column="1" Text="キー" FontSize="12" FontWeight="Medium"
                                   Foreground="{ThemeResource SnapwellMutedBrush}" />
                    </Grid>
                    <ListView x:Name="HotkeyList" SelectionMode="None" IsItemClickEnabled="False"
                              HorizontalContentAlignment="Stretch">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:HotkeyRow">
                                <Grid Padding="12,10" ColumnSpacing="16" HorizontalAlignment="Stretch"
                                      BorderBrush="{ThemeResource SnapwellBorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="64" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Name}" FontSize="13" LineHeight="20.8"
                                               Foreground="{ThemeResource SnapwellTextBrush}"
                                               TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                                VerticalAlignment="Center">
                                        <Border Style="{StaticResource KbdBorderStyle}">
                                            <TextBlock Text="{x:Bind Key1}" Style="{StaticResource KbdTextStyle}" />
                                        </Border>
                                        <Border Style="{StaticResource KbdBorderStyle}"
                                                Visibility="{x:Bind Key2Visibility}">
                                            <TextBlock Text="{x:Bind Key2}" Style="{StaticResource KbdTextStyle}" />
                                        </Border>
                                        <Border Style="{StaticResource KbdBorderStyle}"
                                                Visibility="{x:Bind Key3Visibility}">
                                            <TextBlock Text="{x:Bind Key3}" Style="{StaticResource KbdTextStyle}" />
                                        </Border>
                                        <Border Style="{StaticResource KbdBorderStyle}"
                                                Visibility="{x:Bind Key4Visibility}">
                                            <TextBlock Text="{x:Bind Key4}" Style="{StaticResource KbdTextStyle}" />
                                        </Border>
                                        <Border Style="{StaticResource KbdBorderStyle}"
                                                Visibility="{x:Bind Key5Visibility}">
                                            <TextBlock Text="{x:Bind Key5}" Style="{StaticResource KbdTextStyle}" />
                                        </Border>
                                    </StackPanel>
                                    <Border Grid.Column="2" Visibility="{x:Bind ConflictVisibility}"
                                            Background="{ThemeResource SnapwellRedBackgroundBrush}"
                                            CornerRadius="999" Padding="8,1" HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="重複" FontSize="10.5" FontWeight="SemiBold"
                                                   CharacterSpacing="50"
                                                   Foreground="{ThemeResource SnapwellRedTextBrush}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
            <TextBlock Text="ほかのアプリとの競合は、この画面では確認できません。" Style="{StaticResource SnapwellHintTextStyle}" Margin="0,10,0,12"/>
            <Button x:Name="ResetButton" Content="既定に戻す" Style="{StaticResource SnapwellButtonStyle}"
                Click="Reset_Click" />

            <!-- デモ状態 (未実装) -->
            <Grid Margin="0,22,0,8" ColumnSpacing="6" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="デモ (準備中)" Style="{StaticResource SnapwellGroupTitleStyle}" Margin="0" />
                <Border Grid.Column="1" Style="{StaticResource SnapwellPendingTagStyle}">
                    <TextBlock Text="準備中" Style="{StaticResource SnapwellPendingTagTextStyle}" />
                </Border>
            </Grid>
            <Border Style="{StaticResource SnapwellRowsBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.1*" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border
                        Grid.Row="0"
                        Grid.Column="0"
                        Padding="12,8"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <TextBlock
                            Text="操作"
                            Style="{StaticResource SnapwellRowTitleStyle}"
                            FontSize="12"
                            LineHeight="19.2"
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Foreground="{ThemeResource SnapwellMutedBrush}" />
                    </Border>
                    <Border
                        Grid.Row="0"
                        Grid.Column="1"
                        Padding="12,8"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <TextBlock
                            Text="キー"
                            Style="{StaticResource SnapwellRowTitleStyle}"
                            FontSize="12"
                            LineHeight="19.2"
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Foreground="{ThemeResource SnapwellMutedBrush}" />
                    </Border>
                    <Border
                        Grid.Row="0"
                        Grid.Column="2"
                        Padding="12,8"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <TextBlock
                            Text=""
                            Style="{StaticResource SnapwellRowTitleStyle}"
                            FontSize="12"
                            LineHeight="19.2"
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Foreground="{ThemeResource SnapwellMutedBrush}" />
                    </Border>
                    <Border
                        Grid.Row="1"
                        Grid.Column="0"
                        Padding="12,10"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <TextBlock
                            Text="ランチャーを開く"
                            Style="{StaticResource SnapwellRowTitleStyle}"
                            FontSize="13"
                            LineHeight="20.8"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource SnapwellTextBrush}" />
                    </Border>
                    <Border
                        Grid.Row="1"
                        Grid.Column="1"
                        Padding="12,10"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <RichTextBlock FontSize="13" LineHeight="20.8" Foreground="{ThemeResource SnapwellTextBrush}">
                            <Paragraph Margin="0">
                                <InlineUIContainer>
                                    <Border Style="{StaticResource DemoKeyBorderStyle}">
                                        <TextBlock Text="Ctrl" Style="{StaticResource DemoKeyTextStyle}" />
                                    </Border>
                                </InlineUIContainer>
                                <Run Text=" " />
                                <InlineUIContainer>
                                    <Border Style="{StaticResource DemoKeyBorderStyle}">
                                        <TextBlock Text="Alt" Style="{StaticResource DemoKeyTextStyle}" />
                                    </Border>
                                </InlineUIContainer>
                                <Run Text=" " />
                                <InlineUIContainer>
                                    <Border Style="{StaticResource DemoKeyBorderStyle}">
                                        <TextBlock Text="Space" Style="{StaticResource DemoKeyTextStyle}" />
                                    </Border>
                                </InlineUIContainer>
                            </Paragraph>
                        </RichTextBlock>
                    </Border>
                    <Border
                        Grid.Row="1"
                        Grid.Column="2"
                        Padding="12,10"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <TextBlock
                            Text=""
                            Style="{StaticResource SnapwellRowTitleStyle}"
                            FontSize="13"
                            LineHeight="20.8"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource SnapwellTextBrush}" />
                    </Border>
                    <Border
                        Grid.Row="2"
                        Grid.Column="0"
                        Padding="12,10"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <TextBlock
                            Text="左・右・上・下の半分"
                            Style="{StaticResource SnapwellRowTitleStyle}"
                            FontSize="13"
                            LineHeight="20.8"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource SnapwellTextBrush}" />
                    </Border>
                    <Border
                        Grid.Row="2"
                        Grid.Column="1"
                        Padding="12,10"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <RichTextBlock FontSize="13" LineHeight="20.8" Foreground="{ThemeResource SnapwellTextBrush}">
                            <Paragraph Margin="0">
                                <InlineUIContainer>
                                    <Border Style="{StaticResource DemoKeyBorderStyle}">
                                        <TextBlock Text="Ctrl" Style="{StaticResource DemoKeyTextStyle}" />
                                    </Border>
                                </InlineUIContainer>
                                <Run Text=" " />
                                <InlineUIContainer>
                                    <Border Style="{StaticResource DemoKeyBorderStyle}">
                                        <TextBlock Text="Alt" Style="{StaticResource DemoKeyTextStyle}" />
                                    </Border>
                                </InlineUIContainer>
                                <Run Text=" " />
                                <InlineUIContainer>
                                    <Border Style="{StaticResource DemoKeyBorderStyle}">
                                        <TextBlock Text="←" Style="{StaticResource DemoKeyTextStyle}" />
                                    </Border>
                                </InlineUIContainer>
                                <InlineUIContainer>
                                    <Border Style="{StaticResource DemoKeyBorderStyle}">
                                        <TextBlock Text="→" Style="{StaticResource DemoKeyTextStyle}" />
                                    </Border>
                                </InlineUIContainer>
                                <InlineUIContainer>
                                    <Border Style="{StaticResource DemoKeyBorderStyle}">
                                        <TextBlock Text="↑" Style="{StaticResource DemoKeyTextStyle}" />
                                    </Border>
                                </InlineUIContainer>
                                <InlineUIContainer>
                                    <Border Style="{StaticResource DemoKeyBorderStyle}">
                                        <TextBlock Text="↓" Style="{StaticResource DemoKeyTextStyle}" />
                                    </Border>
                                </InlineUIContainer>
                            </Paragraph>
                        </RichTextBlock>
                    </Border>
                    <Border
                        Grid.Row="2"
                        Grid.Column="2"
                        Padding="12,10"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <TextBlock
                            Text=""
                            Style="{StaticResource SnapwellRowTitleStyle}"
                            FontSize="13"
                            LineHeight="20.8"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource SnapwellTextBrush}" />
                    </Border>
                    <Border
                        Grid.Row="3"
                        Grid.Column="0"
                        Padding="12,10"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <TextBlock
                            Text="四分割"
                            Style="{StaticResource SnapwellRowTitleStyle}"
                            FontSize="13"
                            LineHeight="20.8"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource SnapwellTextBrush}" />
                    </Border>
                    <Border
                        Grid.Row="3"
                        Grid.Column="1"
                        Padding="12,10"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <RichTextBlock FontSize="13" LineHeight="20.8" Foreground="{ThemeResource SnapwellTextBrush}">
                            <Paragraph Margin="0">
                                <InlineUIContainer>
                                    <Border Style="{StaticResource DemoKeyBorderStyle}">
                                        <TextBlock Text="Ctrl" Style="{StaticResource DemoKeyTextStyle}" />
                                    </Border>
                                </InlineUIContainer>
                                <Run Text=" " />
                                <InlineUIContainer>
                                    <Border Style="{StaticResource DemoKeyBorderStyle}">
                                        <TextBlock Text="Alt" Style="{StaticResource DemoKeyTextStyle}" />
                                    </Border>
                                </InlineUIContainer>
                                <Run Text=" " />
                                <InlineUIContainer>
                                    <Border Style="{StaticResource DemoKeyBorderStyle}">
                                        <TextBlock Text="U" Style="{StaticResource DemoKeyTextStyle}" />
                                    </Border>
                                </InlineUIContainer>
                                <InlineUIContainer>
                                    <Border Style="{StaticResource DemoKeyBorderStyle}">
                                        <TextBlock Text="I" Style="{StaticResource DemoKeyTextStyle}" />
                                    </Border>
                                </InlineUIContainer>
                                <InlineUIContainer>
                                    <Border Style="{StaticResource DemoKeyBorderStyle}">
                                        <TextBlock Text="J" Style="{StaticResource DemoKeyTextStyle}" />
                                    </Border>
                                </InlineUIContainer>
                                <InlineUIContainer>
                                    <Border Style="{StaticResource DemoKeyBorderStyle}">
                                        <TextBlock Text="K" Style="{StaticResource DemoKeyTextStyle}" />
                                    </Border>
                                </InlineUIContainer>
                            </Paragraph>
                        </RichTextBlock>
                    </Border>
                    <Border
                        Grid.Row="3"
                        Grid.Column="2"
                        Padding="12,10"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <TextBlock
                            Text=""
                            Style="{StaticResource SnapwellRowTitleStyle}"
                            FontSize="13"
                            LineHeight="20.8"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource SnapwellTextBrush}" />
                    </Border>
                    <Border
                        Grid.Row="4"
                        Grid.Column="0"
                        Padding="12,10"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <TextBlock
                            Text="1 区画ずつ拡大・縮小"
                            Style="{StaticResource SnapwellRowTitleStyle}"
                            FontSize="13"
                            LineHeight="20.8"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource SnapwellTextBrush}" />
                    </Border>
                    <Border
                        Grid.Row="4"
                        Grid.Column="1"
                        Padding="12,10"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <RichTextBlock FontSize="13" LineHeight="20.8" Foreground="{ThemeResource SnapwellTextBrush}">
                            <Paragraph Margin="0">
                                <InlineUIContainer>
                                    <Border Style="{StaticResource DemoKeyBorderStyle}">
                                        <TextBlock Text="Ctrl" Style="{StaticResource DemoKeyTextStyle}" />
                                    </Border>
                                </InlineUIContainer>
                                <Run Text=" " />
                                <InlineUIContainer>
                                    <Border Style="{StaticResource DemoKeyBorderStyle}">
                                        <TextBlock Text="Alt" Style="{StaticResource DemoKeyTextStyle}" />
                                    </Border>
                                </InlineUIContainer>
                                <Run Text=" " />
                                <InlineUIContainer>
                                    <Border Style="{StaticResource DemoKeyBorderStyle}">
                                        <TextBlock Text="Shift" Style="{StaticResource DemoKeyTextStyle}" />
                                    </Border>
                                </InlineUIContainer>
                                <Run Text=" + 矢印" />
                            </Paragraph>
                        </RichTextBlock>
                    </Border>
                    <Border
                        Grid.Row="4"
                        Grid.Column="2"
                        Padding="12,10"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <TextBlock
                            Text=""
                            Style="{StaticResource SnapwellRowTitleStyle}"
                            FontSize="13"
                            LineHeight="20.8"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource SnapwellTextBrush}" />
                    </Border>
                    <Border
                        Grid.Row="5"
                        Grid.Column="0"
                        Padding="12,10"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <TextBlock
                            Text="区画単位で移動"
                            Style="{StaticResource SnapwellRowTitleStyle}"
                            FontSize="13"
                            LineHeight="20.8"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource SnapwellTextBrush}" />
                    </Border>
                    <Border
                        Grid.Row="5"
                        Grid.Column="1"
                        Padding="12,10"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <RichTextBlock FontSize="13" LineHeight="20.8" Foreground="{ThemeResource SnapwellTextBrush}">
                            <Paragraph Margin="0">
                                <InlineUIContainer>
                                    <Border Style="{StaticResource DemoKeyBorderStyle}">
                                        <TextBlock Text="Ctrl" Style="{StaticResource DemoKeyTextStyle}" />
                                    </Border>
                                </InlineUIContainer>
                                <Run Text=" " />
                                <InlineUIContainer>
                                    <Border Style="{StaticResource DemoKeyBorderStyle}">
                                        <TextBlock Text="Alt" Style="{StaticResource DemoKeyTextStyle}" />
                                    </Border>
                                </InlineUIContainer>
                                <Run Text=" " />
                                <InlineUIContainer>
                                    <Border Style="{StaticResource DemoKeyBorderStyle}">
                                        <TextBlock Text="Win" Style="{StaticResource DemoKeyTextStyle}" />
                                    </Border>
                                </InlineUIContainer>
                                <Run Text=" + 矢印" />
                            </Paragraph>
                        </RichTextBlock>
                    </Border>
                    <Border
                        Grid.Row="5"
                        Grid.Column="2"
                        Padding="12,10"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <Border
                            Background="{ThemeResource SnapwellRedBackgroundBrush}"
                            CornerRadius="9999"
                            Padding="8,1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                            <TextBlock
                                Text="重複"
                                FontSize="10.5"
                                FontWeight="SemiBold"
                                CharacterSpacing="50"
                                LineHeight="16.8"
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource SnapwellRedTextBrush}" />
                        </Border>
                    </Border>
                    <Border
                        Grid.Row="6"
                        Grid.Column="0"
                        Padding="12,10"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <TextBlock
                            Text="現在のモニターを整列"
                            Style="{StaticResource SnapwellRowTitleStyle}"
                            FontSize="13"
                            LineHeight="20.8"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource SnapwellTextBrush}" />
                    </Border>
                    <Border
                        Grid.Row="6"
                        Grid.Column="1"
                        Padding="12,10"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <RichTextBlock FontSize="13" LineHeight="20.8" Foreground="{ThemeResource SnapwellTextBrush}">
                            <Paragraph Margin="0">
                                <InlineUIContainer>
                                    <Border Style="{StaticResource DemoKeyBorderStyle}">
                                        <TextBlock Text="Ctrl" Style="{StaticResource DemoKeyTextStyle}" />
                                    </Border>
                                </InlineUIContainer>
                                <Run Text=" " />
                                <InlineUIContainer>
                                    <Border Style="{StaticResource DemoKeyBorderStyle}">
                                        <TextBlock Text="Alt" Style="{StaticResource DemoKeyTextStyle}" />
                                    </Border>
                                </InlineUIContainer>
                                <Run Text=" " />
                                <InlineUIContainer>
                                    <Border Style="{StaticResource DemoKeyBorderStyle}">
                                        <TextBlock Text="A" Style="{StaticResource DemoKeyTextStyle}" />
                                    </Border>
                                </InlineUIContainer>
                            </Paragraph>
                        </RichTextBlock>
                    </Border>
                    <Border
                        Grid.Row="6"
                        Grid.Column="2"
                        Padding="12,10"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <TextBlock
                            Text=""
                            Style="{StaticResource SnapwellRowTitleStyle}"
                            FontSize="13"
                            LineHeight="20.8"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource SnapwellTextBrush}" />
                    </Border>
                    <Border
                        Grid.Row="7"
                        Grid.Column="0"
                        Padding="12,10"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <TextBlock
                            Text="隣のモニターへ投げる"
                            Style="{StaticResource SnapwellRowTitleStyle}"
                            FontSize="13"
                            LineHeight="20.8"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource SnapwellTextBrush}" />
                    </Border>
                    <Border
                        Grid.Row="7"
                        Grid.Column="1"
                        Padding="12,10"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <RichTextBlock FontSize="13" LineHeight="20.8" Foreground="{ThemeResource SnapwellTextBrush}">
                            <Paragraph Margin="0">
                                <InlineUIContainer>
                                    <Border Style="{StaticResource DemoKeyBorderStyle}">
                                        <TextBlock Text="Ctrl" Style="{StaticResource DemoKeyTextStyle}" />
                                    </Border>
                                </InlineUIContainer>
                                <Run Text=" " />
                                <InlineUIContainer>
                                    <Border Style="{StaticResource DemoKeyBorderStyle}">
                                        <TextBlock Text="Alt" Style="{StaticResource DemoKeyTextStyle}" />
                                    </Border>
                                </InlineUIContainer>
                                <Run Text=" " />
                                <InlineUIContainer>
                                    <Border Style="{StaticResource DemoKeyBorderStyle}">
                                        <TextBlock Text="PgUp" Style="{StaticResource DemoKeyTextStyle}" />
                                    </Border>
                                </InlineUIContainer>
                                <InlineUIContainer>
                                    <Border Style="{StaticResource DemoKeyBorderStyle}">
                                        <TextBlock Text="PgDn" Style="{StaticResource DemoKeyTextStyle}" />
                                    </Border>
                                </InlineUIContainer>
                            </Paragraph>
                        </RichTextBlock>
                    </Border>
                    <Border
                        Grid.Row="7"
                        Grid.Column="2"
                        Padding="12,10"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <TextBlock
                            Text=""
                            Style="{StaticResource SnapwellRowTitleStyle}"
                            FontSize="13"
                            LineHeight="20.8"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource SnapwellTextBrush}" />
                    </Border>
                    <Border
                        Grid.Row="8"
                        Grid.Column="0"
                        Padding="12,10"
                        BorderThickness="0,0,0,0"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <TextBlock
                            Text="一時的に無効化"
                            Style="{StaticResource SnapwellRowTitleStyle}"
                            FontSize="13"
                            LineHeight="20.8"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource SnapwellTextBrush}" />
                    </Border>
                    <Border
                        Grid.Row="8"
                        Grid.Column="1"
                        Padding="12,10"
                        BorderThickness="0,0,0,0"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <RichTextBlock FontSize="13" LineHeight="20.8" Foreground="{ThemeResource SnapwellTextBrush}">
                            <Paragraph Margin="0">
                                <InlineUIContainer>
                                    <Border Style="{StaticResource DemoKeyBorderStyle}">
                                        <TextBlock Text="Ctrl" Style="{StaticResource DemoKeyTextStyle}" />
                                    </Border>
                                </InlineUIContainer>
                                <Run Text=" " />
                                <InlineUIContainer>
                                    <Border Style="{StaticResource DemoKeyBorderStyle}">
                                        <TextBlock Text="Alt" Style="{StaticResource DemoKeyTextStyle}" />
                                    </Border>
                                </InlineUIContainer>
                                <Run Text=" " />
                                <InlineUIContainer>
                                    <Border Style="{StaticResource DemoKeyBorderStyle}">
                                        <TextBlock Text="Pause" Style="{StaticResource DemoKeyTextStyle}" />
                                    </Border>
                                </InlineUIContainer>
                            </Paragraph>
                        </RichTextBlock>
                    </Border>
                    <Border
                        Grid.Row="8"
                        Grid.Column="2"
                        Padding="12,10"
                        BorderThickness="0,0,0,0"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
