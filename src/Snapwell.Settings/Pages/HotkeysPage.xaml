                            Text="隣のモニターへ投げる"
                            Style="{StaticResource SnapwellRowTitleStyle}"
                            FontSize="13"
                            LineHeight="20.8"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource SnapwellTextBrush}" />
                    </Border>
                    <Border
                        Grid.Row="7"
                        Grid.Column="1"
                        Padding="12,10"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <RichTextBlock FontSize="13" LineHeight="20.8" Foreground="{ThemeResource SnapwellTextBrush}">
                            <Paragraph Margin="0">
                                <InlineUIContainer>
                                    <Border Style="{StaticResource DemoKeyBorderStyle}">
                                        <TextBlock Text="Ctrl" Style="{StaticResource DemoKeyTextStyle}" />
                                    </Border>
                                </InlineUIContainer>
                                <Run Text=" " />
                                <InlineUIContainer>
                                    <Border Style="{StaticResource DemoKeyBorderStyle}">
                                        <TextBlock Text="Alt" Style="{StaticResource DemoKeyTextStyle}" />
                                    </Border>
                                </InlineUIContainer>
                                <Run Text=" " />
                                <InlineUIContainer>
                                    <Border Style="{StaticResource DemoKeyBorderStyle}">
                                        <TextBlock Text="PgUp" Style="{StaticResource DemoKeyTextStyle}" />
                                    </Border>
                                </InlineUIContainer>
                                <InlineUIContainer>
                                    <Border Style="{StaticResource DemoKeyBorderStyle}">
                                        <TextBlock Text="PgDn" Style="{StaticResource DemoKeyTextStyle}" />
                                    </Border>
                                </InlineUIContainer>
                            </Paragraph>
                        </RichTextBlock>
                    </Border>
                    <Border
                        Grid.Row="7"
                        Grid.Column="2"
                        Padding="12,10"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <TextBlock
                            Text=""
                            Style="{StaticResource SnapwellRowTitleStyle}"
                            FontSize="13"
                            LineHeight="20.8"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource SnapwellTextBrush}" />
                    </Border>
                    <Border
                        Grid.Row="8"
                        Grid.Column="0"
                        Padding="12,10"
                        BorderThickness="0,0,0,0"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <TextBlock
                            Text="一時的に無効化"
                            Style="{StaticResource SnapwellRowTitleStyle}"
                            FontSize="13"
                            LineHeight="20.8"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource SnapwellTextBrush}" />
                    </Border>
                    <Border
                        Grid.Row="8"
