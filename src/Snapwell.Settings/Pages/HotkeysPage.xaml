<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Snapwell.Settings.Pages.HotkeysPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <Style x:Key="HotkeyRowStyle" TargetType="Grid" BasedOn="{StaticResource SnapwellRowGridStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="BorderBrush" Value="{ThemeResource SnapwellBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style x:Key="HotkeyRowHostStyle" TargetType="Grid">
            <Setter Property="Background" Value="{ThemeResource SnapwellSurfaceBrush}" />
        </Style>
        <Style x:Key="HotkeyHeaderStyle" TargetType="Grid" BasedOn="{StaticResource HotkeyRowStyle}">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="{ThemeResource SnapwellSurface2Brush}" />
        </Style>
        <Style x:Key="HotkeyButtonStyle" TargetType="Button" BasedOn="{StaticResource SnapwellButtonStyle}">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style x:Key="HotkeyCaptureStyle" TargetType="Button" BasedOn="{StaticResource HotkeyButtonStyle}">
            <Setter Property="BorderBrush" Value="{ThemeResource SnapwellBlueTextBrush}" />
            <Setter Property="Background" Value="{ThemeResource SnapwellBlueBackgroundBrush}" />
        </Style>
        <Style x:Key="HotkeyErrorStyle" TargetType="Button" BasedOn="{StaticResource HotkeyCaptureStyle}">
            <Setter Property="BorderBrush" Value="{ThemeResource SnapwellRedTextBrush}" />
            <Setter Property="Background" Value="{ThemeResource SnapwellRedBackgroundBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource SnapwellRedTextBrush}" />
        </Style>
        <Style x:Key="HotkeyPulseStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{ThemeResource SnapwellBlueBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="3" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Margin" Value="-3" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        </Style>
        <Style x:Key="HotkeyFlashStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SnapwellBlueBackgroundBrush}" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style x:Key="HotkeyMessageStyle" TargetType="StackPanel">
            <Setter Property="Padding" Value="24,8,12,10" />
            <Setter Property="Spacing" Value="8" />
            <Setter Property="Background" Value="{ThemeResource SnapwellSurface2Brush}" />
        </Style>
    </Page.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32,28,32,40" HorizontalAlignment="Stretch">
            <TextBlock Text="ホットキー" Style="{StaticResource SnapwellPageTitleStyle}" />
            <TextBlock
                Text="キーの欄をクリックして、新しいキーを押すと割り当てを変えられます。同じキーを複数の操作に割り当てている行には「重複」と表示します。"
                Style="{StaticResource SnapwellLeadTextStyle}" />
            <Grid ColumnSpacing="12" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FilterBox" PlaceholderText="操作を絞り込む"
                         AutomationProperties.Name="操作を絞り込む" TextChanged="Filter_Changed" />
                <Button x:Name="ResetButton" Grid.Column="1" Content="すべて既定に戻す"
                        Style="{StaticResource SnapwellActionButtonStyle}" Click="Reset_Click" />
            </Grid>
            <StackPanel x:Name="Summary" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8"
                        AutomationProperties.LiveSetting="Polite" />
            <Border Style="{StaticResource SnapwellRowsBorderStyle}">
                <StackPanel>
                    <Grid Padding="12,8" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.1*" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="148" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="操作" Style="{StaticResource SnapwellHintTextStyle}" />
                        <TextBlock Grid.Column="1" Text="キー" Style="{StaticResource SnapwellHintTextStyle}" />
                        <TextBlock Grid.Column="2" Text="状態" Style="{StaticResource SnapwellHintTextStyle}" />
                    </Grid>
                    <StackPanel x:Name="HotkeyRows" />
                </StackPanel>
            </Border>
            <TextBlock Margin="0,10,0,0" Style="{StaticResource SnapwellHintTextStyle}"
                Text="キーの欄を選んで、割り当てたいキーを押します。Esc でやめる、Backspace か Delete で割り当てを外します。Ctrl・Alt・Shift・Win のどれかを含めてください。" />
            <TextBlock Margin="0,8,0,0" Style="{StaticResource SnapwellHintTextStyle}"
                Text="ほかのアプリとの競合は、キーを押したときと、このページを開いたときに調べます。ほかのアプリが使っているキーには「ほかのアプリが使用中」と表示します（調べられるのは、ほかのアプリがホットキーとして登録しているキーだけです）。" />
            <Grid x:Name="WinNotice" ColumnSpacing="6" Margin="0,8,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource SnapwellTagYellowStyle}">
                    <TextBlock Text="注意" Style="{StaticResource SnapwellTagYellowTextStyle}" />
                </Border>
                <TextBlock Grid.Column="1" Style="{StaticResource SnapwellHintTextStyle}"
                    Text="Win を含む割り当ては、押したあとにスタート メニューが開かないよう、Snapwell が割り当てのないキーを 1 回送ります" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
