<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Snapwell.Settings.Pages.HotkeysPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Snapwell.Settings.Pages">
    <Page.Resources>
        <Style x:Key="DemoSwitchStyle" TargetType="ToggleSwitch">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleSwitch">
                        <Grid Width="40" Height="20" Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="ToggleStates">
                                    <VisualState x:Name="Off" />
                                    <VisualState x:Name="On">
                                        <VisualState.Setters>
                                            <Setter
                                                Target="SwitchTrack.Background"
                                                Value="{ThemeResource SnapwellInkBrush}" />
                                            <Setter
                                                Target="SwitchTrack.BorderBrush"
                                                Value="{ThemeResource SnapwellInkBrush}" />
                                            <Setter
                                                Target="SwitchKnob.Fill"
                                                Value="{ThemeResource SnapwellInkTextBrush}" />
                                            <Setter Target="SwitchKnob.Margin" Value="23,0,0,0" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border
                                x:Name="SwitchTrack"
                                CornerRadius="9999"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource SnapwellMutedBrush}" />
                            <Ellipse
                                x:Name="SwitchKnob"
                                Width="12"
                                Height="12"
                                Margin="3,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource SnapwellMutedBrush}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DemoKeyBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SnapwellSurface2Brush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SnapwellBorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="MinWidth" Value="22" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DemoKeyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SnapwellMonoTextStyle}">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="KbdBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SnapwellSurface2Brush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SnapwellBorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="MinWidth" Value="22" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="KbdTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource SnapwellMonoFontFamily}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="Foreground" Value="{ThemeResource SnapwellTextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32,28,32,40" HorizontalAlignment="Stretch">
            <TextBlock Text="ホットキー" Style="{StaticResource SnapwellPageTitleStyle}" />
            <TextBlock Text="クリックして新しいキーを押すと変更できます。ほかのアプリと重なるキーには印が付きます。"
                       Style="{StaticResource SnapwellLeadTextStyle}" />
            <InfoBar x:Name="ConflictNotice" Severity="Warning" IsClosable="False"
                     Message="キーが重複しています。「既定に戻す」か、重複しない設定ファイルを取り込んでください。" />

            <!-- デモ状態 (未実装) -->
            <Border Style="{StaticResource SnapwellRowsBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.1*" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border
                        Grid.Row="0"
                        Grid.Column="0"
                        Padding="12,8"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <TextBlock
                            Text="操作"
                            Style="{StaticResource SnapwellRowTitleStyle}"
                            FontSize="12"
                            LineHeight="19.2"
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Foreground="{ThemeResource SnapwellMutedBrush}" />
                    </Border>
                    <Border
