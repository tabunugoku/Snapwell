                                </InlineUIContainer>
                                <Run Text=" " />
                                <InlineUIContainer>
                                    <Border Style="{StaticResource DemoKeyBorderStyle}">
                                        <TextBlock Text="Alt" Style="{StaticResource DemoKeyTextStyle}" />
                                    </Border>
                                </InlineUIContainer>
                                <Run Text=" " />
                                <InlineUIContainer>
                                    <Border Style="{StaticResource DemoKeyBorderStyle}">
                                        <TextBlock Text="Shift" Style="{StaticResource DemoKeyTextStyle}" />
                                    </Border>
                                </InlineUIContainer>
                                <Run Text=" + 矢印" />
                            </Paragraph>
                        </RichTextBlock>
                    </Border>
                    <Border
                        Grid.Row="4"
                        Grid.Column="2"
                        Padding="12,10"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <TextBlock
                            Text=""
                            Style="{StaticResource SnapwellRowTitleStyle}"
                            FontSize="13"
                            LineHeight="20.8"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource SnapwellTextBrush}" />
                    </Border>
                    <Border
                        Grid.Row="5"
                        Grid.Column="0"
                        Padding="12,10"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <TextBlock
                            Text="区画単位で移動"
                            Style="{StaticResource SnapwellRowTitleStyle}"
                            FontSize="13"
                            LineHeight="20.8"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource SnapwellTextBrush}" />
                    </Border>
                    <Border
                        Grid.Row="5"
                        Grid.Column="1"
                        Padding="12,10"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <RichTextBlock FontSize="13" LineHeight="20.8" Foreground="{ThemeResource SnapwellTextBrush}">
                            <Paragraph Margin="0">
                                <InlineUIContainer>
                                    <Border Style="{StaticResource DemoKeyBorderStyle}">
                                        <TextBlock Text="Ctrl" Style="{StaticResource DemoKeyTextStyle}" />
                                    </Border>
                                </InlineUIContainer>
                                <Run Text=" " />
                                <InlineUIContainer>
                                    <Border Style="{StaticResource DemoKeyBorderStyle}">
                                        <TextBlock Text="Alt" Style="{StaticResource DemoKeyTextStyle}" />
                                    </Border>
                                </InlineUIContainer>
                                <Run Text=" " />
                                <InlineUIContainer>
                                    <Border Style="{StaticResource DemoKeyBorderStyle}">
                                        <TextBlock Text="Win" Style="{StaticResource DemoKeyTextStyle}" />
                                    </Border>
                                </InlineUIContainer>
                                <Run Text=" + 矢印" />
                            </Paragraph>
                        </RichTextBlock>
                    </Border>
                    <Border
                        Grid.Row="5"
                        Grid.Column="2"
                        Padding="12,10"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <Border
                            Background="{ThemeResource SnapwellRedBackgroundBrush}"
                            CornerRadius="9999"
                            Padding="8,1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                            <TextBlock
                                Text="重複"
                                FontSize="10.5"
                                FontWeight="SemiBold"
                                CharacterSpacing="50"
                                LineHeight="16.8"
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource SnapwellRedTextBrush}" />
                        </Border>
                    </Border>
                    <Border
                        Grid.Row="6"
                        Grid.Column="0"
                        Padding="12,10"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <TextBlock
                            Text="現在のモニターを整列"
                            Style="{StaticResource SnapwellRowTitleStyle}"
                            FontSize="13"
                            LineHeight="20.8"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource SnapwellTextBrush}" />
                    </Border>
                    <Border
                        Grid.Row="6"
                        Grid.Column="1"
                        Padding="12,10"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <RichTextBlock FontSize="13" LineHeight="20.8" Foreground="{ThemeResource SnapwellTextBrush}">
                            <Paragraph Margin="0">
                                <InlineUIContainer>
                                    <Border Style="{StaticResource DemoKeyBorderStyle}">
                                        <TextBlock Text="Ctrl" Style="{StaticResource DemoKeyTextStyle}" />
                                    </Border>
                                </InlineUIContainer>
                                <Run Text=" " />
                                <InlineUIContainer>
                                    <Border Style="{StaticResource DemoKeyBorderStyle}">
                                        <TextBlock Text="Alt" Style="{StaticResource DemoKeyTextStyle}" />
                                    </Border>
                                </InlineUIContainer>
                                <Run Text=" " />
                                <InlineUIContainer>
                                    <Border Style="{StaticResource DemoKeyBorderStyle}">
                                        <TextBlock Text="A" Style="{StaticResource DemoKeyTextStyle}" />
                                    </Border>
                                </InlineUIContainer>
                            </Paragraph>
                        </RichTextBlock>
                    </Border>
                    <Border
                        Grid.Row="6"
                        Grid.Column="2"
                        Padding="12,10"
