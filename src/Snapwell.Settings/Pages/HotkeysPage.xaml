                            Style="{StaticResource SnapwellRowTitleStyle}"
                            FontSize="12"
                            LineHeight="19.2"
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Foreground="{ThemeResource SnapwellMutedBrush}" />
                    </Border>
                    <Border
                        Grid.Row="0"
                        Grid.Column="2"
                        Padding="12,8"
                        BorderThickness="0,0,0,1"
