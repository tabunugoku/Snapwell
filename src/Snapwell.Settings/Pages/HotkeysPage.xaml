                            FontSize="12"
                            LineHeight="19.2"
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Foreground="{ThemeResource SnapwellMutedBrush}" />
                    </Border>
                    <Border
                        Grid.Row="1"
                        Grid.Column="0"
                        Padding="12,10"
                        BorderThickness="0,0,0,1"
