<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Snapwell.Settings.Pages.BackupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Snapwell.Settings.Controls">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32,28,32,40" HorizontalAlignment="Stretch">
            <TextBlock Text="同期とバックアップ" Style="{StaticResource SnapwellPageTitleStyle}" TextWrapping="Wrap" />
            <TextBlock Text="ホットキー・分割案・間隔・操作感・ルールを、ほかの PC と共有できます。モニター構成ごとの配置は、この PC にだけ保存します。"
                       Style="{StaticResource SnapwellLeadTextStyle}" />
            <TextBlock Text="Snapwell 自体には、設定をクラウドへ送る機能はありません。OneDrive や Dropbox など、お使いのファイル同期サービスが、同期フォルダーの中のファイルをほかの PC へ運びます。そのサービスの同期が終わるまで、ほかの PC には反映されません。"
                       Style="{StaticResource SnapwellHintTextStyle}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <InfoBar x:Name="TransferNotice" IsClosable="True" />

            <Border Style="{StaticResource SnapwellRowsBorderStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="同期フォルダー" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock x:Name="SyncFolderText" Text="未設定" TextWrapping="Wrap"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}"
                                       FontFamily="{StaticResource SnapwellMonoFontFamily}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="SyncFolderButton" Content="変更" IsEnabled="False"
                                    Style="{StaticResource SnapwellButtonStyle}" />
                            <ToggleSwitch x:Name="SyncToggle" IsEnabled="False"
                                          Style="{StaticResource SnapwellToggleSwitchStyle}"
                                          AutomationProperties.Name="同期" />
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="最後に同期した時刻" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock x:Name="LastSyncText" Text="まだ同期していません" TextWrapping="Wrap"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <Button x:Name="SyncNowButton" Grid.Column="1" Content="今すぐ同期" IsEnabled="False"
                                VerticalAlignment="Center" Style="{StaticResource SnapwellButtonStyle}" />
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock Text="ファイル" Style="{StaticResource SnapwellGroupTitleStyle}" />
            <Border Style="{StaticResource SnapwellRowsBorderStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="書き出す" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock Text="設定を 1 つの JSON ファイルに保存します"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <Button x:Name="ExportButton" Grid.Column="1" Content="書き出す" IsEnabled="False"
                                VerticalAlignment="Center" Style="{StaticResource SnapwellButtonStyle}" />
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="取り込む" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock Text="取り込む前に、今の設定との違いを表示します。全部を置き換えるか、一部だけ取り込むかを選べます"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <Button x:Name="ImportButton" Grid.Column="1" Content="取り込む" IsEnabled="False"
                                VerticalAlignment="Center" Style="{StaticResource SnapwellButtonStyle}" />
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock Text="取り込んだあと、画面下の「保存」で確定します。"
                       Style="{StaticResource SnapwellHintTextStyle}" Margin="0,10,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
