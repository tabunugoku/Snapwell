<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Snapwell.Settings.Pages.BackupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="28,16,28,32" Spacing="24" MaxWidth="820">
            <TextBlock Text="同期とバックアップ" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
            <TextBlock Text="ホットキー・分割案・間隔・操作感を、ほかの PC と共有できます。設定を 1 つの JSON ファイルに書き出します。"
                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <InfoBar x:Name="TransferNotice" IsClosable="True" />
            <StackPanel Spacing="10">
                <TextBlock Text="書き出す" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="いま画面で編集中の設定を、1 つの JSON ファイルに保存します。" TextWrapping="Wrap" />
                <Button x:Name="ExportButton" Content="書き出す" IsEnabled="False" />
            </StackPanel>
            <StackPanel Spacing="10">
                <TextBlock Text="取り込む" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="取り込む前に、今の設定との違いを表示します。全部を置き換えるか、一部だけ取り込むかを選べます。"
                           TextWrapping="Wrap" />
                <Button x:Name="ImportButton" Content="取り込む" IsEnabled="False" />
                <TextBlock Text="取り込んだあと、画面下の「保存」で確定します。"
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
