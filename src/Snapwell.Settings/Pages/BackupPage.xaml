<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Snapwell.Settings.Pages.BackupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:l="using:Snapwell.Settings.Localization"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Snapwell.Settings.Controls">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32,28,32,40" HorizontalAlignment="Stretch">
            <TextBlock l:Loc.Uid="Backup_Title" Style="{StaticResource SnapwellPageTitleStyle}" TextWrapping="Wrap" />
            <TextBlock l:Loc.Uid="Backup_Lead" Style="{StaticResource SnapwellLeadTextStyle}" />
            <TextBlock l:Loc.Uid="Backup_CloudHint" Style="{StaticResource SnapwellHintTextStyle}"
                       TextWrapping="Wrap" Margin="0,0,0,12" />
            <InfoBar x:Name="TransferNotice" IsClosable="True" />

            <Border Style="{StaticResource SnapwellRowsBorderStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock l:Loc.Uid="Backup_FolderTitle" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock l:Loc.Uid="Backup_SyncFolderText" x:Name="SyncFolderText" TextWrapping="Wrap"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}"
                                       FontFamily="{StaticResource SnapwellMonoFontFamily}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button l:Loc.Uid="Backup_SyncFolderButton" x:Name="SyncFolderButton" IsEnabled="False"
                                    Style="{StaticResource SnapwellActionButtonStyle}" />
                            <ToggleSwitch l:Loc.Uid="Backup_SyncToggle" x:Name="SyncToggle" IsEnabled="False"
                                          Style="{StaticResource SnapwellToggleSwitchStyle}" />
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock l:Loc.Uid="Backup_LastSyncTitle"
                                       Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock l:Loc.Uid="Backup_LastSyncText" x:Name="LastSyncText" TextWrapping="Wrap"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <Button l:Loc.Uid="Backup_SyncNowButton" x:Name="SyncNowButton" Grid.Column="1"
                                IsEnabled="False" VerticalAlignment="Center"
                                Style="{StaticResource SnapwellActionButtonStyle}" />
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock l:Loc.Uid="Backup_FileTitle" Style="{StaticResource SnapwellGroupTitleStyle}" />
            <Border Style="{StaticResource SnapwellRowsBorderStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock l:Loc.Uid="Backup_ExportTitle" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock l:Loc.Uid="Backup_ExportDescription"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <Button l:Loc.Uid="Backup_ExportButton" x:Name="ExportButton" Grid.Column="1"
                                IsEnabled="False" VerticalAlignment="Center"
                                Style="{StaticResource SnapwellActionButtonStyle}" />
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock l:Loc.Uid="Backup_ImportTitle" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock l:Loc.Uid="Backup_ImportDescription"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <Button l:Loc.Uid="Backup_ImportButton" x:Name="ImportButton" Grid.Column="1"
                                IsEnabled="False" VerticalAlignment="Center"
                                Style="{StaticResource SnapwellActionButtonStyle}" />
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock l:Loc.Uid="Backup_SaveHint" Style="{StaticResource SnapwellHintTextStyle}" Margin="0,10,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
