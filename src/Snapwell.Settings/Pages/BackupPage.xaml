<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Snapwell.Settings.Pages.BackupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32,16,32,40" MaxWidth="820" HorizontalAlignment="Stretch">
            <TextBlock Text="同期とバックアップ" Style="{StaticResource SnapwellPageTitleStyle}" TextWrapping="Wrap" />
            <TextBlock Text="ホットキー・分割案・間隔・操作感を、ほかの PC と共有できます。設定を 1 つの JSON ファイルに書き出します。"
                       Style="{StaticResource SnapwellLeadTextStyle}" />
            <InfoBar x:Name="TransferNotice" IsClosable="True" Margin="0,0,0,12" />
            <TextBlock Text="ファイル" Style="{StaticResource SnapwellGroupTitleStyle}" Margin="0,0,0,8" />
            <Border Style="{StaticResource SnapwellRowsBorderStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="書き出す" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock Text="いま画面で編集中の設定を、1 つの JSON ファイルに保存します"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <Button x:Name="ExportButton" Grid.Column="1" Content="書き出す" IsEnabled="False"
                                VerticalAlignment="Center" Style="{StaticResource SnapwellButtonStyle}" />
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="取り込む" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock Text="取り込む前に、今の設定との違いを表示します。全部を置き換えるか、一部だけ取り込むかを選べます"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <Button x:Name="ImportButton" Grid.Column="1" Content="取り込む" IsEnabled="False"
                                VerticalAlignment="Center" Style="{StaticResource SnapwellButtonStyle}" />
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock Text="取り込んだあと、画面下の「保存」で確定します。"
                       Style="{StaticResource SnapwellHintTextStyle}" Margin="0,10,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
