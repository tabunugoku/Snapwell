<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Snapwell.Settings.Pages.BackupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <Style x:Key="DemoSwitchStyle" TargetType="ToggleSwitch"
               BasedOn="{StaticResource SnapwellDemoSwitchStyle}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleSwitch">
                        <Grid Width="40" Height="20" Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="ToggleStates">
                                    <VisualState x:Name="Off" />
                                    <VisualState x:Name="On">
                                        <VisualState.Setters>
                                            <Setter
                                                Target="SwitchTrack.Background"
                                                Value="{ThemeResource SnapwellInkBrush}" />
                                            <Setter
                                                Target="SwitchTrack.BorderBrush"
                                                Value="{ThemeResource SnapwellInkBrush}" />
                                            <Setter Target="SwitchTrack.BorderThickness" Value="0" />
                                            <Setter
                                                Target="SwitchKnob.Fill"
                                                Value="{ThemeResource SnapwellInkTextBrush}" />
                                            <Setter Target="SwitchKnob.Margin" Value="23,0,0,0" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border
                                x:Name="SwitchTrack"
                                CornerRadius="9999"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource SnapwellMutedBrush}" />
                            <Ellipse
                                x:Name="SwitchKnob"
                                Width="12"
                                Height="12"
                                Margin="3,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource SnapwellMutedBrush}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32,28,32,40" HorizontalAlignment="Stretch">
            <TextBlock Text="同期とバックアップ" Style="{StaticResource SnapwellPageTitleStyle}" TextWrapping="Wrap" />
            <TextBlock Text="ホットキー・分割案・間隔・操作感・ルールを、ほかの PC と共有できます。モニター構成ごとの配置は、この PC にだけ保存します。"
                       Style="{StaticResource SnapwellLeadTextStyle}" />
            <InfoBar x:Name="TransferNotice" IsClosable="True" />

            <!-- デモ状態 (未実装) -->
            <Border Style="{StaticResource SnapwellRowsBorderStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <Grid ColumnSpacing="6" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="同期フォルダ" Style="{StaticResource SnapwellRowTitleStyle}" />
                                <Border Grid.Column="1" Style="{StaticResource SnapwellPendingTagStyle}">
                                    <TextBlock Text="準備中" Style="{StaticResource SnapwellPendingTagTextStyle}" />
                                </Border>
                            </Grid>
                            <TextBlock
                                Text="—"
                                Style="{StaticResource SnapwellRowDescriptionStyle}"
                                FontFamily="{StaticResource SnapwellMonoFontFamily}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button IsEnabled="False" Content="変更" Style="{StaticResource SnapwellDemoButtonStyle}" />
                            <ToggleSwitch IsEnabled="False"
                                Style="{StaticResource DemoSwitchStyle}"
                                IsOn="False"
                                AutomationProperties.Name="同期" />
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <Grid ColumnSpacing="6" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="最後に同期した時刻" Style="{StaticResource SnapwellRowTitleStyle}" />
                                <Border Grid.Column="1" Style="{StaticResource SnapwellPendingTagStyle}">
                                    <TextBlock Text="準備中" Style="{StaticResource SnapwellPendingTagTextStyle}" />
                                </Border>
                            </Grid>
                            <TextBlock
                                Text="—"
                                Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button IsEnabled="False" Content="今すぐ同期" Style="{StaticResource SnapwellDemoButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <!-- デモ状態 (未実装) ここまで -->
            <TextBlock Text="ファイル" Style="{StaticResource SnapwellGroupTitleStyle}" />
            <Border Style="{StaticResource SnapwellRowsBorderStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="書き出す" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock Text="設定を 1 つの JSON ファイルに保存します"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <Button x:Name="ExportButton" Grid.Column="1" Content="書き出す" IsEnabled="False"
                                VerticalAlignment="Center" Style="{StaticResource SnapwellButtonStyle}" />
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="取り込む" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock Text="取り込む前に、今の設定との違いを表示します。全部を置き換えるか、一部だけ取り込むかを選べます"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <Button x:Name="ImportButton" Grid.Column="1" Content="取り込む" IsEnabled="False"
                                VerticalAlignment="Center" Style="{StaticResource SnapwellButtonStyle}" />
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock Text="取り込んだあと、画面下の「保存」で確定します。"
                       Style="{StaticResource SnapwellHintTextStyle}" Margin="0,10,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
