<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Snapwell.Settings.Pages.RulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:l="using:Snapwell.Settings.Localization"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <Style x:Key="RuleRowStyle" TargetType="Grid" BasedOn="{StaticResource SnapwellRowGridStyle}">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="ColumnSpacing" Value="12" />
            <Setter Property="BorderBrush" Value="{ThemeResource SnapwellBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style x:Key="RuleConditionStyle" TargetType="Button" BasedOn="{StaticResource SnapwellButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="0,4" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
    </Page.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32,28,32,40">
            <TextBlock l:Loc.Uid="Rules_Title" Style="{StaticResource SnapwellPageTitleStyle}" />
            <TextBlock l:Loc.Uid="Rules_Lead" Style="{StaticResource SnapwellLeadTextStyle}" />
            <Border Style="{StaticResource SnapwellRowsBorderStyle}">
                <StackPanel>
                    <Grid Padding="12,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="132" />
                            <ColumnDefinition Width="124" />
                        </Grid.ColumnDefinitions>
                        <TextBlock l:Loc.Uid="Rules_EnabledColumn" Style="{StaticResource SnapwellHintTextStyle}" />
                        <TextBlock l:Loc.Uid="Rules_ConditionColumn" Grid.Column="1"
                                   Style="{StaticResource SnapwellHintTextStyle}" />
                        <TextBlock l:Loc.Uid="Rules_PlacementColumn" Grid.Column="2"
                                   Style="{StaticResource SnapwellHintTextStyle}" />
                        <TextBlock l:Loc.Uid="Rules_CornerColumn" Grid.Column="3"
                                   Style="{StaticResource SnapwellHintTextStyle}" />
                    </Grid>
                    <StackPanel x:Name="RuleRows" />
                    <TextBlock l:Loc.Uid="Rules_EmptyHint" x:Name="EmptyHint" Margin="12,10"
                               Style="{StaticResource SnapwellHintTextStyle}" />
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                <Button l:Loc.Uid="Rules_AddButton" x:Name="AddButton"
                        Style="{StaticResource SnapwellActionButtonStyle}" Click="Add_Click" />
                <Button l:Loc.Uid="Rules_PickButton" x:Name="PickButton"
                        Style="{StaticResource SnapwellActionButtonStyle}" Click="Pick_Click" />
            </StackPanel>
            <TextBlock l:Loc.Uid="Rules_LimitHint" x:Name="LimitHint" Margin="0,8,0,0" Visibility="Collapsed"
                       Style="{StaticResource SnapwellHintTextStyle}" />
            <Expander l:Loc.Uid="Rules_Exclusions" IsExpanded="False" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left" Margin="0,14,0,0">
                <StackPanel Spacing="6">
                    <TextBlock l:Loc.Uid="Rules_ExclusionHint" Style="{StaticResource SnapwellHintTextStyle}" />
                    <TextBlock l:Loc.Uid="Rules_HiddenExclusion" Style="{StaticResource SnapwellHintTextStyle}" />
                    <TextBlock l:Loc.Uid="Rules_OwnExclusion" Style="{StaticResource SnapwellHintTextStyle}" />
                    <TextBlock l:Loc.Uid="Rules_ShellExclusion" Style="{StaticResource SnapwellHintTextStyle}" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
