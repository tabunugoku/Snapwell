<?xml version="1.0" encoding="utf-8"?>
<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Snapwell.Settings.Controls"
    x:Class="Snapwell.Settings.Pages.RulesPage">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32,28,32,40" HorizontalAlignment="Stretch">
            <!-- デモ状態 (未実装) -->
            <Grid ColumnSpacing="6" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="アプリごとのルール" Style="{StaticResource SnapwellPageTitleStyle}" />
                <Border Grid.Column="1" Style="{StaticResource SnapwellTagPendingStyle}">
                    <TextBlock Text="準備中" Style="{StaticResource SnapwellTagPendingTextStyle}" />
                </Border>
            </Grid>
            <TextBlock Text="特定のアプリを対象から外したり、位置だけを動かすようにしたりできます。" Style="{StaticResource SnapwellLeadTextStyle}" />
            <Border Style="{StaticResource SnapwellRowsBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.5*" />
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="2.1*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border
                        Grid.Row="0"
                        Grid.Column="0"
                        Padding="12,8"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <TextBlock
                            Text="条件"
                            FontSize="12"
                            LineHeight="19.2"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Foreground="{ThemeResource SnapwellMutedBrush}" />
                    </Border>
                    <Border
                        Grid.Row="0"
                        Grid.Column="1"
                        Padding="12,8"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <TextBlock
                            Text="種類"
                            FontSize="12"
                            LineHeight="19.2"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Foreground="{ThemeResource SnapwellMutedBrush}" />
                    </Border>
                    <Border
                        Grid.Row="0"
                        Grid.Column="2"
                        Padding="12,8"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <TextBlock
                            Text="扱い"
                            FontSize="12"
                            LineHeight="19.2"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Foreground="{ThemeResource SnapwellMutedBrush}" />
                    </Border>
                    <Border
                        Grid.Row="1"
                        Grid.Column="0"
                        Padding="12,10"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <TextBlock
                            Text="game-launcher.exe"
                            FontSize="13"
                            LineHeight="20.8"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource SnapwellTextBrush}"
                            FontFamily="{StaticResource SnapwellMonoFontFamily}" />
                    </Border>
                    <Border
                        Grid.Row="1"
                        Grid.Column="1"
                        Padding="12,10"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <TextBlock
                            Text="プロセス名"
                            FontSize="13"
                            LineHeight="20.8"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource SnapwellTextBrush}" />
                    </Border>
                    <Border
                        Grid.Row="1"
                        Grid.Column="2"
                        Padding="12,10"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <Border Style="{StaticResource SnapwellTagRedStyle}">
                            <TextBlock Text="対象外" Style="{StaticResource SnapwellTagRedTextStyle}" />
                        </Border>
                    </Border>
                    <Border
                        Grid.Row="2"
                        Grid.Column="0"
                        Padding="12,10"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <TextBlock
                            Text="^ピクチャー イン ピクチャー$"
                            FontSize="13"
                            LineHeight="20.8"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource SnapwellTextBrush}"
                            FontFamily="{StaticResource SnapwellMonoFontFamily}" />
                    </Border>
                    <Border
                        Grid.Row="2"
                        Grid.Column="1"
                        Padding="12,10"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <TextBlock
                            Text="タイトル（正規表現）"
                            FontSize="13"
                            LineHeight="20.8"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource SnapwellTextBrush}" />
                    </Border>
                    <Border
                        Grid.Row="2"
                        Grid.Column="2"
                        Padding="12,10"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <Border Style="{StaticResource SnapwellTagYellowStyle}">
                            <TextBlock Text="位置だけ" Style="{StaticResource SnapwellTagYellowTextStyle}" />
                        </Border>
                    </Border>
                    <Border
                        Grid.Row="3"
                        Grid.Column="0"
                        Padding="12,10"
                        BorderThickness="0,0,0,0"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <TextBlock
                            Text="Shell_TrayWnd"
                            FontSize="13"
                            LineHeight="20.8"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource SnapwellTextBrush}"
                            FontFamily="{StaticResource SnapwellMonoFontFamily}" />
                    </Border>
                    <Border
                        Grid.Row="3"
                        Grid.Column="1"
                        Padding="12,10"
                        BorderThickness="0,0,0,0"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <TextBlock
                            Text="ウィンドウ クラス"
                            FontSize="13"
                            LineHeight="20.8"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource SnapwellTextBrush}" />
                    </Border>
                    <Border
                        Grid.Row="3"
                        Grid.Column="2"
                        Padding="12,10"
                        BorderThickness="0,0,0,0"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}">
                        <Border Style="{StaticResource SnapwellTagRedStyle}">
                            <TextBlock Text="対象外（既定）" Style="{StaticResource SnapwellTagRedTextStyle}" />
                        </Border>
                    </Border>
                </Grid>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                <Button IsEnabled="False" Content="ルールを追加" Style="{StaticResource SnapwellDemoButtonStyle}" />
                <Button IsEnabled="False" Content="ウィンドウを選んで追加" Style="{StaticResource SnapwellDemoButtonStyle}" />
            </StackPanel>
            <!-- デモ状態 (未実装) ここまで -->
        </StackPanel>
    </ScrollViewer>
</Page>
