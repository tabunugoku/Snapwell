<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Snapwell.Settings.Pages.RulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <Style x:Key="RuleRowStyle" TargetType="Grid" BasedOn="{StaticResource SnapwellRowGridStyle}">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="ColumnSpacing" Value="12" />
            <Setter Property="BorderBrush" Value="{ThemeResource SnapwellBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style x:Key="RuleConditionStyle" TargetType="Button" BasedOn="{StaticResource SnapwellButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="0,4" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
    </Page.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32,28,32,40">
            <TextBlock Text="アプリごとのルール" Style="{StaticResource SnapwellPageTitleStyle}" />
            <TextBlock
                Text="特定のアプリのウィンドウについて、対象から外す・位置だけを動かす・ウィンドウの角を変える、といった例外を決められます。上のルールから順に調べ、「配置」と「角」はそれぞれ、指定のある最初のルールを使います。"
                Style="{StaticResource SnapwellLeadTextStyle}" />
            <Border Style="{StaticResource SnapwellRowsBorderStyle}">
                <StackPanel>
                    <Grid Padding="12,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="132" />
                            <ColumnDefinition Width="124" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="有効" Style="{StaticResource SnapwellHintTextStyle}" />
                        <TextBlock Grid.Column="1" Text="条件" Style="{StaticResource SnapwellHintTextStyle}" />
                        <TextBlock Grid.Column="2" Text="配置" Style="{StaticResource SnapwellHintTextStyle}" />
                        <TextBlock Grid.Column="3" Text="角" Style="{StaticResource SnapwellHintTextStyle}" />
                    </Grid>
                    <StackPanel x:Name="RuleRows" />
                    <TextBlock x:Name="EmptyHint" Margin="12,10" Style="{StaticResource SnapwellHintTextStyle}"
                               Text="ルールはまだありません。「ルールを追加」から作れます。" />
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                <Button x:Name="AddButton" Content="ルールを追加" AutomationProperties.Name="ルールを追加"
                        Style="{StaticResource SnapwellActionButtonStyle}" Click="Add_Click" />
                <Button x:Name="PickButton" Content="ウィンドウを選んで追加"
                        AutomationProperties.Name="ウィンドウを選んで追加"
                        Style="{StaticResource SnapwellActionButtonStyle}" Click="Pick_Click" />
            </StackPanel>
            <TextBlock x:Name="LimitHint" Margin="0,8,0,0" Visibility="Collapsed"
                       Text="ルールは 200 件までです。追加するには、先にルールを削除してください。"
                       Style="{StaticResource SnapwellHintTextStyle}" />
            <Expander Header="Snapwell が最初から対象外にしているもの" IsExpanded="False"
                      AutomationProperties.Name="Snapwell が最初から対象外にしているもの"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,14,0,0">
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource SnapwellHintTextStyle}"
                               Text="次のウィンドウは、ルールでは変えられません（「強制的に対象」にしても対象になりません）。" />
                    <TextBlock Style="{StaticResource SnapwellHintTextStyle}"
                               Text="• 表示されていない・最小化されている・別の仮想デスクトップにあるなど、システムに隠された（クローク中の）ウィンドウ" />
                    <TextBlock Style="{StaticResource SnapwellHintTextStyle}" Text="• Snapwell 自身のウィンドウ、子ウィンドウ" />
                    <TextBlock Style="{StaticResource SnapwellHintTextStyle}"
                               Text="• デスクトップ、タスクバー、スタート メニューなどのシェル、通知領域の隠れたアイコンの一覧" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
