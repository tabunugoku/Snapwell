<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Snapwell.Settings.Pages.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <Style x:Key="DemoSwitchStyle" TargetType="ToggleSwitch"
               BasedOn="{StaticResource SnapwellDemoSwitchStyle}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleSwitch">
                        <Grid x:Name="SwitchVisualRoot" Width="40" Height="20" Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver" />
                                    <VisualState x:Name="Pressed" />
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="SwitchVisualRoot.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="ToggleStates">
                                    <VisualState x:Name="Off" />
                                    <VisualState x:Name="On">
                                        <VisualState.Setters>
                                            <Setter
                                                Target="SwitchTrack.Background"
                                                Value="{ThemeResource SnapwellInkBrush}" />
                                            <Setter
                                                Target="SwitchTrack.BorderBrush"
                                                Value="{ThemeResource SnapwellInkBrush}" />
                                            <Setter
                                                Target="SwitchKnob.Fill"
                                                Value="{ThemeResource SnapwellInkTextBrush}" />
                                            <Setter Target="SwitchKnob.Margin" Value="23,0,0,0" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border
                                x:Name="SwitchTrack"
                                CornerRadius="9999"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource SnapwellMutedBrush}" />
                            <Ellipse
                                x:Name="SwitchKnob"
                                Width="12"
                                Height="12"
                                Margin="3,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource SnapwellMutedBrush}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DemoSelectStyle" TargetType="ComboBox"
               BasedOn="{StaticResource SnapwellDemoSelectStyle}">
            <Setter Property="FontFamily" Value="{StaticResource SnapwellUiFontFamily}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{ThemeResource SnapwellSurfaceBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource SnapwellTextBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SnapwellBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32,28,32,40" HorizontalAlignment="Stretch">
            <TextBlock Text="一般" Style="{StaticResource SnapwellPageTitleStyle}" />
            <TextBlock Text="起動と動作の基本です。" Style="{StaticResource SnapwellLeadTextStyle}" />
            <InfoBar x:Name="ErrorNotice" Severity="Error" IsClosable="True" />
            <Border Style="{StaticResource SnapwellRowsBorderStyle}">
                <StackPanel>
                    <!-- デモ状態 (未実装) -->
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <Grid ColumnSpacing="6" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Snapwell を有効にする" Style="{StaticResource SnapwellRowTitleStyle}" />
                                <Border Grid.Column="1" Style="{StaticResource SnapwellPendingTagStyle}">
                                    <TextBlock Text="準備中" Style="{StaticResource SnapwellPendingTagTextStyle}" />
                                </Border>
                            </Grid>
                            <TextBlock Text="オフにすると、標準のスナップ機能を元の状態に戻します。トレイメニューから操作できます" Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ToggleSwitch IsEnabled="False" Style="{StaticResource DemoSwitchStyle}" IsOn="True" AutomationProperties.Name="有効" />
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <!-- デモ状態 (未実装) ここまで -->
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="サインイン時に起動する" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock Text="スタートアップに登録します"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                            <TextBlock x:Name="RegistrationStatus" Visibility="Collapsed"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}"
                                       Foreground="{ThemeResource SnapwellYellowTextBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="AutoStartToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"
                                      VerticalAlignment="Center" AutomationProperties.Name="サインイン時に起動する"
                                      Toggled="AutoStart_Toggled" />
                    </Grid>
                    <!-- デモ状態 (未実装) -->
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <Grid ColumnSpacing="6" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="管理者として起動する" Style="{StaticResource SnapwellRowTitleStyle}" />
                                <Border Grid.Column="1" Style="{StaticResource SnapwellPendingTagStyle}">
                                    <TextBlock Text="準備中" Style="{StaticResource SnapwellPendingTagTextStyle}" />
                                </Border>
                            </Grid>
                            <TextBlock
                                Text="管理者権限で動くアプリのウィンドウも動かせます。タスク スケジューラに登録します"
                                Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ToggleSwitch IsEnabled="False"
                                Style="{StaticResource DemoSwitchStyle}"
                                IsOn="False"
                                AutomationProperties.Name="管理者として起動" />
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <Grid ColumnSpacing="6" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="言語" Style="{StaticResource SnapwellRowTitleStyle}" />
                                <Border Grid.Column="1" Style="{StaticResource SnapwellPendingTagStyle}">
                                    <TextBlock Text="準備中" Style="{StaticResource SnapwellPendingTagTextStyle}" />
                                </Border>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ComboBox IsEnabled="False"
                                Width="160"
                                Style="{StaticResource DemoSelectStyle}"
                                SelectedIndex="0"
                                AutomationProperties.Name="日本語">
                                <ComboBoxItem Content="日本語" />
                                <ComboBoxItem Content="English" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <!-- デモ状態 (未実装) ここまで -->
                </StackPanel>
            </Border>

            <!-- デモ状態 (未実装) -->
            <TextBlock Text="対象のウィンドウ" Style="{StaticResource SnapwellGroupTitleStyle}" />
            <Border Style="{StaticResource SnapwellRowsBorderStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <Grid ColumnSpacing="6" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="サイズ固定のウィンドウも動かす" Style="{StaticResource SnapwellRowTitleStyle}" />
                                <Border Grid.Column="1" Style="{StaticResource SnapwellPendingTagStyle}">
                                    <TextBlock Text="準備中" Style="{StaticResource SnapwellPendingTagTextStyle}" />
                                </Border>
                            </Grid>
                            <TextBlock
                                Text="サイズは変えず、区画の中で位置だけを合わせます"
                                Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ToggleSwitch IsEnabled="False"
                                Style="{StaticResource DemoSwitchStyle}"
                                IsOn="True"
                                AutomationProperties.Name="サイズ固定" />
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <Grid ColumnSpacing="6" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ポップアップとフライアウトも動かす" Style="{StaticResource SnapwellRowTitleStyle}" />
                                <Border Grid.Column="1" Style="{StaticResource SnapwellPendingTagStyle}">
                                    <TextBlock Text="準備中" Style="{StaticResource SnapwellPendingTagTextStyle}" />
                                </Border>
                            </Grid>
                            <TextBlock
                                Text="タスクバーから開く小さなウィンドウなど。フォーカスを奪わずに移動します"
                                Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ToggleSwitch IsEnabled="False"
                                Style="{StaticResource DemoSwitchStyle}"
                                IsOn="True"
                                AutomationProperties.Name="ポップアップ" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <!-- デモ状態 (未実装) ここまで -->
            <TextBlock Text="タイトルバーの長押し" Style="{StaticResource SnapwellGroupTitleStyle}" />
            <Border Style="{StaticResource SnapwellRowsBorderStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="長押しの時間 (ms)" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock Text="150〜2000 ms で指定できます" Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <NumberBox x:Name="LongPressMillisecondsBox" Grid.Column="1" Width="140"
                                   VerticalAlignment="Center" Minimum="150" Maximum="2000"
                                   SmallChange="50" LargeChange="100" SpinButtonPlacementMode="Compact"
                                   AutomationProperties.Name="長押しの時間 (ms)"
                                   ValueChanged="LongPressMilliseconds_ValueChanged"
                                   ValidationMode="InvalidInputOverwritten" />
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="長押し中に動いてよい距離 (px)" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock Text="2〜32 px で指定できます。距離はモニターの DPI に合わせて換算されます"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <NumberBox x:Name="LongPressDistanceBox" Grid.Column="1" Width="140"
                                   VerticalAlignment="Center" Minimum="2" Maximum="32"
                                   SmallChange="1" LargeChange="5" SpinButtonPlacementMode="Compact"
                                   AutomationProperties.Name="長押し中に動いてよい距離 (px)"
                                   ValueChanged="LongPressDistance_ValueChanged"
                                   ValidationMode="InvalidInputOverwritten" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
