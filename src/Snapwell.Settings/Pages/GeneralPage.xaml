<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Snapwell.Settings.Pages.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Snapwell.Settings.Localization"
    xmlns:controls="using:Snapwell.Settings.Controls">
    <Page.Resources>
        <Style x:Key="DemoSwitchStyle" TargetType="ToggleSwitch"
               BasedOn="{StaticResource SnapwellDemoSwitchStyle}" />
        <Style x:Key="DemoSelectStyle" TargetType="ComboBox"
               BasedOn="{StaticResource SnapwellDemoSelectStyle}">
            <Setter Property="FontFamily" Value="{StaticResource SnapwellUiFontFamily}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{ThemeResource SnapwellSurfaceBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource SnapwellTextBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SnapwellBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32,28,32,40" HorizontalAlignment="Stretch">
            <TextBlock l:Loc.Uid="General_Title" Style="{StaticResource SnapwellPageTitleStyle}" />
            <TextBlock l:Loc.Uid="General_Lead" Style="{StaticResource SnapwellLeadTextStyle}" />
            <InfoBar x:Name="ErrorNotice" Severity="Error" IsClosable="True" />
            <Border Style="{StaticResource SnapwellRowsBorderStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock l:Loc.Uid="General_EnabledTitle" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock l:Loc.Uid="General_EnabledDescription" Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="EnabledToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"
                                      Style="{StaticResource SnapwellToggleSwitchStyle}"
                                      VerticalAlignment="Center" l:Loc.Uid="General_EnabledToggle"
                                      Toggled="Enabled_Toggled" />
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock l:Loc.Uid="General_AutoStartTitle" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock l:Loc.Uid="General_AutoStartDescription"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                            <TextBlock x:Name="RegistrationStatus" Visibility="Collapsed"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}"
                                       Foreground="{ThemeResource SnapwellYellowTextBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="AutoStartToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"
                                      Style="{StaticResource SnapwellToggleSwitchStyle}"
                                      VerticalAlignment="Center" l:Loc.Uid="General_AutoStartToggle"
                                      Toggled="AutoStart_Toggled" />
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock l:Loc.Uid="General_AdminStartTitle" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock
                                l:Loc.Uid="General_AdminStartDescription"
                                Style="{StaticResource SnapwellRowDescriptionStyle}" />
                            <TextBlock x:Name="AdminStartStatus" Visibility="Collapsed"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}"
                                       Foreground="{ThemeResource SnapwellYellowTextBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="AdminStartToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"
                                      Style="{StaticResource SnapwellToggleSwitchStyle}"
                                      VerticalAlignment="Center" l:Loc.Uid="General_AdminStartToggle"
                                      Toggled="AdminStart_Toggled" />
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock l:Loc.Uid="General_LanguageTitle" Style="{StaticResource SnapwellRowTitleStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ComboBox x:Name="LanguageSelect" Width="200"
                                Style="{StaticResource DemoSelectStyle}"
                                l:Loc.Uid="General_LanguageSelect"
                                SelectionChanged="Language_SelectionChanged">
                                <ComboBoxItem Tag="auto" l:Loc.Uid="General_LanguageAuto" />
                                <ComboBoxItem Tag="ja" l:Loc.Uid="General_LanguageJapanese" />
                                <ComboBoxItem Tag="en" l:Loc.Uid="General_LanguageEnglish" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock l:Loc.Uid="General_WindowsTitle" Style="{StaticResource SnapwellGroupTitleStyle}" />
            <Border Style="{StaticResource SnapwellRowsBorderStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock l:Loc.Uid="General_MoveFixedSizeTitle" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock
                                l:Loc.Uid="General_MoveFixedSizeDescription"
                                Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="MoveFixedSizeToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"
                                      Style="{StaticResource SnapwellToggleSwitchStyle}"
                                      VerticalAlignment="Center" l:Loc.Uid="General_MoveFixedSizeToggle"
                                      Toggled="MoveFixedSize_Toggled" />
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock l:Loc.Uid="General_MovePopupTitle" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock
                                l:Loc.Uid="General_MovePopupDescription"
                                Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="MovePopupToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"
                                      Style="{StaticResource SnapwellToggleSwitchStyle}"
                                      VerticalAlignment="Center" l:Loc.Uid="General_MovePopupToggle"
                                      Toggled="MovePopup_Toggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock l:Loc.Uid="General_UpdatesTitle" Style="{StaticResource SnapwellGroupTitleStyle}" />
            <Border Style="{StaticResource SnapwellRowsBorderStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SnapwellRowGridStyle}" ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock l:Loc.Uid="General_UpdateAutoTitle" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock l:Loc.Uid="General_UpdateAutoDescription" TextWrapping="Wrap"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="UpdateAutoToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"
                                      IsEnabled="False" Style="{StaticResource SnapwellToggleSwitchStyle}"
                                      VerticalAlignment="Center" l:Loc.Uid="General_UpdateAutoToggle"
                                      Toggled="UpdateAuto_Toggled" />
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}" ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock l:Loc.Uid="General_UpdateCheckNowTitle" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock l:Loc.Uid="General_UpdateCheckNowDescription" TextWrapping="Wrap"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                            <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                            <TextBlock x:Name="UpdateLastChecked" TextWrapping="Wrap" Visibility="Collapsed"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                            <TextBlock x:Name="UpdateInstallResult" TextWrapping="Wrap" Visibility="Collapsed"
                                       AutomationProperties.LiveSetting="Polite"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                            <Button x:Name="UpdateReinstallLink" Visibility="Collapsed"
                                    l:Loc.Uid="Update_ReinstallLink" Click="UpdateReinstall_Click" />
                        </StackPanel>
                        <Button x:Name="UpdateCheckNowButton" Grid.Column="1" VerticalAlignment="Center"
                                l:Loc.Uid="General_UpdateCheckNowButton" IsEnabled="False"
                                Click="UpdateCheckNow_Click" />
                    </Grid>
                    <StackPanel x:Name="UpdateOfferPanel">
                        <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                        <StackPanel Padding="20,16" Spacing="10">
                            <TextBlock x:Name="UpdateOfferTitle" TextWrapping="Wrap"
                                       Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock x:Name="UpdateOfferRequired"
                                       TextWrapping="Wrap" Foreground="{ThemeResource SnapwellYellowTextBrush}"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                            <TextBlock x:Name="UpdateOfferSummary" TextWrapping="Wrap"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                            <TextBlock x:Name="UpdateInstallReason" TextWrapping="Wrap" Visibility="Collapsed"
                                       AutomationProperties.LiveSetting="Polite"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                            <VariableSizedWrapGrid Orientation="Horizontal"
                                                   MaximumRowsOrColumns="4">
                                <Button x:Name="UpdateInstallButton" l:Loc.Uid="Update_Install" Margin="0,0,8,8"
                                        Style="{StaticResource AccentButtonStyle}" IsEnabled="False"
                                        Click="UpdateInstall_Click" />
                                <Button x:Name="UpdateBrowserDownloadButton" l:Loc.Uid="General_UpdateDownload" Margin="0,0,8,8"
                                        Click="UpdateDownload_Click" />
                                <Button x:Name="UpdateReleaseNotesButton" l:Loc.Uid="General_UpdateReleaseNotes" Margin="0,0,8,8"
                                        Click="UpdateReleaseNotes_Click" />
                                <Button x:Name="UpdateSkipButton" l:Loc.Uid="General_UpdateSkip" Margin="0,0,0,8"
                                        Click="UpdateSkip_Click" />
                            </VariableSizedWrapGrid>
                            <StackPanel x:Name="UpdateDownloadProgress" Visibility="Collapsed" Spacing="10">
                                <ProgressBar x:Name="UpdateProgressBar" Minimum="0" Maximum="100" Value="0"
                                             IsIndeterminate="False" l:Loc.Uid="Update_Progress" />
                                <TextBlock x:Name="UpdateProgressText" TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Polite"
                                           Style="{StaticResource SnapwellRowDescriptionStyle}" />
                                <Button x:Name="UpdateCancelButton" l:Loc.Uid="Update_Cancel"
                                        HorizontalAlignment="Left" Click="UpdateCancel_Click" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
