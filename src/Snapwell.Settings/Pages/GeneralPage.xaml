<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Snapwell.Settings.Pages.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Snapwell.Settings.Controls">
    <Page.Resources>
        <Style x:Key="DemoSwitchStyle" TargetType="ToggleSwitch"
               BasedOn="{StaticResource SnapwellDemoSwitchStyle}" />
        <Style x:Key="DemoSelectStyle" TargetType="ComboBox"
               BasedOn="{StaticResource SnapwellDemoSelectStyle}">
            <Setter Property="FontFamily" Value="{StaticResource SnapwellUiFontFamily}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{ThemeResource SnapwellSurfaceBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource SnapwellTextBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SnapwellBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32,28,32,40" HorizontalAlignment="Stretch">
            <TextBlock Text="一般" Style="{StaticResource SnapwellPageTitleStyle}" />
            <TextBlock Text="起動と動作の基本です。" Style="{StaticResource SnapwellLeadTextStyle}" />
            <InfoBar x:Name="ErrorNotice" Severity="Error" IsClosable="True" />
            <Border Style="{StaticResource SnapwellRowsBorderStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Snapwell を有効にする" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock Text="オフにすると、標準のスナップ機能を元の状態に戻します。トレイメニューからも操作できます。保存を待たず、すぐに反映されます" Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="EnabledToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"
                                      Style="{StaticResource SnapwellToggleSwitchStyle}"
                                      VerticalAlignment="Center" AutomationProperties.Name="Snapwell を有効にする"
                                      Toggled="Enabled_Toggled" />
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <!-- デモ状態 (未実装) ここまで -->
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="サインイン時に起動する" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock Text="スタートアップに登録します"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                            <TextBlock x:Name="RegistrationStatus" Visibility="Collapsed"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}"
                                       Foreground="{ThemeResource SnapwellYellowTextBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="AutoStartToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"
                                      Style="{StaticResource SnapwellToggleSwitchStyle}"
                                      VerticalAlignment="Center" AutomationProperties.Name="サインイン時に起動する"
                                      Toggled="AutoStart_Toggled" />
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="管理者として起動する" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock
                                Text="管理者権限で動くアプリのウィンドウも動かせます。タスク スケジューラに登録します。Windows の確認画面が表示されます。次のサインインから有効です"
                                Style="{StaticResource SnapwellRowDescriptionStyle}" />
                            <TextBlock x:Name="AdminStartStatus" Visibility="Collapsed"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}"
                                       Foreground="{ThemeResource SnapwellYellowTextBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="AdminStartToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"
                                      Style="{StaticResource SnapwellToggleSwitchStyle}"
                                      VerticalAlignment="Center" AutomationProperties.Name="管理者として起動する"
                                      Toggled="AdminStart_Toggled" />
                    </Grid>
                    <!-- デモ状態 (未実装) -->
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <Grid ColumnSpacing="6" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="言語" Style="{StaticResource SnapwellRowTitleStyle}" />
                                <Border Grid.Column="1" Style="{StaticResource SnapwellTagPendingStyle}">
                                    <TextBlock Text="準備中" Style="{StaticResource SnapwellTagPendingTextStyle}" />
                                </Border>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ComboBox IsEnabled="False"
                                Width="160"
                                Style="{StaticResource DemoSelectStyle}"
                                SelectedIndex="0"
                                AutomationProperties.Name="日本語">
                                <ComboBoxItem Content="日本語" />
                                <ComboBoxItem Content="English" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <!-- デモ状態 (未実装) ここまで -->
                </StackPanel>
            </Border>

            <TextBlock Text="対象のウィンドウ" Style="{StaticResource SnapwellGroupTitleStyle}" />
            <Border Style="{StaticResource SnapwellRowsBorderStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="サイズ固定のウィンドウも動かす" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock
                                Text="サイズは変えず、区画の中で位置だけを合わせます"
                                Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="MoveFixedSizeToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"
                                      Style="{StaticResource SnapwellToggleSwitchStyle}"
                                      VerticalAlignment="Center" AutomationProperties.Name="サイズ固定のウィンドウも動かす"
                                      Toggled="MoveFixedSize_Toggled" />
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ポップアップとフライアウトも動かす" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock
                                Text="タスクバーから開く小さなウィンドウなど。フォーカスを奪わずに、ホットキーとドラッグで動かします（整列の対象にはなりません。ドラッグで動かせないものもあります）"
                                Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="MovePopupToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"
                                      Style="{StaticResource SnapwellToggleSwitchStyle}"
                                      VerticalAlignment="Center" AutomationProperties.Name="ポップアップとフライアウトも動かす"
                                      Toggled="MovePopup_Toggled" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
