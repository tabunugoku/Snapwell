<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Snapwell.Settings.Pages.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Padding="28,16,28,32" MaxWidth="820" HorizontalAlignment="Stretch">
            <TextBlock Text="全般" Style="{StaticResource TitleTextBlockStyle}" />
            <InfoBar x:Name="ErrorNotice" Severity="Error" IsClosable="True" />
            <ToggleSwitch x:Name="AutoStartToggle" Header="サインイン時に Snapwell を起動する"
                          Toggled="AutoStart_Toggled" />
            <TextBlock x:Name="RegistrationStatus" TextWrapping="Wrap" />
            <TextBlock Text="自動起動の変更はすぐに反映されます。保存や未保存の確認とは無関係で、設定が読み取り専用でも変更できます。"
                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="タイトルバーの長押し" Style="{StaticResource SubtitleTextBlockStyle}" />
            <NumberBox x:Name="LongPressMillisecondsBox" Header="長押しの時間 (ms)" Minimum="150" Maximum="2000"
                       SmallChange="50" LargeChange="100" SpinButtonPlacementMode="Compact"
                       ValueChanged="LongPressMilliseconds_ValueChanged"
                       ValidationMode="InvalidInputOverwritten" />
            <NumberBox x:Name="LongPressDistanceBox" Header="長押し中に動いてよい距離 (px)" Minimum="2" Maximum="32"
                       SmallChange="1" LargeChange="5" SpinButtonPlacementMode="Compact"
                       ValueChanged="LongPressDistance_ValueChanged"
                       ValidationMode="InvalidInputOverwritten" />
            <TextBlock Text="長押しの時間は 150〜2000 ms、動いてよい距離は 2〜32 px で指定できます。距離はモニターの DPI に合わせて換算されます。"
                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
