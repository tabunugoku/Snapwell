<?xml version="1.0" encoding="utf-8"?>
<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:l="using:Snapwell.Settings.Localization"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Snapwell.Settings.Controls"
    x:Class="Snapwell.Settings.Pages.OsPage">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32,28,32,40" HorizontalAlignment="Stretch">
            <TextBlock l:Loc.Uid="Os_Title" Style="{StaticResource SnapwellPageTitleStyle}" />
            <TextBlock l:Loc.Uid="Os_Lead" Style="{StaticResource SnapwellLeadTextStyle}" />
            <InfoBar x:Name="ErrorNotice" IsOpen="False" Severity="Error" Margin="0,0,0,12" />
            <Border Style="{StaticResource SnapwellRowsBorderStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock l:Loc.Uid="Os_DragTitle" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock l:Loc.Uid="Os_DragDescription"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border x:Name="DragSnapTag" Style="{StaticResource SnapwellTagStyle}">
                                <TextBlock x:Name="DragSnapTagText" Style="{StaticResource SnapwellTagTextStyle}" />
                            </Border>
                            <ToggleSwitch l:Loc.Uid="Os_StandardSnapToggle" x:Name="StandardSnapToggle"
                                          IsEnabled="False" Style="{StaticResource SnapwellToggleSwitchStyle}"
                                          Toggled="StandardSnap_Toggled" />
                        </StackPanel>
                    </Grid>
                    <controls:OsHowDiagram Kind="DragSnap" />
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock l:Loc.Uid="Os_LayoutTitle" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock l:Loc.Uid="Os_LayoutDescription"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <Border x:Name="LayoutTag" Grid.Column="1" VerticalAlignment="Center"
 Style="{StaticResource SnapwellTagStyle}">
                            <TextBlock x:Name="LayoutTagText" Style="{StaticResource SnapwellTagTextStyle}" />
                        </Border>
                    </Grid>
                    <controls:OsHowDiagram Kind="SnapLayout" />
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock l:Loc.Uid="Os_BarTitle" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock l:Loc.Uid="Os_BarDescription"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <Border x:Name="SnapBarTag" Grid.Column="1" VerticalAlignment="Center"
 Style="{StaticResource SnapwellTagStyle}">
                            <TextBlock x:Name="SnapBarTagText" Style="{StaticResource SnapwellTagTextStyle}" />
                        </Border>
                    </Grid>
                    <controls:OsHowDiagram Kind="SnapBar" />
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Border Style="{StaticResource SnapwellKbdBorderStyle}">
                                    <TextBlock Text="Win" Style="{StaticResource SnapwellKbdTextStyle}" />
                                </Border>
                                <TextBlock l:Loc.Uid="Os_ArrowTitle" Style="{StaticResource SnapwellRowTitleStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock l:Loc.Uid="Os_ArrowDescription"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border x:Name="WinArrowTag" Style="{StaticResource SnapwellTagPendingStyle}">
                                <TextBlock l:Loc.Uid="Os_WinArrowTagText" x:Name="WinArrowTagText"
                                           Style="{StaticResource SnapwellTagTextStyle}" />
                            </Border>
                            <ToggleSwitch l:Loc.Uid="Os_ReplaceWinArrowToggle" x:Name="ReplaceWinArrowToggle"
                                          IsEnabled="False" Style="{StaticResource SnapwellToggleSwitchStyle}"
                                          Toggled="ReplaceWinArrow_Toggled" />
                        </StackPanel>
                    </Grid>
                    <controls:OsHowDiagram Kind="WinArrow" />
                </StackPanel>
            </Border>
            <Button l:Loc.Uid="Os_RestoreButton" x:Name="RestoreButton" IsEnabled="False" Margin="0,12,0,0"
                    Style="{StaticResource SnapwellActionButtonStyle}" Click="Restore_Click" />
        </StackPanel>
    </ScrollViewer>
</Page>
