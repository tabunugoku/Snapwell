<?xml version="1.0" encoding="utf-8"?>
<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Snapwell.Settings.Controls"
    x:Class="Snapwell.Settings.Pages.OsPage">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32,28,32,40" HorizontalAlignment="Stretch">
            <TextBlock Text="Windows の標準機能" Style="{StaticResource SnapwellPageTitleStyle}" />
            <TextBlock
                Text="Snapwell が有効な間だけ、次の機能を止めます。止める前の値を保存しておき、無効にしたとき・終了したとき・異常終了のあとに起動したときに戻します。"
                Style="{StaticResource SnapwellLeadTextStyle}" />
            <InfoBar x:Name="ErrorNotice" IsOpen="False" Severity="Error" Margin="0,0,0,12" />
            <Border Style="{StaticResource SnapwellRowsBorderStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ドラッグでのスナップ" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock
                                Text="設定アプリの「ウィンドウのスナップ」と同じ設定です"
                                Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border x:Name="DragSnapTag" Style="{StaticResource SnapwellTagStyle}">
                                <TextBlock x:Name="DragSnapTagText" Style="{StaticResource SnapwellTagTextStyle}" />
                            </Border>
                            <ToggleSwitch x:Name="StandardSnapToggle" IsEnabled="False"
                                Style="{StaticResource SnapwellToggleSwitchStyle}"
                                Toggled="StandardSnap_Toggled"
                                AutomationProperties.Name="ドラッグでのスナップ" />
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="スナップ レイアウト（最大化ボタンのメニュー）"
                                       Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock
                                Text="ドラッグでのスナップを止めると一緒に止まります"
                                Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <Border x:Name="LayoutTag" Grid.Column="1" VerticalAlignment="Center"
                                Style="{StaticResource SnapwellTagStyle}">
                            <TextBlock x:Name="LayoutTagText" Style="{StaticResource SnapwellTagTextStyle}" />
                        </Border>
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="画面上端のスナップ バー" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock Text="24H2 以降。ドラッグでのスナップを止めると一緒に止まります"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <Border x:Name="SnapBarTag" Grid.Column="1" VerticalAlignment="Center"
                                Style="{StaticResource SnapwellTagStyle}">
                            <TextBlock x:Name="SnapBarTagText" Style="{StaticResource SnapwellTagTextStyle}" />
                        </Border>
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Border Style="{StaticResource SnapwellKbdBorderStyle}">
                                    <TextBlock Text="Win" Style="{StaticResource SnapwellKbdTextStyle}" />
                                </Border>
                                <TextBlock Text=" + 矢印" Style="{StaticResource SnapwellRowTitleStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Snapwell の操作（左・右・上・下の半分）に置き換えます"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border x:Name="WinArrowTag" Style="{StaticResource SnapwellTagPendingStyle}">
                                <TextBlock x:Name="WinArrowTagText" Text="標準のまま"
                                           Style="{StaticResource SnapwellTagTextStyle}" />
                            </Border>
                            <ToggleSwitch x:Name="ReplaceWinArrowToggle" IsEnabled="False"
                                Style="{StaticResource SnapwellToggleSwitchStyle}"
                                Toggled="ReplaceWinArrow_Toggled"
                                AutomationProperties.Name="Win 矢印" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <Grid ColumnSpacing="10" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="RestoreButton" IsEnabled="False" Content="標準の動作に戻す"
                        Style="{StaticResource SnapwellButtonStyle}" Click="Restore_Click" />
                <TextBlock
                    x:Name="RestoreHint"
                    Grid.Column="1"
                    Style="{StaticResource SnapwellHintTextStyle}"
                    VerticalAlignment="Center" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
