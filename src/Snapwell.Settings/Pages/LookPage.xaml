<?xml version="1.0" encoding="utf-8"?>
<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Snapwell.Settings.Controls"
    x:Class="Snapwell.Settings.Pages.LookPage">
    <Page.Resources>
        <Style x:Key="CornerCardStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{ThemeResource SnapwellSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SnapwellBorderBrush}" />
        </Style>
        <Style x:Key="DemoSwitchStyle" TargetType="ToggleSwitch"
               BasedOn="{StaticResource SnapwellDemoSwitchStyle}" />
        <Style x:Key="DemoSelectStyle" TargetType="ComboBox"
               BasedOn="{StaticResource SnapwellDemoSelectStyle}">
            <Setter Property="FontFamily" Value="{StaticResource SnapwellUiFontFamily}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{ThemeResource SnapwellSurfaceBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource SnapwellTextBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SnapwellBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32,28,32,40" HorizontalAlignment="Stretch">

            <TextBlock Text="外観" Style="{StaticResource SnapwellPageTitleStyle}" />
            <TextBlock Text="ウィンドウの角の形と、Snapwell のオーバーレイの見た目です。" Style="{StaticResource SnapwellLeadTextStyle}" />
            <Border Style="{StaticResource SnapwellRowsBorderStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <Grid ColumnSpacing="6" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ウィンドウの角" Style="{StaticResource SnapwellRowTitleStyle}" />
                            </Grid>
                            <TextBlock
                                Text="DWM の角の設定を使います。半径は Windows が決めます（約 8 px）"
                                Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ComboBox x:Name="CornerBox" SelectionChanged="Corner_SelectionChanged"
                                Width="200"
                                Style="{StaticResource DemoSelectStyle}"
                                SelectedIndex="0"
                                AutomationProperties.Name="角丸を強制する">
                                <ComboBoxItem Content="角丸を強制する" />
                                <ComboBoxItem Content="小さい角丸" />
                                <ComboBoxItem Content="角丸なし" />
                                <ComboBoxItem Content="Windows の既定" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="区画のプレビュー" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock Text="ドラッグ中に、吸着先の区画を青く塗って見せます。オフにすると、離すまで何も表示しません"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="ZonePreviewToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"
                                      Style="{StaticResource SnapwellToggleSwitchStyle}"
                                      VerticalAlignment="Center" AutomationProperties.Name="区画のプレビュー"
                                      Toggled="ZonePreview_Toggled" />
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <Grid ColumnSpacing="6" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="大きな角丸（macOS 風）" Style="{StaticResource SnapwellRowTitleStyle}" />
                                <Border Grid.Column="1" Style="{StaticResource SnapwellTagPendingStyle}">
                                    <TextBlock Text="準備中" Style="{StaticResource SnapwellTagPendingTextStyle}" />
                                </Border>
                            </Grid>
                            <TextBlock Text="半径を自由に決める方法を検証しています" Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Style="{StaticResource SnapwellTagYellowStyle}">
                                <TextBlock Text="要検証" Style="{StaticResource SnapwellTagYellowTextStyle}" />
                            </Border>
                            <ToggleSwitch
                                Style="{StaticResource DemoSwitchStyle}"
                                IsOn="False"
                                AutomationProperties.Name="大きな角丸"
                                IsEnabled="False" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock Text="ウィンドウの角の見え方" Style="{StaticResource SnapwellGroupTitleStyle}" />
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" VerticalAlignment="Top">
                    <Button x:Name="CardDefault" Tag="0" Click="CornerCard_Click"
                            Style="{StaticResource CornerCardStyle}" AutomationProperties.Name="Windows の既定">
                        <StackPanel Spacing="6">
                            <Border Height="62" CornerRadius="8" BorderThickness="1.5"
                                    BorderBrush="{ThemeResource SnapwellBorderStrongBrush}"
                                    Background="{ThemeResource SnapwellSurface2Brush}">
                                <Border Height="14" VerticalAlignment="Top" BorderThickness="0,0,0,1"
                                        BorderBrush="{ThemeResource SnapwellBorderBrush}"
                                        Background="{ThemeResource SnapwellSurfaceBrush}" />
                            </Border>
                            <TextBlock Text="Windows の既定" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"
                                       Foreground="{ThemeResource SnapwellTextBrush}" />
                            <TextBlock Text="何も変えません。角の形は Windows とアプリ任せで、アプリによって丸だったり直角だったりします" FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{ThemeResource SnapwellMutedBrush}" />
                        </StackPanel>
                    </Button>
                    <Border x:Name="CardDefaultMark" CornerRadius="10" BorderThickness="1.5" IsHitTestVisible="False"
                            BorderBrush="{ThemeResource SnapwellInkBrush}" Visibility="Collapsed" />
                </Grid>
                <Grid Grid.Column="1" VerticalAlignment="Top">
                    <Button x:Name="CardRound" Tag="1" Click="CornerCard_Click"
                            Style="{StaticResource CornerCardStyle}" AutomationProperties.Name="角丸を強制する">
                        <StackPanel Spacing="6">
                            <Border Height="62" CornerRadius="8" BorderThickness="1.5"
                                    BorderBrush="{ThemeResource SnapwellBorderStrongBrush}"
                                    Background="{ThemeResource SnapwellSurface2Brush}">
                                <Border Height="14" VerticalAlignment="Top" BorderThickness="0,0,0,1"
                                        BorderBrush="{ThemeResource SnapwellBorderBrush}"
                                        Background="{ThemeResource SnapwellSurfaceBrush}" />
                            </Border>
                            <TextBlock Text="角丸を強制する" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"
                                       Foreground="{ThemeResource SnapwellTextBrush}" />
                            <TextBlock Text="すべてのウィンドウを標準の丸（約 8 px）にそろえます" FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{ThemeResource SnapwellMutedBrush}" />
                        </StackPanel>
                    </Button>
                    <Border x:Name="CardRoundMark" CornerRadius="10" BorderThickness="1.5" IsHitTestVisible="False"
                            BorderBrush="{ThemeResource SnapwellInkBrush}" Visibility="Collapsed" />
                </Grid>
                <Grid Grid.Column="2" VerticalAlignment="Top">
                    <Button x:Name="CardSmall" Tag="2" Click="CornerCard_Click"
                            Style="{StaticResource CornerCardStyle}" AutomationProperties.Name="小さい角丸">
                        <StackPanel Spacing="6">
                            <Border Height="62" CornerRadius="4" BorderThickness="1.5"
                                    BorderBrush="{ThemeResource SnapwellBorderStrongBrush}"
                                    Background="{ThemeResource SnapwellSurface2Brush}">
                                <Border Height="14" VerticalAlignment="Top" BorderThickness="0,0,0,1"
                                        BorderBrush="{ThemeResource SnapwellBorderBrush}"
                                        Background="{ThemeResource SnapwellSurfaceBrush}" />
                            </Border>
                            <TextBlock Text="小さい角丸" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"
                                       Foreground="{ThemeResource SnapwellTextBrush}" />
                            <TextBlock Text="丸みを控えめにします（約 4 px）" FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{ThemeResource SnapwellMutedBrush}" />
                        </StackPanel>
                    </Button>
                    <Border x:Name="CardSmallMark" CornerRadius="10" BorderThickness="1.5" IsHitTestVisible="False"
                            BorderBrush="{ThemeResource SnapwellInkBrush}" Visibility="Collapsed" />
                </Grid>
                <Grid Grid.Column="3" VerticalAlignment="Top">
                    <Button x:Name="CardNone" Tag="3" Click="CornerCard_Click"
                            Style="{StaticResource CornerCardStyle}" AutomationProperties.Name="角丸なし">
                        <StackPanel Spacing="6">
                            <Border Height="62" CornerRadius="0" BorderThickness="1.5"
                                    BorderBrush="{ThemeResource SnapwellBorderStrongBrush}"
                                    Background="{ThemeResource SnapwellSurface2Brush}">
                                <Border Height="14" VerticalAlignment="Top" BorderThickness="0,0,0,1"
                                        BorderBrush="{ThemeResource SnapwellBorderBrush}"
                                        Background="{ThemeResource SnapwellSurfaceBrush}" />
                            </Border>
                            <TextBlock Text="角丸なし" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"
                                       Foreground="{ThemeResource SnapwellTextBrush}" />
                            <TextBlock Text="すべてのウィンドウを直角にします" FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{ThemeResource SnapwellMutedBrush}" />
                        </StackPanel>
                    </Button>
                    <Border x:Name="CardNoneMark" CornerRadius="10" BorderThickness="1.5" IsHitTestVisible="False"
                            BorderBrush="{ThemeResource SnapwellInkBrush}" Visibility="Collapsed" />
                </Grid>
                <Border Grid.Column="4" Opacity="0.55" Padding="10" CornerRadius="10" BorderThickness="1"
                        VerticalAlignment="Top"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}"
                        Background="{ThemeResource SnapwellSurfaceBrush}">
                    <StackPanel Spacing="6">
                        <Border Height="62" CornerRadius="16" BorderThickness="1.5"
                                BorderBrush="{ThemeResource SnapwellBorderStrongBrush}"
                                Background="{ThemeResource SnapwellSurface2Brush}">
                            <Border Height="14" VerticalAlignment="Top" BorderThickness="0,0,0,1"
                                    BorderBrush="{ThemeResource SnapwellBorderBrush}"
                                    Background="{ThemeResource SnapwellSurfaceBrush}" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="大きな角丸" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{ThemeResource SnapwellTextBrush}" />
                            <Border Style="{StaticResource SnapwellTagPendingStyle}">
                                <TextBlock Text="準備中" Style="{StaticResource SnapwellTagPendingTextStyle}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="macOS 風の大きな丸み。実現方法を検証中です" FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{ThemeResource SnapwellMutedBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock Text="オーバーレイ" Style="{StaticResource SnapwellGroupTitleStyle}" />
            <Border Style="{StaticResource SnapwellRowsBorderStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <Grid ColumnSpacing="6" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="区画の線を表示する" Style="{StaticResource SnapwellRowTitleStyle}" />
                            </Grid>
                            <TextBlock Text="吸着先の区画の縁に点線の枠を付けます（区画のプレビューがオンのとき）。ランチャーの区画の線にも効きます"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ToggleSwitch Toggled="Lines_Toggled"
                                Style="{StaticResource DemoSwitchStyle}"
                                IsOn="True"
                                x:Name="ZoneLinesToggle" AutomationProperties.Name="区画の線" />
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <Grid ColumnSpacing="6" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="投げたときに予測の線を表示する" Style="{StaticResource SnapwellRowTitleStyle}" />
                            </Grid>
                            <TextBlock Text="ウィンドウが止まる予測の位置まで、点線と丸印で示します。慣れたら消せます（区画のプレビューがオンのとき）" Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ToggleSwitch Toggled="Lines_Toggled"
                                Style="{StaticResource DemoSwitchStyle}"
                                IsOn="True"
                                x:Name="PredictionLineToggle" AutomationProperties.Name="予測の線" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock Text="オーバーレイの見え方" Style="{StaticResource SnapwellGroupTitleStyle}" />
            <TextBlock Text="ウィンドウをドラッグして、右上へ投げた場面の例です。上の「区画のプレビュー」と、下の二つの切り替えを変えると、表示がどう変わるかをここで確かめられます。"
                       Style="{StaticResource SnapwellHintTextStyle}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <Border Width="400" Height="190" HorizontalAlignment="Left" CornerRadius="10" BorderThickness="1"
                    BorderBrush="{ThemeResource SnapwellBorderBrush}"
                    Background="{ThemeResource SnapwellSurfaceBrush}"
                    AutomationProperties.Name="オーバーレイの見え方の例">
                <Grid>
                    <Canvas Width="398" Height="188" Opacity="0.6">
                        <Rectangle Canvas.Left="99.5" Width="1" Height="188" Fill="{ThemeResource SnapwellBorderBrush}" />
                        <Rectangle Canvas.Left="199.5" Width="1" Height="188" Fill="{ThemeResource SnapwellBorderBrush}" />
                        <Rectangle Canvas.Left="298.5" Width="1" Height="188" Fill="{ThemeResource SnapwellBorderBrush}" />
                        <Rectangle Canvas.Top="93.5" Width="398" Height="1" Fill="{ThemeResource SnapwellBorderBrush}" />
                    </Canvas>
                    <Canvas Width="398" Height="188">
                        <Rectangle x:Name="OverlayFill" Canvas.Left="199" Width="199" Height="94" RadiusX="8" RadiusY="8"
                                   Fill="{ThemeResource SnapwellBlueBackgroundBrush}" />
                        <Rectangle x:Name="OverlayBox" Canvas.Left="199" Width="199" Height="94" RadiusX="8" RadiusY="8"
                                   Stroke="{ThemeResource SnapwellBlueLineBrush}" StrokeThickness="1.5"
                                   StrokeDashArray="3,3" />
                        <Line x:Name="OverlayPredLine" X1="91" Y1="139" X2="297" Y2="51"
                              Stroke="{ThemeResource SnapwellBlueTextBrush}" StrokeThickness="2"
                              StrokeDashArray="2.5,2.5" />
                        <Ellipse x:Name="OverlayPredDot" Canvas.Left="292" Canvas.Top="46" Width="10" Height="10"
                                 Fill="{ThemeResource SnapwellBlueTextBrush}" />
                        <Border Canvas.Left="11" Canvas.Top="111" Width="96" Height="62" CornerRadius="8"
                                BorderThickness="1.5" BorderBrush="{ThemeResource SnapwellBorderStrongBrush}"
                                Background="{ThemeResource SnapwellSurface2Brush}">
                            <Border Height="14" VerticalAlignment="Top" BorderThickness="0,0,0,1"
                                    BorderBrush="{ThemeResource SnapwellBorderBrush}"
                                    Background="{ThemeResource SnapwellSurfaceBrush}" />
                        </Border>
                    </Canvas>
                    <TextBlock x:Name="OverlayLegend" FontSize="11.5" HorizontalAlignment="Right"
                               VerticalAlignment="Bottom" Margin="0,0,8,6" TextAlignment="Right"
                               Foreground="{ThemeResource SnapwellMutedBrush}" />
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
