<?xml version="1.0" encoding="utf-8"?>
<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:l="using:Snapwell.Settings.Localization"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Snapwell.Settings.Controls"
    x:Class="Snapwell.Settings.Pages.LookPage">
    <Page.Resources>
        <Style x:Key="CornerCardStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{ThemeResource SnapwellSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SnapwellBorderBrush}" />
        </Style>
        <Style x:Key="DemoSwitchStyle" TargetType="ToggleSwitch"
               BasedOn="{StaticResource SnapwellDemoSwitchStyle}" />
        <Style x:Key="DemoSelectStyle" TargetType="ComboBox"
               BasedOn="{StaticResource SnapwellDemoSelectStyle}">
            <Setter Property="FontFamily" Value="{StaticResource SnapwellUiFontFamily}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{ThemeResource SnapwellSurfaceBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource SnapwellTextBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SnapwellBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32,28,32,40" HorizontalAlignment="Stretch">

            <TextBlock l:Loc.Uid="Look_Title" Style="{StaticResource SnapwellPageTitleStyle}" />
            <TextBlock l:Loc.Uid="Look_Lead" Style="{StaticResource SnapwellLeadTextStyle}" />
            <Border Style="{StaticResource SnapwellRowsBorderStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <Grid ColumnSpacing="6" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock l:Loc.Uid="Look_CornersTitle" Style="{StaticResource SnapwellRowTitleStyle}" />
                            </Grid>
                            <TextBlock l:Loc.Uid="Look_CornersDescription"
                                Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ComboBox l:Loc.Uid="Look_CornerBox" x:Name="CornerBox" SelectionChanged="Corner_SelectionChanged"
                                Width="200"
                                Style="{StaticResource DemoSelectStyle}"
                                SelectedIndex="0"
                                >
                                <ComboBoxItem x:Name="CornerRoundItem" />
                                <ComboBoxItem x:Name="CornerSmallItem" />
                                <ComboBoxItem x:Name="CornerNoneItem" />
                                <ComboBoxItem x:Name="CornerDefaultItem" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock l:Loc.Uid="Look_ZonePreviewTitle" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock l:Loc.Uid="Look_ZonePreviewDescription"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch l:Loc.Uid="Look_ZonePreviewToggle" x:Name="ZonePreviewToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"
                                      Style="{StaticResource SnapwellToggleSwitchStyle}"
                                      VerticalAlignment="Center"
                                      Toggled="ZonePreview_Toggled" />
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock l:Loc.Uid="Look_CornerExamplesTitle" Style="{StaticResource SnapwellGroupTitleStyle}" />
            <TextBlock l:Loc.Uid="Look_CornerExamplesHint"
                       Style="{StaticResource SnapwellHintTextStyle}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" VerticalAlignment="Stretch">
                    <Button x:Name="CardDefault" Tag="0" Click="CornerCard_Click"
                            Style="{StaticResource CornerCardStyle}" >
                        <StackPanel Spacing="6">
                            <Border Height="62" CornerRadius="8" BorderThickness="1.5"
                                    BorderBrush="{ThemeResource SnapwellBorderStrongBrush}"
                                    Background="{ThemeResource SnapwellSurface2Brush}">
                                <Border Height="14" VerticalAlignment="Top" BorderThickness="0,0,0,1"
                                        BorderBrush="{ThemeResource SnapwellBorderBrush}"
                                        Background="{ThemeResource SnapwellSurfaceBrush}" />
                            </Border>
                            <TextBlock x:Name="CornerDefaultLabel" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"
                                       Foreground="{ThemeResource SnapwellTextBrush}" />
                            <TextBlock l:Loc.Uid="Look_CornerDefaultDescription" FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{ThemeResource SnapwellMutedBrush}" />
                        </StackPanel>
                    </Button>
                    <Border x:Name="CardDefaultMark" CornerRadius="10" BorderThickness="1.5" IsHitTestVisible="False"
                            BorderBrush="{ThemeResource SnapwellInkBrush}" Visibility="Collapsed" />
                </Grid>
                <Grid Grid.Column="1" VerticalAlignment="Stretch">
                    <Button x:Name="CardRound" Tag="1" Click="CornerCard_Click"
                            Style="{StaticResource CornerCardStyle}" >
                        <StackPanel Spacing="6">
                            <Border Height="62" CornerRadius="8" BorderThickness="1.5"
                                    BorderBrush="{ThemeResource SnapwellBorderStrongBrush}"
                                    Background="{ThemeResource SnapwellSurface2Brush}">
                                <Border Height="14" VerticalAlignment="Top" BorderThickness="0,0,0,1"
                                        BorderBrush="{ThemeResource SnapwellBorderBrush}"
                                        Background="{ThemeResource SnapwellSurfaceBrush}" />
                            </Border>
                            <TextBlock x:Name="CornerRoundLabel" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"
                                       Foreground="{ThemeResource SnapwellTextBrush}" />
                            <TextBlock l:Loc.Uid="Look_CornerRoundDescription" FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{ThemeResource SnapwellMutedBrush}" />
                        </StackPanel>
                    </Button>
                    <Border x:Name="CardRoundMark" CornerRadius="10" BorderThickness="1.5" IsHitTestVisible="False"
                            BorderBrush="{ThemeResource SnapwellInkBrush}" Visibility="Collapsed" />
                </Grid>
                <Grid Grid.Column="2" VerticalAlignment="Stretch">
                    <Button x:Name="CardSmall" Tag="2" Click="CornerCard_Click"
                            Style="{StaticResource CornerCardStyle}" >
                        <StackPanel Spacing="6">
                            <Border Height="62" CornerRadius="4" BorderThickness="1.5"
                                    BorderBrush="{ThemeResource SnapwellBorderStrongBrush}"
                                    Background="{ThemeResource SnapwellSurface2Brush}">
                                <Border Height="14" VerticalAlignment="Top" BorderThickness="0,0,0,1"
                                        BorderBrush="{ThemeResource SnapwellBorderBrush}"
                                        Background="{ThemeResource SnapwellSurfaceBrush}" />
                            </Border>
                            <TextBlock x:Name="CornerSmallLabel" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"
                                       Foreground="{ThemeResource SnapwellTextBrush}" />
                            <TextBlock l:Loc.Uid="Look_CornerSmallDescription" FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{ThemeResource SnapwellMutedBrush}" />
                        </StackPanel>
                    </Button>
                    <Border x:Name="CardSmallMark" CornerRadius="10" BorderThickness="1.5" IsHitTestVisible="False"
                            BorderBrush="{ThemeResource SnapwellInkBrush}" Visibility="Collapsed" />
                </Grid>
                <Grid Grid.Column="3" VerticalAlignment="Stretch">
                    <Button x:Name="CardNone" Tag="3" Click="CornerCard_Click"
                            Style="{StaticResource CornerCardStyle}" >
                        <StackPanel Spacing="6">
                            <Border Height="62" CornerRadius="0" BorderThickness="1.5"
                                    BorderBrush="{ThemeResource SnapwellBorderStrongBrush}"
                                    Background="{ThemeResource SnapwellSurface2Brush}">
                                <Border Height="14" VerticalAlignment="Top" BorderThickness="0,0,0,1"
                                        BorderBrush="{ThemeResource SnapwellBorderBrush}"
                                        Background="{ThemeResource SnapwellSurfaceBrush}" />
                            </Border>
                            <TextBlock x:Name="CornerNoneLabel" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"
                                       Foreground="{ThemeResource SnapwellTextBrush}" />
                            <TextBlock l:Loc.Uid="Look_CornerNoneDescription" FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{ThemeResource SnapwellMutedBrush}" />
                        </StackPanel>
                    </Button>
                    <Border x:Name="CardNoneMark" CornerRadius="10" BorderThickness="1.5" IsHitTestVisible="False"
                            BorderBrush="{ThemeResource SnapwellInkBrush}" Visibility="Collapsed" />
                </Grid>
            </Grid>
            <TextBlock l:Loc.Uid="Look_OverlayTitle" Style="{StaticResource SnapwellGroupTitleStyle}" />
            <Border Style="{StaticResource SnapwellRowsBorderStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <Grid ColumnSpacing="6" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock l:Loc.Uid="Look_ZoneLinesTitle" Style="{StaticResource SnapwellRowTitleStyle}" />
                            </Grid>
                            <TextBlock l:Loc.Uid="Look_ZoneLinesDescription"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ToggleSwitch l:Loc.Uid="Look_ZoneLinesToggle" Toggled="Lines_Toggled"
                                Style="{StaticResource DemoSwitchStyle}"
                                IsOn="True"
                                x:Name="ZoneLinesToggle" />
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <Grid ColumnSpacing="6" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock l:Loc.Uid="Look_PredictionLineTitle" Style="{StaticResource SnapwellRowTitleStyle}" />
                            </Grid>
                            <TextBlock l:Loc.Uid="Look_PredictionLineDescription" Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ToggleSwitch l:Loc.Uid="Look_PredictionLineToggle" Toggled="Lines_Toggled"
                                Style="{StaticResource DemoSwitchStyle}"
                                IsOn="True"
                                x:Name="PredictionLineToggle" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock l:Loc.Uid="Look_OverlayExampleTitle" Style="{StaticResource SnapwellGroupTitleStyle}" />
            <TextBlock l:Loc.Uid="Look_OverlayExampleHint"
                       Style="{StaticResource SnapwellHintTextStyle}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <Border l:Loc.Uid="Look_OverlayExampleName" Width="400" Height="190" HorizontalAlignment="Left" CornerRadius="10" BorderThickness="1"
                    BorderBrush="{ThemeResource SnapwellBorderBrush}"
                    Background="{ThemeResource SnapwellSurfaceBrush}"
                    >
                <Grid>
                    <Canvas Width="398" Height="188" Opacity="0.6">
                        <Rectangle Canvas.Left="99.5" Width="1" Height="188" Fill="{ThemeResource SnapwellBorderBrush}" />
                        <Rectangle Canvas.Left="199.5" Width="1" Height="188" Fill="{ThemeResource SnapwellBorderBrush}" />
                        <Rectangle Canvas.Left="298.5" Width="1" Height="188" Fill="{ThemeResource SnapwellBorderBrush}" />
                        <Rectangle Canvas.Top="93.5" Width="398" Height="1" Fill="{ThemeResource SnapwellBorderBrush}" />
                    </Canvas>
                    <Canvas Width="398" Height="188">
                        <Rectangle x:Name="OverlayFill" Canvas.Left="199" Width="199" Height="94" RadiusX="8" RadiusY="8"
                                   Fill="{ThemeResource SnapwellBlueBackgroundBrush}" />
                        <Rectangle x:Name="OverlayBox" Canvas.Left="199" Width="199" Height="94" RadiusX="8" RadiusY="8"
                                   Stroke="{ThemeResource SnapwellBlueLineBrush}" StrokeThickness="1.5"
                                   StrokeDashArray="3,3" />
                        <Line x:Name="OverlayPredLine" X1="91" Y1="139" X2="297" Y2="51"
                              Stroke="{ThemeResource SnapwellBlueTextBrush}" StrokeThickness="2"
                              StrokeDashArray="2.5,2.5" />
                        <Ellipse x:Name="OverlayPredDot" Canvas.Left="292" Canvas.Top="46" Width="10" Height="10"
                                 Fill="{ThemeResource SnapwellBlueTextBrush}" />
                        <Border Canvas.Left="11" Canvas.Top="111" Width="96" Height="62" CornerRadius="8"
                                BorderThickness="1.5" BorderBrush="{ThemeResource SnapwellBorderStrongBrush}"
                                Background="{ThemeResource SnapwellSurface2Brush}">
                            <Border Height="14" VerticalAlignment="Top" BorderThickness="0,0,0,1"
                                    BorderBrush="{ThemeResource SnapwellBorderBrush}"
                                    Background="{ThemeResource SnapwellSurfaceBrush}" />
                        </Border>
                    </Canvas>
                    <TextBlock x:Name="OverlayLegend" FontSize="11.5" HorizontalAlignment="Right"
                               VerticalAlignment="Bottom" Margin="0,0,8,6" TextAlignment="Right"
                               Foreground="{ThemeResource SnapwellMutedBrush}" />
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
