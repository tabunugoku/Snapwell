<?xml version="1.0" encoding="utf-8"?>
<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Snapwell.Settings.Pages.LookPage">
    <Page.Resources>
        <Style x:Key="DemoSwitchStyle" TargetType="ToggleSwitch">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleSwitch">
                        <Grid Width="40" Height="20" Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="ToggleStates">
                                    <VisualState x:Name="Off" />
                                    <VisualState x:Name="On">
                                        <VisualState.Setters>
                                            <Setter
                                                Target="SwitchTrack.Background"
                                                Value="{ThemeResource SnapwellInkBrush}" />
                                            <Setter
                                                Target="SwitchTrack.BorderBrush"
                                                Value="{ThemeResource SnapwellInkBrush}" />
                                            <Setter
                                                Target="SwitchKnob.Fill"
                                                Value="{ThemeResource SnapwellInkTextBrush}" />
                                            <Setter Target="SwitchKnob.Margin" Value="23,0,0,0" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border
                                x:Name="SwitchTrack"
                                CornerRadius="9999"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource SnapwellMutedBrush}" />
                            <Ellipse
                                x:Name="SwitchKnob"
                                Width="12"
                                Height="12"
                                Margin="3,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource SnapwellMutedBrush}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DemoSelectStyle" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource SnapwellUiFontFamily}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{ThemeResource SnapwellSurfaceBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource SnapwellTextBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SnapwellBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32,28,32,40" HorizontalAlignment="Stretch">
            <!-- デモ状態 (未実装) -->
            <TextBlock Text="外観" Style="{StaticResource SnapwellPageTitleStyle}" />
            <TextBlock Text="ウィンドウの角の形と、Snapwell のオーバーレイの見た目です。" Style="{StaticResource SnapwellLeadTextStyle}" />
            <Border Style="{StaticResource SnapwellRowsBorderStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ウィンドウの角" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock
                                Text="DWM の角の設定を使います。半径は Windows が決めます（約 8 px）"
                                Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ComboBox
                                Width="200"
                                Style="{StaticResource DemoSelectStyle}"
                                SelectedIndex="0"
                                AutomationProperties.Name="角丸を強制する">
                                <ComboBoxItem Content="角丸を強制する" />
                                <ComboBoxItem Content="小さい角丸" />
                                <ComboBoxItem Content="角丸なし" />
                                <ComboBoxItem Content="Windows の既定" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="大きな角丸（macOS 風）" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock Text="半径を自由に決める方法を検証しています" Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border
                                Background="{ThemeResource SnapwellYellowBackgroundBrush}"
                                CornerRadius="9999"
                                Padding="8,1"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                                <TextBlock
                                    Text="要検証"
                                    FontSize="10.5"
                                    FontWeight="SemiBold"
                                    CharacterSpacing="50"
                                    LineHeight="16.8"
                                    TextWrapping="Wrap"
                                    Foreground="{ThemeResource SnapwellYellowTextBrush}" />
                            </Border>
                            <ToggleSwitch
                                Style="{StaticResource DemoSwitchStyle}"
                                IsOn="False"
                                AutomationProperties.Name="大きな角丸"
                                IsEnabled="False" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock Text="プレビュー" Style="{StaticResource SnapwellGroupTitleStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="16">
                <Border
                    Width="150"
                    Height="96"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource SnapwellBorderStrongBrush}"
                    Background="{ThemeResource SnapwellSurfaceBrush}">
                    <TextBlock
                        Text="角丸を強制する"
                        Style="{StaticResource SnapwellHintTextStyle}"
                        FontSize="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>
                <Border
                    Width="150"
                    Height="96"
                    CornerRadius="12"
                    Opacity="0.55"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource SnapwellBorderStrongBrush}"
                    Background="{ThemeResource SnapwellSurfaceBrush}">
                    <TextBlock
                        Text="大きな角丸（参考）"
                        Style="{StaticResource SnapwellHintTextStyle}"
                        FontSize="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>
            </StackPanel>
            <TextBlock Text="オーバーレイ" Style="{StaticResource SnapwellGroupTitleStyle}" />
            <Border Style="{StaticResource SnapwellRowsBorderStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="区画の線を表示する" Style="{StaticResource SnapwellRowTitleStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ToggleSwitch
                                Style="{StaticResource DemoSwitchStyle}"
                                IsOn="True"
                                AutomationProperties.Name="区画の線" />
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="投げたときに予測の線を表示する" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock Text="慣れたら消せます" Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ToggleSwitch
                                Style="{StaticResource DemoSwitchStyle}"
                                IsOn="True"
                                AutomationProperties.Name="予測の線" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <!-- デモ状態 (未実装) ここまで -->
        </StackPanel>
    </ScrollViewer>
</Page>
