<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Snapwell.Settings.Pages.GridPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:l="using:Snapwell.Settings.Localization"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Snapwell.Settings.Controls">
    <Page.Resources>
        <Style x:Key="DemoSwitchStyle" TargetType="ToggleSwitch"
               BasedOn="{StaticResource SnapwellDemoSwitchStyle}" />
        <Style x:Key="DemoSelectStyle" TargetType="ComboBox"
               BasedOn="{StaticResource SnapwellDemoSelectStyle}">
            <Setter Property="FontFamily" Value="{StaticResource SnapwellUiFontFamily}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{ThemeResource SnapwellSurfaceBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource SnapwellTextBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SnapwellBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ChipButtonStyle" TargetType="Button" BasedOn="{StaticResource SnapwellButtonStyle}">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="SelectedChipButtonStyle" TargetType="Button" BasedOn="{StaticResource SnapwellButtonStyle}">
            <Setter Property="Padding" Value="11,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource SnapwellInkBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SnapwellInkBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style x:Key="PreviewCellBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{ThemeResource SnapwellCellBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
        </Style>
        <Style x:Key="PreviewWindowBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SnapwellSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SnapwellBorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style x:Key="PreviewWindowLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource SnapwellMonoFontFamily}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{ThemeResource SnapwellMutedBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Editor" Padding="32,28,32,40" HorizontalAlignment="Stretch">
            <TextBlock l:Loc.Uid="Grid_Title" Style="{StaticResource SnapwellPageTitleStyle}" />
            <TextBlock l:Loc.Uid="Grid_Lead"
                       Style="{StaticResource SnapwellLeadTextStyle}" />
            <Border Style="{StaticResource SnapwellRowsBorderStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <Grid ColumnSpacing="6" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock l:Loc.Uid="Grid_MonitorTitle" Style="{StaticResource SnapwellRowTitleStyle}" />
                            </Grid>
                            <TextBlock l:Loc.Uid="Grid_MonitorStatus" x:Name="MonitorStatus"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ComboBox l:Loc.Uid="Grid_MonitorBox" x:Name="MonitorBox" Width="300"
                                Style="{StaticResource DemoSelectStyle}"
                                SelectionChanged="Monitor_SelectionChanged" DropDownOpened="Monitor_DropDownOpened" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <ComboBox l:Loc.Uid="Grid_PlanBox" x:Name="PlanBox" HorizontalAlignment="Stretch" Visibility="Collapsed"
                      SelectionChanged="Plan_SelectionChanged">
                <ComboBoxItem Content="8 × 8" />
                <ComboBoxItem Content="12 × 6" />
                <ComboBoxItem Content="6 × 4" />
                <ComboBoxItem l:Loc.Uid="Grid_CustomPlan" />
            </ComboBox>

            <TextBlock l:Loc.Uid="Grid_PlanTitle" Style="{StaticResource SnapwellGroupTitleStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button x:Name="Chip8x8" Content="8 × 8" Tag="8,8" Click="Chip_Click"
                        Style="{StaticResource ChipButtonStyle}" />
                <Button x:Name="Chip12x6" Content="12 × 6" Tag="12,6" Click="Chip_Click"
                        Style="{StaticResource ChipButtonStyle}" />
                <Button x:Name="Chip6x4" Content="6 × 4" Tag="6,4" Click="Chip_Click"
                        Style="{StaticResource ChipButtonStyle}" />
                <Button x:Name="Chip4x4" Content="4 × 4" Tag="4,4" Click="Chip_Click"
                        Style="{StaticResource ChipButtonStyle}" />
                <Button x:Name="Chip16x9" Content="16 × 9" Tag="16,9" Click="Chip_Click"
                        Style="{StaticResource ChipButtonStyle}" />
                <Button l:Loc.Uid="Grid_ChipCustom" x:Name="ChipCustom" IsHitTestVisible="False" Opacity="0.55"
                        Style="{StaticResource ChipButtonStyle}" />
            </StackPanel>

            <Grid ColumnSpacing="20" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <Border x:Name="PreviewHost" Background="{ThemeResource SnapwellWallBrush}"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}" BorderThickness="1"
                        CornerRadius="8" VerticalAlignment="Top" SizeChanged="PreviewHost_SizeChanged">
                    <Canvas x:Name="PreviewCanvas" Height="260" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="14">
                    <StackPanel Spacing="6">
                        <TextBlock l:Loc.Uid="Grid_GapTitle" Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <Slider l:Loc.Uid="Grid_GapSlider" x:Name="GapSlider" Minimum="0" Maximum="32" StepFrequency="1"
                                    VerticalAlignment="Center"
                                    ValueChanged="GapSlider_ValueChanged" />
                            <TextBlock x:Name="GapOutputText" Grid.Column="1"
                                       Style="{StaticResource SnapwellMonoTextStyle}"
                                       HorizontalTextAlignment="End" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock l:Loc.Uid="Grid_EdgeTitle" Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <Slider l:Loc.Uid="Grid_EdgeSlider" x:Name="EdgeSlider" Minimum="0" Maximum="32" StepFrequency="1"
                                    VerticalAlignment="Center"
                                    ValueChanged="EdgeSlider_ValueChanged" />
                            <TextBlock x:Name="EdgeOutputText" Grid.Column="1"
                                       Style="{StaticResource SnapwellMonoTextStyle}"
                                       HorizontalTextAlignment="End" VerticalAlignment="Center" />
                        </Grid>
                        <CheckBox l:Loc.Uid="Grid_LinkEdgeCheck" x:Name="LinkEdgeCheck" FontSize="14"
                                  Foreground="{ThemeResource SnapwellTextBrush}" MinWidth="0"
                                  Checked="LinkEdge_Changed" Unchecked="LinkEdge_Changed" />
                    </StackPanel>
                </StackPanel>
            </Grid>
            <TextBlock l:Loc.Uid="Grid_ResizeTitle" Style="{StaticResource SnapwellGroupTitleStyle}" />
            <TextBlock l:Loc.Uid="Grid_ResizeHint"
                Style="{StaticResource SnapwellHintTextStyle}"
                Margin="0,0,0,8" />
            <Border Style="{StaticResource SnapwellRowsBorderStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <Grid ColumnSpacing="6" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock l:Loc.Uid="Grid_ResizeStepTitle" Style="{StaticResource SnapwellRowTitleStyle}" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ComboBox l:Loc.Uid="Grid_ResizeStepBox" x:Name="ResizeStepBox"
                                Width="160"
                                Style="{StaticResource DemoSelectStyle}"
                                SelectionChanged="ResizeStep_SelectionChanged">
                                <ComboBoxItem l:Loc.Uid="Grid_Step1" Tag="1" />
                                <ComboBoxItem l:Loc.Uid="Grid_Step2" Tag="2" />
                                <ComboBoxItem l:Loc.Uid="Grid_Step3" Tag="3" />
                                <ComboBoxItem l:Loc.Uid="Grid_Step4" Tag="4" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <Grid ColumnSpacing="6" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock l:Loc.Uid="Grid_AnchorTitle" Style="{StaticResource SnapwellRowTitleStyle}" />
                            </Grid>
                            <TextBlock l:Loc.Uid="Grid_AnchorDescription" Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ComboBox l:Loc.Uid="Grid_ResizeAnchorBox" x:Name="ResizeAnchorBox"
                                Width="160"
                                Style="{StaticResource DemoSelectStyle}"
                                SelectionChanged="ResizeAnchor_SelectionChanged">
                                <ComboBoxItem l:Loc.Uid="Grid_AnchorTopLeft" Tag="TopLeft" />
                                <ComboBoxItem l:Loc.Uid="Grid_AnchorCenter" Tag="Center" />
                                <ComboBoxItem l:Loc.Uid="Grid_AnchorNearEdge" Tag="NearEdge" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock l:Loc.Uid="Grid_MouseResizeTitle" Style="{StaticResource SnapwellGroupTitleStyle}" />
            <Border Style="{StaticResource SnapwellRowsBorderStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <Grid ColumnSpacing="6" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock l:Loc.Uid="Grid_SnapAfterResizeTitle" Style="{StaticResource SnapwellRowTitleStyle}" />
                            </Grid>
                            <TextBlock l:Loc.Uid="Grid_SnapAfterResizeDescription"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ToggleSwitch l:Loc.Uid="Grid_SnapAfterResizeToggle" x:Name="SnapAfterResizeToggle" Toggled="SnapAfterResize_Toggled"
                                Style="{StaticResource DemoSwitchStyle}"
                                IsOn="False"
                                 />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock l:Loc.Uid="Grid_SpacingHint"
                Style="{StaticResource SnapwellHintTextStyle}"
                Margin="0,10,0,0" />
            <TextBlock l:Loc.Uid="Grid_NumbersTitle" Style="{StaticResource SnapwellGroupTitleStyle}" />
            <Border Style="{StaticResource SnapwellRowsBorderStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock l:Loc.Uid="Grid_ColumnsTitle" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock l:Loc.Uid="Grid_ColumnsDescription" Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <NumberBox l:Loc.Uid="Grid_ColumnsBox" x:Name="ColumnsBox" Grid.Column="1" Width="140" VerticalAlignment="Center"
                                   Minimum="1" Maximum="64" SmallChange="1" LargeChange="1"
                                   SpinButtonPlacementMode="Compact"
                                   ValueChanged="Grid_ValueChanged" ValidationMode="InvalidInputOverwritten" />
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock l:Loc.Uid="Grid_RowsTitle" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock l:Loc.Uid="Grid_RowsDescription" Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <NumberBox l:Loc.Uid="Grid_RowsBox" x:Name="RowsBox" Grid.Column="1" Width="140" VerticalAlignment="Center"
                                   Minimum="1" Maximum="64" SmallChange="1" LargeChange="1"
                                   SpinButtonPlacementMode="Compact"
                                   ValueChanged="Grid_ValueChanged" ValidationMode="InvalidInputOverwritten" />
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock l:Loc.Uid="Grid_GapPixelsTitle" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock l:Loc.Uid="Grid_GapPixelsDescription"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <NumberBox l:Loc.Uid="Grid_GapBox" x:Name="GapBox" Grid.Column="1" Width="140" VerticalAlignment="Center"
                                   Minimum="0" Maximum="200" SmallChange="1" LargeChange="10"
                                   SpinButtonPlacementMode="Compact"
                                   ValueChanged="Gap_ValueChanged" ValidationMode="InvalidInputOverwritten" />
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock l:Loc.Uid="Grid_EdgePixelsTitle" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock l:Loc.Uid="Grid_EdgePixelsDescription"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <NumberBox l:Loc.Uid="Grid_EdgeBox" x:Name="EdgeBox" Grid.Column="1" Width="140" VerticalAlignment="Center"
                                   Minimum="0" Maximum="200" SmallChange="1" LargeChange="10"
                                   SpinButtonPlacementMode="Compact"
                                   ValueChanged="Edge_ValueChanged" ValidationMode="InvalidInputOverwritten" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
