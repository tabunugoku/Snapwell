<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Snapwell.Settings.Pages.GridPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <Style x:Key="DemoSwitchStyle" TargetType="ToggleSwitch"
               BasedOn="{StaticResource SnapwellDemoSwitchStyle}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleSwitch">
                        <Grid Width="40" Height="20" Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="ToggleStates">
                                    <VisualState x:Name="Off" />
                                    <VisualState x:Name="On">
                                        <VisualState.Setters>
                                            <Setter
                                                Target="SwitchTrack.Background"
                                                Value="{ThemeResource SnapwellInkBrush}" />
                                            <Setter
                                                Target="SwitchTrack.BorderBrush"
                                                Value="{ThemeResource SnapwellInkBrush}" />
                                            <Setter
                                                Target="SwitchKnob.Fill"
                                                Value="{ThemeResource SnapwellInkTextBrush}" />
                                            <Setter Target="SwitchKnob.Margin" Value="23,0,0,0" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border
                                x:Name="SwitchTrack"
                                CornerRadius="9999"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource SnapwellMutedBrush}" />
                            <Ellipse
                                x:Name="SwitchKnob"
                                Width="12"
                                Height="12"
                                Margin="3,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource SnapwellMutedBrush}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DemoSelectStyle" TargetType="ComboBox"
               BasedOn="{StaticResource SnapwellDemoSelectStyle}">
            <Setter Property="FontFamily" Value="{StaticResource SnapwellUiFontFamily}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{ThemeResource SnapwellSurfaceBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource SnapwellTextBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SnapwellBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ChipButtonStyle" TargetType="Button" BasedOn="{StaticResource SnapwellButtonStyle}">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="SelectedChipButtonStyle" TargetType="Button" BasedOn="{StaticResource SnapwellButtonStyle}">
            <Setter Property="Padding" Value="11,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource SnapwellInkBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SnapwellInkBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style x:Key="PreviewCellBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{ThemeResource SnapwellCellBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
        </Style>
        <Style x:Key="PreviewWindowBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SnapwellSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SnapwellBorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style x:Key="PreviewWindowLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource SnapwellMonoFontFamily}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{ThemeResource SnapwellMutedBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Editor" Padding="32,28,32,40" HorizontalAlignment="Stretch">
            <TextBlock Text="分割と間隔" Style="{StaticResource SnapwellPageTitleStyle}" />
            <TextBlock Text="いまは全モニター共通の分割案です。1 区画が基本単位で、ウィンドウのサイズはその整数倍になります。"
                       Style="{StaticResource SnapwellLeadTextStyle}" />

            <!-- デモ状態 (未実装) -->
            <Border Style="{StaticResource SnapwellRowsBorderStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <Grid ColumnSpacing="6" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="モニター" Style="{StaticResource SnapwellRowTitleStyle}" />
                                <Border Grid.Column="1" Style="{StaticResource SnapwellPendingTagStyle}">
                                    <TextBlock Text="準備中" Style="{StaticResource SnapwellPendingTagTextStyle}" />
                                </Border>
                            </Grid>
                            <TextBlock Text="いまは全モニター共通の設定です"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ComboBox IsEnabled="False"
                                Width="260"
                                Style="{StaticResource DemoSelectStyle}"
                                SelectedIndex="0"
                                AutomationProperties.Name="1 · 2560 × 1440 · 150%（メイン）">
                                <ComboBoxItem Content="1 · 2560 × 1440 · 150%（メイン）" />
                                <ComboBoxItem Content="2 · 1920 × 1080 · 100%" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <!-- デモ状態 (未実装) ここまで -->
            <ComboBox x:Name="PlanBox" Header="分割案" HorizontalAlignment="Stretch" Visibility="Collapsed"
                      SelectionChanged="Plan_SelectionChanged">
                <ComboBoxItem Content="8 × 8" />
                <ComboBoxItem Content="12 × 6" />
                <ComboBoxItem Content="6 × 4" />
                <ComboBoxItem Content="カスタム" />
            </ComboBox>

            <TextBlock Text="分割案" Style="{StaticResource SnapwellGroupTitleStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button x:Name="Chip8x8" Content="8 × 8" Tag="8,8" Click="Chip_Click"
                        Style="{StaticResource ChipButtonStyle}" />
                <Button x:Name="Chip12x6" Content="12 × 6" Tag="12,6" Click="Chip_Click"
                        Style="{StaticResource ChipButtonStyle}" />
                <Button x:Name="Chip6x4" Content="6 × 4" Tag="6,4" Click="Chip_Click"
                        Style="{StaticResource ChipButtonStyle}" />
                <Button x:Name="Chip4x4" Content="4 × 4" Tag="4,4" Click="Chip_Click"
                        Style="{StaticResource ChipButtonStyle}" />
                <Button x:Name="Chip16x9" Content="16 × 9" Tag="16,9" Click="Chip_Click"
                        Style="{StaticResource ChipButtonStyle}" />
                <Button x:Name="ChipCustom" Content="カスタム…" IsHitTestVisible="False" Opacity="0.55"
                        Style="{StaticResource ChipButtonStyle}" />
            </StackPanel>

            <Grid ColumnSpacing="20" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <Border x:Name="PreviewHost" Background="{ThemeResource SnapwellWallBrush}"
                        BorderBrush="{ThemeResource SnapwellBorderBrush}" BorderThickness="1"
                        CornerRadius="8" VerticalAlignment="Top" SizeChanged="PreviewHost_SizeChanged">
                    <Canvas x:Name="PreviewCanvas" Height="260" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="14">
                    <StackPanel Spacing="6">
                        <TextBlock Text="ウィンドウの間隔" Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="GapSlider" Minimum="0" Maximum="32" StepFrequency="1"
                                    VerticalAlignment="Center" AutomationProperties.Name="ウィンドウの間隔"
                                    ValueChanged="GapSlider_ValueChanged" />
                            <TextBlock x:Name="GapOutputText" Grid.Column="1"
                                       Style="{StaticResource SnapwellMonoTextStyle}"
                                       HorizontalTextAlignment="End" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="画面端の余白" Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="EdgeSlider" Minimum="0" Maximum="32" StepFrequency="1"
                                    VerticalAlignment="Center" AutomationProperties.Name="画面端の余白"
                                    ValueChanged="EdgeSlider_ValueChanged" />
                            <TextBlock x:Name="EdgeOutputText" Grid.Column="1"
                                       Style="{StaticResource SnapwellMonoTextStyle}"
                                       HorizontalTextAlignment="End" VerticalAlignment="Center" />
                        </Grid>
                        <CheckBox x:Name="LinkEdgeCheck" Content="間隔と同じにする" FontSize="14"
                                  Foreground="{ThemeResource SnapwellTextBrush}" MinWidth="0"
                                  Checked="LinkEdge_Changed" Unchecked="LinkEdge_Changed" />
                    </StackPanel>
                    <Border Background="{ThemeResource SnapwellSurface2Brush}"
                            BorderBrush="{ThemeResource SnapwellBorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="14,12">
                        <TextBlock x:Name="FormulaText" Style="{StaticResource SnapwellMonoTextStyle}"
                                   LineHeight="20.4" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Grid>

            <!-- デモ状態 (未実装) -->
            <TextBlock Text="区画単位のサイズ変更" Style="{StaticResource SnapwellGroupTitleStyle}" />
            <Border Style="{StaticResource SnapwellRowsBorderStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <Grid ColumnSpacing="6" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="1 回の拡大・縮小の幅" Style="{StaticResource SnapwellRowTitleStyle}" />
                                <Border Grid.Column="1" Style="{StaticResource SnapwellPendingTagStyle}">
                                    <TextBlock Text="準備中" Style="{StaticResource SnapwellPendingTagTextStyle}" />
                                </Border>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ComboBox IsEnabled="False"
                                Width="160"
                                Style="{StaticResource DemoSelectStyle}"
                                SelectedIndex="0"
                                AutomationProperties.Name="1 区画">
                                <ComboBoxItem Content="1 区画" />
                                <ComboBoxItem Content="2 区画" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <Grid ColumnSpacing="6" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="固定する位置" Style="{StaticResource SnapwellRowTitleStyle}" />
                                <Border Grid.Column="1" Style="{StaticResource SnapwellPendingTagStyle}">
                                    <TextBlock Text="準備中" Style="{StaticResource SnapwellPendingTagTextStyle}" />
                                </Border>
                            </Grid>
                            <TextBlock Text="拡大・縮小するときに動かさない辺" Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ComboBox IsEnabled="False"
                                Width="160"
                                Style="{StaticResource DemoSelectStyle}"
                                SelectedIndex="0"
                                AutomationProperties.Name="左上">
                                <ComboBoxItem Content="左上" />
                                <ComboBoxItem Content="中心" />
                                <ComboBoxItem Content="近い辺" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <Grid ColumnSpacing="6" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="手動でリサイズしたら区画に揃える" Style="{StaticResource SnapwellRowTitleStyle}" />
                                <Border Grid.Column="1" Style="{StaticResource SnapwellPendingTagStyle}">
                                    <TextBlock Text="準備中" Style="{StaticResource SnapwellPendingTagTextStyle}" />
                                </Border>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ToggleSwitch IsEnabled="False"
                                Style="{StaticResource DemoSwitchStyle}"
                                IsOn="False"
                                AutomationProperties.Name="区画に揃える" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock
                Text="見た目の枠（DWMWA_EXTENDED_FRAME_BOUNDS）で計算するため、間隔 0 でも隙間はできません。"
                Style="{StaticResource SnapwellHintTextStyle}"
                Margin="0,10,0,0" />
            <!-- デモ状態 (未実装) ここまで -->
            <TextBlock Text="数値での指定" Style="{StaticResource SnapwellGroupTitleStyle}" />
            <Border Style="{StaticResource SnapwellRowsBorderStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="列数" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock Text="横方向の区画数 (1〜64)" Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <NumberBox x:Name="ColumnsBox" Grid.Column="1" Width="140" VerticalAlignment="Center"
                                   Minimum="1" Maximum="64" SmallChange="1" LargeChange="1"
                                   SpinButtonPlacementMode="Compact" AutomationProperties.Name="列数"
                                   ValueChanged="Grid_ValueChanged" ValidationMode="InvalidInputOverwritten" />
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="行数" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock Text="縦方向の区画数 (1〜64)" Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <NumberBox x:Name="RowsBox" Grid.Column="1" Width="140" VerticalAlignment="Center"
                                   Minimum="1" Maximum="64" SmallChange="1" LargeChange="1"
                                   SpinButtonPlacementMode="Compact" AutomationProperties.Name="行数"
                                   ValueChanged="Grid_ValueChanged" ValidationMode="InvalidInputOverwritten" />
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ウィンドウの間隔 (px)" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock Text="隣り合う区画の間の隙間 (0〜200 px)"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <NumberBox x:Name="GapBox" Grid.Column="1" Width="140" VerticalAlignment="Center"
                                   Minimum="0" Maximum="200" SmallChange="1" LargeChange="10"
                                   SpinButtonPlacementMode="Compact" AutomationProperties.Name="ウィンドウの間隔 (px)"
                                   ValueChanged="Gap_ValueChanged" ValidationMode="InvalidInputOverwritten" />
                    </Grid>
                    <Border Style="{StaticResource SnapwellRowDividerStyle}" />
                    <Grid Style="{StaticResource SnapwellRowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="画面端の余白 (px)" Style="{StaticResource SnapwellRowTitleStyle}" />
                            <TextBlock Text="モニターの作業領域の外周の余白 (0〜200 px)"
                                       Style="{StaticResource SnapwellRowDescriptionStyle}" />
                        </StackPanel>
                        <NumberBox x:Name="EdgeBox" Grid.Column="1" Width="140" VerticalAlignment="Center"
                                   Minimum="0" Maximum="200" SmallChange="1" LargeChange="10"
                                   SpinButtonPlacementMode="Compact" AutomationProperties.Name="画面端の余白 (px)"
                                   ValueChanged="Edge_ValueChanged" ValidationMode="InvalidInputOverwritten" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
