<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Snapwell.Settings.Pages.GridPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Editor" Padding="28,16,28,32" Spacing="20" MaxWidth="820"
                    HorizontalAlignment="Stretch">
            <TextBlock Text="分割と間隔" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="1 区画が基本単位で、ウィンドウのサイズはその整数倍になります。"
                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ComboBox x:Name="PlanBox" Header="分割案" HorizontalAlignment="Stretch"
                      SelectionChanged="Plan_SelectionChanged">
                <ComboBoxItem Content="8 × 8" />
                <ComboBoxItem Content="12 × 6" />
                <ComboBoxItem Content="6 × 4" />
                <ComboBoxItem Content="カスタム" />
            </ComboBox>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <NumberBox x:Name="ColumnsBox" Header="列数" Minimum="1" Maximum="64"
                           SmallChange="1" LargeChange="1" SpinButtonPlacementMode="Compact"
                           ValueChanged="Grid_ValueChanged" ValidationMode="InvalidInputOverwritten" />
                <NumberBox x:Name="RowsBox" Grid.Column="1" Header="行数" Minimum="1" Maximum="64"
                           SmallChange="1" LargeChange="1" SpinButtonPlacementMode="Compact"
                           ValueChanged="Grid_ValueChanged" ValidationMode="InvalidInputOverwritten" />
            </Grid>
            <NumberBox x:Name="GapBox" Header="ウィンドウの間隔 (px)" Minimum="0" Maximum="200"
                       SmallChange="1" LargeChange="10" SpinButtonPlacementMode="Compact"
                       ValueChanged="Gap_ValueChanged" ValidationMode="InvalidInputOverwritten" />
            <NumberBox x:Name="EdgeBox" Header="画面端の余白 (px)" Minimum="0" Maximum="200"
                       SmallChange="1" LargeChange="10" SpinButtonPlacementMode="Compact"
                       ValueChanged="Edge_ValueChanged" ValidationMode="InvalidInputOverwritten" />
            <TextBlock Text="列数・行数は 1〜64、間隔・余白は 0〜200 px で指定できます。間隔と余白はモニターの DPI に合わせて換算されます。"
                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
