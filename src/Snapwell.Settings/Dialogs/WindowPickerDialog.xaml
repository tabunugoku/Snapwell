<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Snapwell.Settings.Dialogs.WindowPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:l="using:Snapwell.Settings.Localization"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    l:Loc.Uid="WindowPicker_Dialog" DefaultButton="Close"
    CornerRadius="8">
    <ContentDialog.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Dialogs/DialogResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <Style x:Key="PickRowStyle" TargetType="Button" BasedOn="{StaticResource SnapwellButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{ThemeResource SnapwellBorderBrush}" />
            <Setter Property="Background" Value="{ThemeResource SnapwellSurfaceBrush}" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style x:Key="PickWarningStyle" TargetType="TextBlock" BasedOn="{StaticResource SnapwellHintTextStyle}">
            <Setter Property="Foreground" Value="{ThemeResource SnapwellYellowTextBrush}" />
        </Style>
        </ResourceDictionary>
    </ContentDialog.Resources>
    <StackPanel Spacing="12" Width="440">
        <TextBlock l:Loc.Uid="WindowPicker_Lead"
                   Style="{StaticResource SnapwellHintTextStyle}" />
        <Border Style="{StaticResource SnapwellRowsBorderStyle}">
            <ScrollViewer MaxHeight="360" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="WindowRows" />
            </ScrollViewer>
        </Border>
        <TextBlock x:Name="EmptyHint" l:Loc.Uid="WindowPicker_EmptyHint"
                   Style="{StaticResource SnapwellHintTextStyle}" />
    </StackPanel>
</ContentDialog>
