<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Snapwell.Settings.Dialogs.RuleDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:l="using:Snapwell.Settings.Localization"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    l:Loc.Uid="Rule_Dialog" CornerRadius="8"
    DefaultButton="Primary" IsPrimaryButtonEnabled="False">
    <ContentDialog.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Dialogs/DialogResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Header は入力欄と一組なので、標準テンプレートのラベル下の余白だけをそろえる。 -->
            <Thickness x:Key="TextBoxTopHeaderMargin">0,0,0,4</Thickness>
            <Thickness x:Key="ComboBoxTopHeaderMargin">0,0,0,4</Thickness>
            <DataTemplate x:Key="RuleHeaderTemplate">
                <TextBlock Text="{Binding}" FontSize="13" LineHeight="20"
                           FontFamily="{ThemeResource SnapwellUiFontFamily}"
                           Foreground="{ThemeResource SnapwellInkBrush}" TextWrapping="Wrap" />
            </DataTemplate>
            <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="HeaderTemplate" Value="{StaticResource RuleHeaderTemplate}" />
            </Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="HeaderTemplate" Value="{StaticResource RuleHeaderTemplate}" />
            </Style>
        </ResourceDictionary>
    </ContentDialog.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Width="440">
            <TextBlock l:Loc.Uid="Rule_Lead"
                       Style="{StaticResource SnapwellHintTextStyle}" />
            <TextBlock x:Name="UwpNotice" Visibility="Collapsed" TextWrapping="Wrap"
                       l:Loc.Uid="Rule_UwpNotice"
                       Style="{StaticResource SnapwellHintTextStyle}"
                       Foreground="{ThemeResource SnapwellYellowTextBrush}" />
            <TextBox x:Name="ProcessBox" l:Loc.Uid="Rule_ProcessBox" PlaceholderText="chrome.exe"
                     FontFamily="{StaticResource SnapwellMonoFontFamily}"
                     TextChanged="Input_Changed" />
            <TextBox x:Name="ClassBox" l:Loc.Uid="Rule_ClassBox" PlaceholderText="Chrome_WidgetWin_1"
                     FontFamily="{StaticResource SnapwellMonoFontFamily}"
                     TextChanged="Input_Changed" />
            <TextBox x:Name="TitleBox" l:Loc.Uid="Rule_TitleBox"
                     FontFamily="{StaticResource SnapwellMonoFontFamily}"
                     TextChanged="Input_Changed" />
            <TextBlock x:Name="ErrorText" Foreground="{ThemeResource SnapwellRedTextBrush}" TextWrapping="Wrap" MinHeight="40"
                       Style="{StaticResource SnapwellHintTextStyle}"
                       AutomationProperties.LiveSetting="Polite" />
            <StackPanel Spacing="4">
                <ComboBox x:Name="PlacementBox" l:Loc.Uid="Rule_PlacementBox" HorizontalAlignment="Stretch"
                         SelectionChanged="Placement_Changed">
                    <ComboBoxItem />
                    <ComboBoxItem />
                    <ComboBoxItem />
                    <ComboBoxItem />
                </ComboBox>
                <TextBlock x:Name="PlacementHint" Style="{StaticResource SnapwellHintTextStyle}" TextWrapping="Wrap" />
            </StackPanel>
            <ComboBox x:Name="CornerBox" l:Loc.Uid="Rule_CornerBox" HorizontalAlignment="Stretch"
                      SelectionChanged="Corner_Changed">
                <ComboBoxItem />
                <ComboBoxItem />
                <ComboBoxItem />
                <ComboBoxItem />
                <ComboBoxItem />
            </ComboBox>
            <TextBlock x:Name="MatchText" Style="{StaticResource SnapwellHintTextStyle}" TextWrapping="Wrap" MinHeight="20"
                       AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
