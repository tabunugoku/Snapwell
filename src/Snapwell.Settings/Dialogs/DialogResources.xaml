<?xml version="1.0" encoding="utf-8"?>
<!-- ダイアログの中の標準コントロールに、Windows の強調色（水色）ではなく Snapwell の色を使わせる。
     App.xaml の上書きはダイアログの中まで届かないことを実機で確認したため、ダイアログ側にも同じ値を置く（背景・枠も同様。実機未確認）。 -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <CornerRadius x:Key="ContentDialogCornerRadius">8</CornerRadius>
    <Thickness x:Key="ContentDialogPadding">24</Thickness>
    <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
    <x:Double x:Key="ContentDialogButtonHeight">32</x:Double>
    <x:Double x:Key="ContentDialogButtonMinHeight">32</x:Double>
    <x:Double x:Key="ContentDialogButtonMinWidth">80</x:Double>
    <DataTemplate x:Key="SnapwellDialogTitleTemplate">
        <TextBlock Text="{Binding}" Style="{StaticResource SnapwellSubtitleTextStyle}" TextWrapping="Wrap" />
    </DataTemplate>
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!-- ダイアログ内で上書きが必要な標準コントロール用。別ファイルのテーマ辞書を静的に参照しない。 -->
            <SolidColorBrush x:Key="SnapwellInkBrush" Color="#FF1C1C1B" />
            <SolidColorBrush x:Key="SnapwellInkHoverBrush" Color="#FF3A3A38" />
            <SolidColorBrush x:Key="SnapwellInkTextBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SnapwellBorderStrongBrush" Color="#2E1C1C1B" />
            <SolidColorBrush x:Key="SnapwellSurfaceBrush" Color="#FFFFFFFF" />
            <StaticResource x:Key="ContentDialogBackground" ResourceKey="SnapwellSurfaceBrush" />
            <StaticResource x:Key="ContentDialogBorderBrush" ResourceKey="SnapwellBorderStrongBrush" />
            <StaticResource x:Key="AccentFillColorDefaultBrush" ResourceKey="SnapwellInkBrush" />
            <StaticResource x:Key="AccentFillColorSecondaryBrush" ResourceKey="SnapwellInkHoverBrush" />
            <StaticResource x:Key="AccentFillColorTertiaryBrush" ResourceKey="SnapwellInkHoverBrush" />
            <StaticResource x:Key="TextOnAccentFillColorPrimaryBrush" ResourceKey="SnapwellInkTextBrush" />
            <StaticResource x:Key="AccentButtonBackground" ResourceKey="SnapwellInkBrush" />
            <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="SnapwellInkHoverBrush" />
            <StaticResource x:Key="AccentButtonBackgroundPressed" ResourceKey="SnapwellInkHoverBrush" />
            <StaticResource x:Key="AccentButtonForeground" ResourceKey="SnapwellInkTextBrush" />
            <StaticResource x:Key="AccentButtonForegroundPointerOver" ResourceKey="SnapwellInkTextBrush" />
            <StaticResource x:Key="AccentButtonForegroundPressed" ResourceKey="SnapwellInkTextBrush" />
            <StaticResource x:Key="AccentButtonBorderBrush" ResourceKey="SnapwellInkBrush" />
            <StaticResource x:Key="AccentButtonBorderBrushPointerOver" ResourceKey="SnapwellInkHoverBrush" />
            <StaticResource x:Key="AccentButtonBorderBrushPressed" ResourceKey="SnapwellInkHoverBrush" />
            <StaticResource x:Key="RadioButtonOuterEllipseCheckedStroke" ResourceKey="SnapwellInkBrush" />
            <StaticResource x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" ResourceKey="SnapwellInkHoverBrush" />
            <StaticResource x:Key="RadioButtonOuterEllipseCheckedStrokePressed" ResourceKey="SnapwellInkHoverBrush" />
            <StaticResource x:Key="RadioButtonOuterEllipseCheckedFill" ResourceKey="SnapwellInkBrush" />
            <StaticResource x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" ResourceKey="SnapwellInkHoverBrush" />
            <StaticResource x:Key="RadioButtonOuterEllipseCheckedFillPressed" ResourceKey="SnapwellInkHoverBrush" />
            <StaticResource x:Key="RadioButtonCheckGlyphFill" ResourceKey="SnapwellInkTextBrush" />
            <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="SnapwellBorderStrongBrush" />
            <StaticResource x:Key="ComboBoxBorderBrushFocused" ResourceKey="SnapwellBorderStrongBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <!-- ダイアログ内で上書きが必要な標準コントロール用。別ファイルのテーマ辞書を静的に参照しない。 -->
            <SolidColorBrush x:Key="SnapwellInkBrush" Color="#FFEDEDEB" />
            <SolidColorBrush x:Key="SnapwellInkHoverBrush" Color="#FFD2D2CF" />
            <SolidColorBrush x:Key="SnapwellInkTextBrush" Color="#FF161616" />
            <SolidColorBrush x:Key="SnapwellBorderStrongBrush" Color="#26FFFFFF" />
            <SolidColorBrush x:Key="SnapwellSurfaceBrush" Color="#FF222221" />
            <StaticResource x:Key="ContentDialogBackground" ResourceKey="SnapwellSurfaceBrush" />
            <StaticResource x:Key="ContentDialogBorderBrush" ResourceKey="SnapwellBorderStrongBrush" />
            <StaticResource x:Key="AccentFillColorDefaultBrush" ResourceKey="SnapwellInkBrush" />
            <StaticResource x:Key="AccentFillColorSecondaryBrush" ResourceKey="SnapwellInkHoverBrush" />
            <StaticResource x:Key="AccentFillColorTertiaryBrush" ResourceKey="SnapwellInkHoverBrush" />
            <StaticResource x:Key="TextOnAccentFillColorPrimaryBrush" ResourceKey="SnapwellInkTextBrush" />
            <StaticResource x:Key="AccentButtonBackground" ResourceKey="SnapwellInkBrush" />
            <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="SnapwellInkHoverBrush" />
            <StaticResource x:Key="AccentButtonBackgroundPressed" ResourceKey="SnapwellInkHoverBrush" />
            <StaticResource x:Key="AccentButtonForeground" ResourceKey="SnapwellInkTextBrush" />
            <StaticResource x:Key="AccentButtonForegroundPointerOver" ResourceKey="SnapwellInkTextBrush" />
            <StaticResource x:Key="AccentButtonForegroundPressed" ResourceKey="SnapwellInkTextBrush" />
            <StaticResource x:Key="AccentButtonBorderBrush" ResourceKey="SnapwellInkBrush" />
            <StaticResource x:Key="AccentButtonBorderBrushPointerOver" ResourceKey="SnapwellInkHoverBrush" />
            <StaticResource x:Key="AccentButtonBorderBrushPressed" ResourceKey="SnapwellInkHoverBrush" />
            <StaticResource x:Key="RadioButtonOuterEllipseCheckedStroke" ResourceKey="SnapwellInkBrush" />
            <StaticResource x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" ResourceKey="SnapwellInkHoverBrush" />
            <StaticResource x:Key="RadioButtonOuterEllipseCheckedStrokePressed" ResourceKey="SnapwellInkHoverBrush" />
            <StaticResource x:Key="RadioButtonOuterEllipseCheckedFill" ResourceKey="SnapwellInkBrush" />
            <StaticResource x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" ResourceKey="SnapwellInkHoverBrush" />
            <StaticResource x:Key="RadioButtonOuterEllipseCheckedFillPressed" ResourceKey="SnapwellInkHoverBrush" />
            <StaticResource x:Key="RadioButtonCheckGlyphFill" ResourceKey="SnapwellInkTextBrush" />
            <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="SnapwellBorderStrongBrush" />
            <StaticResource x:Key="ComboBoxBorderBrushFocused" ResourceKey="SnapwellBorderStrongBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <!-- ダイアログ内で上書きが必要な標準コントロール用。別ファイルのテーマ辞書を静的に参照しない。 -->
            <SolidColorBrush x:Key="SnapwellInkBrush" Color="#FFEDEDEB" />
            <SolidColorBrush x:Key="SnapwellInkHoverBrush" Color="#FFD2D2CF" />
            <SolidColorBrush x:Key="SnapwellInkTextBrush" Color="#FF161616" />
            <SolidColorBrush x:Key="SnapwellBorderStrongBrush" Color="#26FFFFFF" />
            <SolidColorBrush x:Key="SnapwellSurfaceBrush" Color="#FF222221" />
            <StaticResource x:Key="ContentDialogBackground" ResourceKey="SnapwellSurfaceBrush" />
            <StaticResource x:Key="ContentDialogBorderBrush" ResourceKey="SnapwellBorderStrongBrush" />
            <StaticResource x:Key="AccentFillColorDefaultBrush" ResourceKey="SnapwellInkBrush" />
            <StaticResource x:Key="AccentFillColorSecondaryBrush" ResourceKey="SnapwellInkHoverBrush" />
            <StaticResource x:Key="AccentFillColorTertiaryBrush" ResourceKey="SnapwellInkHoverBrush" />
            <StaticResource x:Key="TextOnAccentFillColorPrimaryBrush" ResourceKey="SnapwellInkTextBrush" />
            <StaticResource x:Key="AccentButtonBackground" ResourceKey="SnapwellInkBrush" />
            <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="SnapwellInkHoverBrush" />
            <StaticResource x:Key="AccentButtonBackgroundPressed" ResourceKey="SnapwellInkHoverBrush" />
            <StaticResource x:Key="AccentButtonForeground" ResourceKey="SnapwellInkTextBrush" />
            <StaticResource x:Key="AccentButtonForegroundPointerOver" ResourceKey="SnapwellInkTextBrush" />
            <StaticResource x:Key="AccentButtonForegroundPressed" ResourceKey="SnapwellInkTextBrush" />
            <StaticResource x:Key="AccentButtonBorderBrush" ResourceKey="SnapwellInkBrush" />
            <StaticResource x:Key="AccentButtonBorderBrushPointerOver" ResourceKey="SnapwellInkHoverBrush" />
            <StaticResource x:Key="AccentButtonBorderBrushPressed" ResourceKey="SnapwellInkHoverBrush" />
            <StaticResource x:Key="RadioButtonOuterEllipseCheckedStroke" ResourceKey="SnapwellInkBrush" />
            <StaticResource x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" ResourceKey="SnapwellInkHoverBrush" />
            <StaticResource x:Key="RadioButtonOuterEllipseCheckedStrokePressed" ResourceKey="SnapwellInkHoverBrush" />
            <StaticResource x:Key="RadioButtonOuterEllipseCheckedFill" ResourceKey="SnapwellInkBrush" />
            <StaticResource x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" ResourceKey="SnapwellInkHoverBrush" />
            <StaticResource x:Key="RadioButtonOuterEllipseCheckedFillPressed" ResourceKey="SnapwellInkHoverBrush" />
            <StaticResource x:Key="RadioButtonCheckGlyphFill" ResourceKey="SnapwellInkTextBrush" />
            <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="SnapwellBorderStrongBrush" />
            <StaticResource x:Key="ComboBoxBorderBrushFocused" ResourceKey="SnapwellBorderStrongBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
