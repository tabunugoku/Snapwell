                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#FFD9D9D6" />
                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FF111111" />
                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#FF111111" />
                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#FF111111" />

                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#FF252524" />
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#FF252524" />
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="NavigationViewItemBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#FF202020" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#FF202020" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#FF202020" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#FF202020" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#FF202020" />
                    <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#FFE6E6E3" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#FFE6E6E3" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#FFE6E6E3" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FFE6E6E3" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#FFE6E6E3" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#FFE6E6E3" />
                    <SolidColorBrush x:Key="NavigationViewItemBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewItemBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewItemBorderBrushPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewItemBorderBrushSelected" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="NavigationViewItemBorderBrushSelectedPointerOver" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="NavigationViewItemBorderBrushSelectedPressed" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#FFF2F2F0" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable Text, Segoe UI Variable, Yu Gothic UI</FontFamily>
            <FontFamily x:Key="SnapwellUiFontFamily">Segoe UI Variable Text, Segoe UI Variable, Yu Gothic UI</FontFamily>
            <FontFamily x:Key="SnapwellDisplayFontFamily">Yu Mincho</FontFamily>
            <FontFamily x:Key="SnapwellMonoFontFamily">Cascadia Mono, Consolas</FontFamily>

            <!-- モックアップの h3 (Yu Mincho 26px, weight 500, letter-spacing -0.02em) -->
            <Style x:Key="SnapwellPageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource SnapwellDisplayFontFamily}" />
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="CharacterSpacing" Value="-20" />
                <Setter Property="LineHeight" Value="41.6" />
                <Setter Property="Foreground" Value="{ThemeResource SnapwellInkBrush}" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <!-- モックアップの等幅フォント (Cascadia Mono, 12px) -->
            <Style x:Key="SnapwellMonoTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource SnapwellMonoFontFamily}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource SnapwellTextBrush}" />
            </Style>

            <Style x:Key="SnapwellLeadTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource SnapwellUiFontFamily}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="LineHeight" Value="22.4" />
                <Setter Property="Foreground" Value="{ThemeResource SnapwellMutedBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,0,0,20" />
            </Style>

            <Style x:Key="SnapwellGroupTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource SnapwellUiFontFamily}" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="LineHeight" Value="20" />
                <Setter Property="Foreground" Value="{ThemeResource SnapwellInkBrush}" />
                <Setter Property="Margin" Value="0,22,0,8" />
            </Style>

            <Style x:Key="SnapwellRowsBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SnapwellSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SnapwellBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <Style x:Key="SnapwellRowGridStyle" TargetType="Grid">
                <Setter Property="Background" Value="{ThemeResource SnapwellSurfaceBrush}" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="ColumnSpacing" Value="16" />
            </Style>

            <Style x:Key="SnapwellRowDividerStyle" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Background" Value="{ThemeResource SnapwellBorderBrush}" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>

            <Style x:Key="SnapwellRowTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource SnapwellUiFontFamily}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="LineHeight" Value="22.4" />
                <Setter Property="Foreground" Value="{ThemeResource SnapwellInkBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SnapwellRowDescriptionStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource SnapwellUiFontFamily}" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="LineHeight" Value="20" />
                <Setter Property="Foreground" Value="{ThemeResource SnapwellMutedBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SnapwellHintTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource SnapwellUiFontFamily}" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="LineHeight" Value="20" />
                <Setter Property="Foreground" Value="{ThemeResource SnapwellMutedBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- 未実装の行は中立色のタグで示し、要検証などの状態表示と区別する。 -->
            <Style x:Key="SnapwellPendingTagStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SnapwellSurface2Brush}" />
                <Setter Property="CornerRadius" Value="9999" />
                <Setter Property="Padding" Value="8,1" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SnapwellPendingTagTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource SnapwellUiFontFamily}" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="50" />
                <Setter Property="LineHeight" Value="16.8" />
                <Setter Property="Foreground" Value="{ThemeResource SnapwellMutedBrush}" />
            </Style>

            <!-- デモ専用。操作不可でもモックアップのスイッチの形を読み取れる薄さにする。 -->
            <Style x:Key="SnapwellDemoSwitchStyle" TargetType="ToggleSwitch">
                <Setter Property="Opacity" Value="0.65" />
            </Style>

            <!-- モックアップの .switch (40×20、つまみ 12 px、輪郭の二重線なし)。実設定のスイッチにも全ページで適用する。 -->
            <Style TargetType="ToggleSwitch">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="20" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ToggleSwitch">
                                <Grid Width="40" Height="20" Background="Transparent">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="ToggleStates">
                                            <VisualState x:Name="Off" />
                                            <VisualState x:Name="On">
                                                <VisualState.Setters>
                                                    <Setter
                                                        Target="SwitchTrack.Background"
                                                        Value="{ThemeResource SnapwellInkBrush}" />
                                                    <Setter
                                                        Target="SwitchTrack.BorderBrush"
                                                        Value="{ThemeResource SnapwellInkBrush}" />
                                                    <Setter Target="SwitchTrack.BorderThickness" Value="0" />
                                                    <Setter
                                                        Target="SwitchKnob.Fill"
                                                        Value="{ThemeResource SnapwellInkTextBrush}" />
                                                    <Setter Target="SwitchKnob.Margin" Value="23,0,0,0" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <Border
                                        x:Name="SwitchTrack"
                                        CornerRadius="9999"
                                        BorderThickness="1"
                                        BorderBrush="{ThemeResource SnapwellMutedBrush}" />
                                    <Ellipse
                                        x:Name="SwitchKnob"
                                        Width="12"
                                        Height="12"
                                        Margin="3,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Fill="{ThemeResource SnapwellMutedBrush}" />
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
            </Style>

            <Style x:Key="SnapwellDemoSelectStyle" TargetType="ComboBox">
                <Setter Property="Opacity" Value="0.85" />
            </Style>

            <Style x:Key="SnapwellButtonStyle" TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource SnapwellUiFontFamily}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Background" Value="{ThemeResource SnapwellSurfaceBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource SnapwellTextBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SnapwellBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="14,7" />
            </Style>

            <Style x:Key="SnapwellDemoButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource SnapwellButtonStyle}">
                <Setter Property="Opacity" Value="0.85" />
            </Style>

            <Style x:Key="SnapwellPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="FontFamily" Value="{StaticResource SnapwellUiFontFamily}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Background" Value="{ThemeResource SnapwellInkBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource SnapwellInkTextBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SnapwellInkBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="14,7" />
            </Style>

            <Style x:Key="SnapwellNavIconPathStyle" TargetType="Path">
                <Setter Property="Width" Value="16" />
                <Setter Property="Height" Value="16" />
                <Setter Property="Stroke" Value="{ThemeResource SnapwellMutedBrush}" />
                <Setter Property="StrokeThickness" Value="1.5" />
                <Setter Property="StrokeStartLineCap" Value="Round" />
                <Setter Property="StrokeEndLineCap" Value="Round" />
                <Setter Property="StrokeLineJoin" Value="Round" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
