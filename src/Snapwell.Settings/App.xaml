            <!-- .switch のつまみは枠の内側から 3 px、外形からは 4 px に置く。 -->
            <Style x:Key="SnapwellToggleSwitchStyle" TargetType="ToggleSwitch">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="20" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="OnContent" Value="" />
                <Setter Property="OffContent" Value="" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualMargin" Value="-2" />
                <Setter Property="FocusVisualPrimaryThickness" Value="2" />
                <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource SnapwellBlueTextBrush}" />
                <Setter Property="controls:SpringToggle.Enabled" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleSwitch">
                            <Grid x:Name="LayoutRoot" Width="40" Height="20" Background="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver" />
                                        <VisualState x:Name="Pressed" />
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                    <!-- つまみの位置・塗り・伸びは SpringToggle が毎フレーム書く。状態では動かさない。 -->
                                    <VisualStateGroup x:Name="ToggleStates">
                                        <VisualState x:Name="Off" />
                                        <VisualState x:Name="On" />
                                        <VisualState x:Name="Dragging" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border
                                    x:Name="TrackBorder"
                                    Width="40"
                                    Height="20"
                                    CornerRadius="10"
                                    Background="Transparent"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource SnapwellMutedBrush}" />
                                <!-- オンの塗りは位置から決めた不透明度で重ねる（トラックの線は逆に薄くする）。 -->
                                <Border
                                    x:Name="TrackFill"
                                    Width="40"
                                    Height="20"
                                    CornerRadius="10"
                                    Opacity="0"
                                    Background="{ThemeResource SnapwellInkBrush}" />
                                <Grid x:Name="SwitchKnobBounds" Width="40" Height="20">
                                    <Grid.RenderTransform>
                                        <TranslateTransform x:Name="BoundsTranslateTransform" />
                                    </Grid.RenderTransform>
                                    <!-- 可動幅は 40 - 12 - 4 - 4 = 20。位置は SpringToggle がばねで動かす。 -->
                                    <Grid
                                        x:Name="SwitchKnob"
                                        Width="12"
                                        Height="12"
                                        Margin="4,4,4,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top">
                                        <Grid.RenderTransform>
                                            <CompositeTransform CenterX="6" CenterY="6" />
                                        </Grid.RenderTransform>
                                        <Ellipse
                                            x:Name="ThumbEllipse"
                                            Width="12"
                                            Height="12"
                                            Fill="{ThemeResource SnapwellMutedBrush}" />
                                        <Ellipse
                                            x:Name="ThumbOnEllipse"
                                            Width="12"
                                            Height="12"
                                            Opacity="0"
                                            Fill="{ThemeResource SnapwellInkTextBrush}" />
                                    </Grid>
                                </Grid>
                                <!-- Thumb は ToggleSwitch の部品として残すだけで、入力は SpringToggle が LayoutRoot で受ける。 -->
                                <Thumb
                                    x:Name="SwitchThumb"
                                    Width="40"
                                    Height="20"
                                    IsTabStop="False"
                                    AutomationProperties.AccessibilityView="Raw">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Background="Transparent" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="FocusVisualSecondaryBrush" Value="Transparent" />
            </Style>

