            <!-- モックアップの .switch (40×20、完全な丸み CornerRadius 10、つまみ 12 px、オフ時 Margin 3,3、オン時 Margin 23,3、輪郭の二重線なし)。 -->
            <Style x:Key="SnapwellToggleSwitchStyle" TargetType="ToggleSwitch">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="20" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="OnContent" Value="" />
                <Setter Property="OffContent" Value="" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualMargin" Value="-2" />
                <Setter Property="FocusVisualPrimaryThickness" Value="2" />
                <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource SnapwellBlueTextBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleSwitch">
                            <Grid x:Name="LayoutRoot" Width="40" Height="20" Background="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver" />
                                        <VisualState x:Name="Pressed" />
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="ToggleStates">
                                        <VisualState x:Name="Off">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    x:Name="SwitchKnobOff"
                                                    Storyboard.TargetName="KnobTranslateTransform"
                                                    Storyboard.TargetProperty="X"
                                                    To="0"
                                                    Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="On">
                                            <VisualState.Setters>
                                                <Setter
                                                    Target="TrackBorder.Background"
                                                    Value="{ThemeResource SnapwellInkBrush}" />
                                                <Setter
                                                    Target="TrackBorder.BorderBrush"
                                                    Value="{ThemeResource SnapwellInkBrush}" />
                                                <Setter Target="TrackBorder.BorderThickness" Value="0" />
                                                <Setter
                                                    Target="ThumbEllipse.Fill"
                                                    Value="{ThemeResource SnapwellInkTextBrush}" />
                                            </VisualState.Setters>
                                            <Storyboard>
                                                <DoubleAnimation
                                                    x:Name="SwitchKnobOn"
                                                    Storyboard.TargetName="KnobTranslateTransform"
                                                    Storyboard.TargetProperty="X"
                                                    To="20"
                                                    Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Dragging" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border
                                    x:Name="TrackBorder"
                                    Width="40"
                                    Height="20"
                                    CornerRadius="10"
                                    Background="Transparent"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource SnapwellMutedBrush}" />
                                <Grid x:Name="SwitchKnobBounds" Width="40" Height="20">
                                    <Grid.RenderTransform>
                                        <TranslateTransform x:Name="BoundsTranslateTransform" />
                                    </Grid.RenderTransform>
                                    <!-- 可動幅は 40 - 12 - 3 - 5 = 20。状態変更は補間せず即座に反映する。 -->
                                    <Grid
                                        x:Name="SwitchKnob"
                                        Width="12"
                                        Height="12"
                                        Margin="3,3,5,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top">
                                        <Grid.RenderTransform>
                                            <TranslateTransform x:Name="KnobTranslateTransform" />
                                        </Grid.RenderTransform>
                                        <Ellipse
                                            x:Name="ThumbEllipse"
                                            Width="12"
                                            Height="12"
                                            Fill="{ThemeResource SnapwellMutedBrush}" />
                                    </Grid>
                                </Grid>
                                <!-- 入力面は描画と分離し、トラック全体でタップとドラッグを受ける。 -->
                                <Thumb
                                    x:Name="SwitchThumb"
                                    Width="40"
                                    Height="20"
                                    IsTabStop="False"
                                    AutomationProperties.AccessibilityView="Raw">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Background="Transparent" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ToggleSwitch" BasedOn="{StaticResource SnapwellToggleSwitchStyle}" />

            <!-- デモ行も「準備中」タグと IsEnabled=False で示し、見た目はモックアップと同じ不透明度にする。 -->
