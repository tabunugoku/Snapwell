<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Snapwell.Settings.Controls.OsHowDiagram"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="DiagramText" TargetType="TextBlock" BasedOn="{StaticResource SnapwellHintTextStyle}" />
        <Style x:Key="DiagramHeading" TargetType="TextBlock" BasedOn="{StaticResource DiagramText}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource SnapwellInkBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="DiagramCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SnapwellSurface2Brush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SnapwellBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="DiagramAfterCard" TargetType="Border" BasedOn="{StaticResource DiagramCard}">
            <Setter Property="Background" Value="{ThemeResource SnapwellSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SnapwellBorderStrongBrush}" />
        </Style>
        <Style x:Key="DiagramScreen" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SnapwellBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SnapwellBorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style x:Key="DiagramWindow" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SnapwellSurface2Brush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SnapwellBorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style x:Key="DiagramTitleBar" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SnapwellSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SnapwellBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Height" Value="9" />
            <Setter Property="CornerRadius" Value="4,4,0,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="DiagramCaptionButton" TargetType="Border">
            <Setter Property="BorderBrush" Value="{ThemeResource SnapwellMutedBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="1" />
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="5" />
            <Setter Property="Margin" Value="0,1,2,0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="DiagramGhost" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SnapwellMutedBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SnapwellMutedBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <!-- 吸着先・予測の線・点は、外観ページの見え方の例と同じブラシにする。点線の間隔はコードで付ける。 -->
        <Style x:Key="DiagramZone" TargetType="Rectangle">
            <Setter Property="Fill" Value="{ThemeResource SnapwellBlueBackgroundBrush}" />
            <Setter Property="Stroke" Value="{ThemeResource SnapwellBlueLineBrush}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="RadiusX" Value="3" />
            <Setter Property="RadiusY" Value="3" />
        </Style>
        <Style x:Key="DiagramPredictionLine" TargetType="Line">
            <Setter Property="Stroke" Value="{ThemeResource SnapwellBlueTextBrush}" />
            <Setter Property="StrokeThickness" Value="1.5" />
        </Style>
        <Style x:Key="DiagramPredictionDot" TargetType="Ellipse">
            <Setter Property="Fill" Value="{ThemeResource SnapwellBlueTextBrush}" />
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
        </Style>
        <Style x:Key="DiagramThrowLine" TargetType="Line">
            <Setter Property="Stroke" Value="{ThemeResource SnapwellMutedBrush}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
        </Style>
        <Style x:Key="DiagramThrowHead" TargetType="Polyline">
            <Setter Property="Stroke" Value="{ThemeResource SnapwellMutedBrush}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
        <Style x:Key="DiagramFlyout" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SnapwellSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SnapwellBorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="3" />
        </Style>
        <Style x:Key="DiagramLayoutCell" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SnapwellBorderStrongBrush}" />
            <Setter Property="CornerRadius" Value="1" />
        </Style>
        <Style x:Key="DiagramSelectedCell" TargetType="Border" BasedOn="{StaticResource DiagramLayoutCell}">
            <Setter Property="Background" Value="{ThemeResource SnapwellBlueTextBrush}" />
        </Style>
        <Style x:Key="DiagramAppIcon" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SnapwellSurfaceBrush}" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Width" Value="4" />
            <Setter Property="Height" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <StackPanel Padding="16,4,16,12">
        <Button x:Name="Disclosure" Click="Disclosure_Click" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left" Padding="0,2,0,0" MinWidth="0" MinHeight="0"
                UseSystemFocusVisuals="True"
                AutomationProperties.Name="Windows の標準との違いを図で見る">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Padding="{TemplateBinding Padding}" />
                    </Border>
                </ControlTemplate>
            </Button.Template>
            <Grid ColumnSpacing="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="DisclosureGlyph" Text="▸" Style="{StaticResource DiagramText}" />
                <TextBlock Grid.Column="1" Text="Windows の標準との違いを図で見る"
                           Style="{StaticResource DiagramText}" />
            </Grid>
        </Button>
        <Grid x:Name="Comparison" Visibility="Collapsed" Margin="0,10,0,0" RowSpacing="12"
              SizeChanged="Comparison_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid x:Name="Cards" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="BeforeCard" Style="{StaticResource DiagramCard}">
                    <StackPanel>
                        <TextBlock x:Name="BeforeHeading" Text="Windows の標準"
                                   Style="{StaticResource DiagramHeading}" />
                        <ContentControl x:Name="BeforeDrawing" HorizontalContentAlignment="Stretch"
                                        IsTabStop="False" />
                        <TextBlock x:Name="BeforeText" Style="{StaticResource DiagramText}" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="Arrow" Grid.Column="1" Text="→" FontSize="16"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Style="{StaticResource DiagramText}" />
                <Border x:Name="AfterCard" Grid.Column="2" Style="{StaticResource DiagramAfterCard}">
                    <StackPanel>
                        <TextBlock Text="Snapwell が有効な間" Style="{StaticResource DiagramHeading}" />
                        <ContentControl x:Name="AfterDrawing" HorizontalContentAlignment="Stretch"
                                        IsTabStop="False" />
                        <TextBlock x:Name="AfterText" Style="{StaticResource DiagramText}" />
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock x:Name="Reason" Grid.Row="1" FontSize="12" Style="{StaticResource DiagramText}" />
        </Grid>
    </StackPanel>
</UserControl>
