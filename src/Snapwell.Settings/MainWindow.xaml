<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Snapwell.Settings.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Snapwell の設定">
    <Grid x:Name="Root" Loaded="Root_Loaded" Background="{ThemeResource SnapwellBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <NavigationView x:Name="Navigation" Grid.Row="0" IsSettingsVisible="False"
                        PaneDisplayMode="Left" IsPaneOpen="True" OpenPaneLength="232"
                        IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False"
                        SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.Resources>
                <Thickness x:Key="NavigationViewContentGridBorderThickness">1,0,0,0</Thickness>
                <Thickness x:Key="NavigationViewItemButtonMargin">10,2</Thickness>
                <CornerRadius x:Key="NavigationViewItemButtonCornerRadius">6</CornerRadius>
                <Thickness x:Key="NavigationViewItemBorderThickness">1</Thickness>
            </NavigationView.Resources>
            <NavigationView.PaneHeader>
                <Border Height="10" />
            </NavigationView.PaneHeader>
            <NavigationView.MenuItemContainerStyle>
                <Style TargetType="NavigationViewItem">
                    <Setter Property="FontFamily" Value="{StaticResource SnapwellUiFontFamily}" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="MinHeight" Value="36" />
                </Style>
            </NavigationView.MenuItemContainerStyle>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="全般" Tag="general" />
                <NavigationViewItem Content="分割と間隔" Tag="grid" />
                <NavigationViewItem Content="操作感" Tag="feel" />
                <NavigationViewItem Content="ホットキー" Tag="hotkeys" />
                <NavigationViewItem Content="同期とバックアップ" Tag="backup" />
            </NavigationView.MenuItems>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="8" Margin="32,12,32,0" MaxWidth="820" HorizontalAlignment="Stretch">
                    <InfoBar x:Name="LoadNotice" Severity="Warning" IsClosable="False" />
                    <InfoBar x:Name="SaveNotice" IsClosable="True" />
                </StackPanel>
                <ContentControl x:Name="PageHost" Grid.Row="1" HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" IsTabStop="True" />
            </Grid>
        </NavigationView>
        <Grid Grid.Row="1" Padding="32,14" ColumnSpacing="16"
              Background="{ThemeResource SnapwellSurface2Brush}"
              BorderBrush="{ThemeResource SnapwellBorderBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ChangeStatus" VerticalAlignment="Center" TextWrapping="Wrap"
                       Style="{StaticResource SnapwellHintTextStyle}" />
            <Button x:Name="SaveButton" Grid.Column="1" Content="保存" MinWidth="100"
                    Style="{StaticResource SnapwellPrimaryButtonStyle}" Click="Save_Click" />
        </Grid>
    </Grid>
</Window>
