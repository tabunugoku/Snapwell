<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Snapwell.Settings.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Snapwell の設定">
    <Grid x:Name="Root" Loaded="Root_Loaded" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="8" Margin="16,8,16,0">
            <InfoBar x:Name="LoadNotice" Severity="Warning" IsClosable="False" />
            <InfoBar x:Name="SaveNotice" IsClosable="True" />
        </StackPanel>
        <NavigationView x:Name="Navigation" Grid.Row="1" IsSettingsVisible="False"
                        PaneDisplayMode="Left" OpenPaneLength="220" IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="True" SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="全般" Tag="general" />
                <NavigationViewItem Content="分割と間隔" Tag="grid" />
                <NavigationViewItem Content="操作感" Tag="feel" />
                <NavigationViewItem Content="ホットキー" Tag="hotkeys" />
                <NavigationViewItem Content="同期とバックアップ" Tag="backup" />
            </NavigationView.MenuItems>
            <ContentControl x:Name="PageHost" HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" IsTabStop="True" />
        </NavigationView>
        <Grid Grid.Row="2" Padding="24,12" ColumnSpacing="16"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ChangeStatus" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button x:Name="SaveButton" Grid.Column="1" Content="保存" MinWidth="100"
                    Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
        </Grid>
    </Grid>
</Window>
